{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alliancecodex.example/schemas/source-registry.schema.json",
  "title": "Alliance Codex source registry",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "sources"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "name", "url", "sourceType", "authority", "scope", "language", "lastCheckedAt", "lastSuccessfulAt", "freshness", "notes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^source:[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "sourceType": { "type": "string", "minLength": 1 },
        "authority": { "enum": ["first_party", "official_candidate", "community", "historical", "discovery_only"] },
        "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "language": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z]{2}$" } },
        "lastCheckedAt": { "type": "string", "format": "date-time" },
        "lastSuccessfulAt": { "type": ["string", "null"], "format": "date-time" },
        "freshness": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    }
  }
}
