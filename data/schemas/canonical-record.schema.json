{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alliancecodex.example/schemas/canonical-record.schema.json",
  "title": "Alliance Codex canonical entity record",
  "description": "Build/import contract projected into entities and field-level claims.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "status", "records"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["draft", "reviewed", "published"] },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "entityType", "canonicalSlug", "canonicalName", "facts"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "entityType": {
            "enum": [
              "pokemon_species",
              "pokemon_variant",
              "move",
              "item",
              "location",
              "npc",
              "quest",
              "hunt",
              "system",
              "guide"
            ]
          },
          "canonicalSlug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "canonicalName": { "type": "string", "minLength": 1 },
          "facts": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/fact"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": ["value", "status", "evidenceIds", "normalizerVersion"],
      "additionalProperties": false,
      "properties": {
        "value": {},
        "status": {
          "enum": [
            "confirmed",
            "supported",
            "inferred",
            "unknown",
            "conflicted",
            "deprecated",
            "rejected"
          ]
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^evidence:[a-z0-9:-]+$" }
        },
        "normalizerVersion": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" },
        "effectiveFrom": { "type": "string", "format": "date-time" },
        "effectiveTo": { "type": "string", "format": "date-time" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string" }
      }
    }
  }
}
