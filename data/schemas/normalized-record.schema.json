{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alliancecodex.example/schemas/normalized-record.schema.json",
  "title": "Alliance Codex normalized research collection",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "status", "records"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "minLength": 1 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "canonicalSlug", "canonicalName", "facts"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "canonicalSlug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "canonicalName": { "type": "string", "minLength": 1 },
          "facts": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["value", "status", "evidenceIds"],
              "additionalProperties": false,
              "properties": {
                "value": {},
                "status": { "enum": ["supported", "conflicted", "unverified", "outdated"] },
                "evidenceIds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^evidence:[a-z0-9:-]+$" }
                }
              }
            }
          }
        }
      }
    }
  }
}
