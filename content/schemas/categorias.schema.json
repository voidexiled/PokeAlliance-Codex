{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alliance-codex.local/schemas/categorias.schema.json",
  "title": "Categorías del Market",
  "description": "Las 14 categorías del Market del juego, en el orden del cliente; después las categorías propias del sitio (boosters, diamond-utilities, packages, toys, mega-stones, shiny-creature-items; decisiones del propietario 2026-09-25) y «otros» al final: ítems del juego que aún no tienen categoría (el propietario los recoloca a mano). El orden y los ids son fijos: el esquema los comprueba posición por posición.",
  "type": "object",
  "required": ["categorias"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "categorias": {
      "type": "array",
      "description": "Exactamente estas 21 categorías, en este orden: todo, diamantes, pokemon, poke-balls, stones, helds, orbs, creature-items, general-items, utilities, addons, consumable, foods, furnitures, boosters, diamond-utilities, packages, toys, mega-stones, shiny-creature-items, otros. \"todo\" es virtual (reúne las demás y no tiene archivo). \"mercado\" es true en las 13 que son categorías del Market del juego (de diamantes a furnitures).",
      "minItems": 21,
      "maxItems": 21,
      "prefixItems": [
        {
          "$ref": "#/$defs/categoria",
          "properties": {
            "id": { "const": "todo" },
            "orden": { "const": 0 },
            "virtual": { "const": true },
            "mercado": { "const": false }
          },
          "required": ["virtual"]
        },
        {
          "$ref": "#/$defs/categoria",
          "properties": {
            "id": { "const": "diamantes" },
            "orden": { "const": 1 },
            "virtual": { "const": false },
            "mercado": { "const": true }
          }
        },
        {
          "$ref": "#/$defs/categoria",
          "properties": {
            "id": { "const": "pokemon" },
            "orden": { "const": 2 },
            "virtual": { "const": false },
            "mercado": { "const": true }
          }
        },
        {
          "$ref": "#/$defs/categoria",
          "properties": {
            "id": { "const": "poke-balls" },
            "orden": { "const": 3 },
            "virtual": { "const": false },
            "mercado": { "const": true }
          }
        },
        {
          "$ref": "#/$defs/categoria",
          "properties": {
            "id": { "const": "stones" },
            "orden": { "const": 4 },
            "virtual": { "const": false },
            "mercado": { "const": true }
          }
        },
        {
          "$ref": "#/$defs/categoria",
          "properties": {
            "id": { "const": "helds" },
            "orden": { "const": 5 },
            "virtual": { "const": false },
            "mercado": { "const": true }
          }
        },
        {
          "$ref": "#/$defs/categoria",
          "properties": {
            "id": { "const": "orbs" },
            "orden": { "const": 6 },
            "virtual": { "const": false },
            "mercado": { "const": true }
          }
        },
        {
          "$ref": "#/$defs/categoria",
          "properties": {
            "id": { "const": "creature-items" },
            "orden": { "const": 7 },
            "virtual": { "const": false },
            "mercado": { "const": true }
          }
        },
        {
          "$ref": "#/$defs/categoria",
          "properties": {
            "id": { "const": "general-items" },
            "orden": { "const": 8 },
            "virtual": { "const": false },
            "mercado": { "const": true }
          }
        },
        {
          "$ref": "#/$defs/categoria",
          "properties": {
            "id": { "const": "utilities" },
            "orden": { "const": 9 },
            "virtual": { "const": false },
            "mercado": { "const": true }
          }
        },
        {
          "$ref": "#/$defs/categoria",
          "properties": {
            "id": { "const": "addons" },
            "orden": { "const": 10 },
            "virtual": { "const": false },
            "mercado": { "const": true }
          }
        },
        {
          "$ref": "#/$defs/categoria",
          "properties": {
            "id": { "const": "consumable" },
            "orden": { "const": 11 },
            "virtual": { "const": false },
            "mercado": { "const": true }
          }
        },
        {
          "$ref": "#/$defs/categoria",
          "properties": {
            "id": { "const": "foods" },
            "orden": { "const": 12 },
            "virtual": { "const": false },
            "mercado": { "const": true }
          }
        },
        {
          "$ref": "#/$defs/categoria",
          "properties": {
            "id": { "const": "furnitures" },
            "orden": { "const": 13 },
            "virtual": { "const": false },
            "mercado": { "const": true }
          }
        },
        {
          "$ref": "#/$defs/categoria",
          "properties": {
            "id": { "const": "boosters" },
            "orden": { "const": 14 },
            "virtual": { "const": false },
            "mercado": { "const": false }
          }
        },
        {
          "$ref": "#/$defs/categoria",
          "properties": {
            "id": { "const": "diamond-utilities" },
            "orden": { "const": 15 },
            "virtual": { "const": false },
            "mercado": { "const": false }
          }
        },
        {
          "$ref": "#/$defs/categoria",
          "properties": {
            "id": { "const": "packages" },
            "orden": { "const": 16 },
            "virtual": { "const": false },
            "mercado": { "const": false }
          }
        },
        {
          "$ref": "#/$defs/categoria",
          "properties": {
            "id": { "const": "toys" },
            "orden": { "const": 17 },
            "virtual": { "const": false },
            "mercado": { "const": false }
          }
        },
        {
          "$ref": "#/$defs/categoria",
          "properties": {
            "id": { "const": "mega-stones" },
            "orden": { "const": 18 },
            "virtual": { "const": false },
            "mercado": { "const": false }
          }
        },
        {
          "$ref": "#/$defs/categoria",
          "properties": {
            "id": { "const": "shiny-creature-items" },
            "orden": { "const": 19 },
            "virtual": { "const": false },
            "mercado": { "const": false }
          }
        },
        {
          "$ref": "#/$defs/categoria",
          "properties": {
            "id": { "const": "otros" },
            "orden": { "const": 20 },
            "virtual": { "const": false },
            "mercado": { "const": false }
          }
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Minúsculas, números y guiones (kebab-case)."
    },
    "spriteKey": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$",
      "description": "Clave de public/sprites/sprites.json, por ejemplo \"ui/diamond\"."
    },
    "texto": { "type": "string", "minLength": 1 },
    "categoria": {
      "type": "object",
      "required": ["id", "nombre", "icono", "orden"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug",
          "description": "Identificador. Cada categoría real tiene su archivo content/items/<id>.json."
        },
        "nombre": {
          "type": "object",
          "description": "Etiqueta tal como la muestra el cliente.",
          "required": ["es", "en"],
          "additionalProperties": false,
          "properties": {
            "es": { "$ref": "#/$defs/texto" },
            "en": { "$ref": "#/$defs/texto" }
          }
        },
        "icono": { "$ref": "#/$defs/spriteKey" },
        "orden": {
          "type": "integer",
          "minimum": 0,
          "description": "Posición en el Market (0 = primera)."
        },
        "virtual": {
          "type": "boolean",
          "description": "true si la categoría no tiene archivo propio (\"Todo\" reúne las demás)."
        },
        "mercado": {
          "type": "boolean",
          "description": "true si es una categoría del Market del juego (la página de un ítem la nombra: «Se vende en el mercado, en la categoría X»). Las categorías del sitio, «todo» y «otros» no lo llevan (o lo llevan a false)."
        }
      }
    }
  }
}
