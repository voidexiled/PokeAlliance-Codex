{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alliance-codex.local/schemas/comercio.schema.json",
  "title": "Comercio de ejemplo (fase A)",
  "description": "Anuncios y vendedores de ejemplo de Comercio: content/comercio/anuncios.json lleva { \"anuncios\": [...] } y content/comercio/vendedores.json { \"vendedores\": [...] }. Solo se leen con COMERCIO_DEMO=1 (servidor de desarrollo, pruebas y build visual), nunca en el build de producción. Son datos de demostración, no ofertas: cada registro lleva \"borrador\": true, los vendedores son ficticios y ningún texto ni cifra se copia de un tablero. pnpm content:check comprueba además las referencias, las reglas de precio y la Ditto Memory.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "anuncios": {
      "type": "array",
      "description": "Anuncios de venta, en cualquier orden. El id no se repite.",
      "items": { "$ref": "#/$defs/anuncio" }
    },
    "vendedores": {
      "type": "array",
      "description": "Vendedores con sus canales de contacto y sus reseñas. El id (handle) no se repite.",
      "items": { "$ref": "#/$defs/vendedor" }
    }
  },
  "if": { "required": ["anuncios"] },
  "then": { "not": { "required": ["vendedores"] } },
  "else": { "required": ["vendedores"] },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Minúsculas, números y guiones (kebab-case)."
    },
    "handle": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,24}$",
      "description": "Handle de una cuenta de Comercio: de 3 a 24 minúsculas, números, guiones o guiones bajos."
    },
    "instante": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9](?:\\.[0-9]{1,3})?)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "description": "Instante ISO 8601 con zona: \"2026-09-18T17:20:00Z\"."
    },
    "cantidad": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999999999999,
      "description": "Entero de 1 a 15 cifras, en unidades base: 50kk de Pokédólares es 50000000."
    },
    "importe": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,9}(?:\\.[0-9]{1,2})?|0\\.(?:[1-9][0-9]?|0[1-9]))$",
      "description": "Importe en dinero real, mayor que cero: hasta 10 cifras enteras y 2 decimales con punto: \"90\", \"35.50\"."
    },
    "porcentaje": {
      "type": "string",
      "pattern": "^(?:100(?:\\.00?)?|[1-9]?[0-9](?:\\.[0-9]{1,2})?)$",
      "description": "De \"0\" a \"100\", con hasta 2 decimales y punto: \"53\", \"12.5\"."
    },
    "nombreDeclarado": {
      "type": "string",
      "pattern": "^(?=.{1,40}$)\\S(?:.*\\S)?$",
      "description": "Texto de 1 a 40 caracteres, sin espacios al principio ni al final. Los espacios de dentro se conservan."
    },
    "nombreItem": {
      "type": "string",
      "pattern": "^(?=.{1,80}$)\\S(?:.*\\S)?$",
      "description": "Nombre de 1 a 80 caracteres, sin espacios al principio ni al final."
    },
    "nombreVendedor": {
      "type": "string",
      "pattern": "^(?=.{1,32}$)\\S(?:.*\\S)?$",
      "description": "Nombre visible de 1 a 32 caracteres, sin espacios al principio ni al final."
    },
    "codigoPais": {
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{0,2}$",
      "description": "Código telefónico del país con su «+»: \"+55\", \"+52\", \"+1\"."
    },
    "plataforma": {
      "type": "string",
      "pattern": "^(?=.{1,32}$)\\S(?:.*\\S)?$",
      "description": "Nombre de la plataforma, de 1 a 32 caracteres."
    },
    "comentario": {
      "type": "string",
      "pattern": "^(?=[\\s\\S]*\\S)[\\s\\S]{1,1000}$",
      "description": "Comentario de hasta 1000 caracteres. Sin importes del juego en texto libre."
    },
    "opcionJuego": {
      "type": "object",
      "description": "Una opción de precio en el juego: Pokédólares o Diamonds, en unidades base.",
      "required": ["tipo", "cantidad"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "enum": ["pokedolares", "diamonds"] },
        "cantidad": { "$ref": "#/$defs/cantidad" }
      }
    },
    "precioReal": {
      "type": "object",
      "required": ["moneda", "importe"],
      "additionalProperties": false,
      "properties": {
        "moneda": {
          "description": "BRL se muestra «R$», USD «US$» y MXN «MX$». La lista es la constante MONEDAS_REALES de src/lib/trade/types.ts.",
          "enum": ["BRL", "USD", "MXN"]
        },
        "importe": { "$ref": "#/$defs/importe" }
      }
    },
    "precio": {
      "type": "object",
      "description": "Dinero real, de 0 a 2 opciones en el juego, o «A convenir». Con aConvenir, real es null y juego está vacío; sin él, hay dinero real o al menos una opción. pnpm content:check exige además que las dos opciones sean de monedas distintas y que un anuncio de Diamonds o de Pokédólares no se pague con su propia moneda.",
      "required": ["real", "juego", "aConvenir"],
      "additionalProperties": false,
      "properties": {
        "real": {
          "type": ["object", "null"],
          "if": { "type": "object" },
          "then": { "$ref": "#/$defs/precioReal" }
        },
        "juego": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/opcionJuego" }
        },
        "aConvenir": { "type": "boolean" }
      },
      "if": {
        "properties": { "aConvenir": { "const": true } },
        "required": ["aConvenir"]
      },
      "then": {
        "properties": {
          "real": { "type": "null" },
          "juego": { "maxItems": 0 }
        }
      },
      "else": {
        "if": {
          "properties": { "real": { "type": "null" } },
          "required": ["real"]
        },
        "then": { "properties": { "juego": { "minItems": 1 } } }
      }
    },
    "ballDeclarada": {
      "type": "object",
      "description": "Ball declarada. item es el id de content/items/poke-balls.json si el nombre coincide con él sin mayúsculas ni acentos; si no, null.",
      "required": ["item", "nombre"],
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": ["string", "null"],
          "if": { "type": "string" },
          "then": { "$ref": "#/$defs/slug" }
        },
        "nombre": { "$ref": "#/$defs/nombreDeclarado" }
      }
    },
    "heldDeclarado": {
      "type": "object",
      "description": "Held item declarado. item es el id de content/items/helds.json si el nombre coincide con él; si no, null.",
      "required": ["item", "nombre", "tier"],
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": ["string", "null"],
          "if": { "type": "string" },
          "then": { "$ref": "#/$defs/slug" }
        },
        "nombre": { "$ref": "#/$defs/nombreDeclarado" },
        "tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99,
          "description": "De 1 a 99: es un límite del campo, no un dato del juego."
        }
      }
    },
    "addonDeclarado": {
      "type": "object",
      "description": "Addon del Pokémon: id es un addon de ese Pokémon en content/outfits.json.",
      "required": ["id", "nombre"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": ["string", "null"],
          "if": { "type": "string" },
          "then": { "$ref": "#/$defs/slug" }
        },
        "nombre": { "$ref": "#/$defs/nombreItem" }
      }
    },
    "entrenamiento": {
      "type": "object",
      "description": "Una habilidad de entrenamiento declarada, como mucho una vez por habilidad, con su nivel, su progreso al siguiente o los dos.",
      "required": ["habilidad", "nivel", "progreso"],
      "additionalProperties": false,
      "properties": {
        "habilidad": {
          "description": "Las ocho habilidades, en inglés en los dos idiomas.",
          "enum": [
            "Attack",
            "Critical Damage",
            "Critical Chance",
            "Critical Resistance",
            "Defense",
            "HP",
            "Precision",
            "Evasion"
          ]
        },
        "nivel": { "type": ["integer", "null"], "minimum": 0, "maximum": 999999 },
        "progreso": {
          "type": ["string", "null"],
          "if": { "type": "string" },
          "then": { "$ref": "#/$defs/porcentaje" }
        }
      }
    },
    "precioNpc": {
      "type": "object",
      "description": "NPC Price declarado: { \"tipo\": \"unsellable\" } o { \"tipo\": \"pokedolares\", \"cantidad\": entero }.",
      "required": ["tipo"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "enum": ["unsellable", "pokedolares"] },
        "cantidad": { "$ref": "#/$defs/cantidad" }
      },
      "if": {
        "properties": { "tipo": { "const": "pokedolares" } },
        "required": ["tipo"]
      },
      "then": { "required": ["cantidad"] },
      "else": { "properties": { "cantidad": false } }
    },
    "unidadPokemon": {
      "type": "object",
      "description": "El Pokémon que se vende, con lo que declara el vendedor. Requisito, Tier y Elementos no se guardan: salen de content/pokemon.json. null es «no declarado».",
      "required": [
        "pokemon",
        "ball",
        "aura",
        "boost",
        "starLevel",
        "nickname",
        "memorySlots",
        "memorias",
        "helds",
        "addon",
        "nextBoostChance",
        "entrenamiento",
        "precioNpc"
      ],
      "additionalProperties": false,
      "properties": {
        "pokemon": {
          "$ref": "#/$defs/slug",
          "description": "id de content/pokemon.json."
        },
        "ball": {
          "type": ["object", "null"],
          "if": { "type": "object" },
          "then": { "$ref": "#/$defs/ballDeclarada" }
        },
        "aura": {
          "type": ["string", "null"],
          "description": "id de content/auras.json.",
          "if": { "type": "string" },
          "then": { "$ref": "#/$defs/slug" }
        },
        "boost": { "type": ["integer", "null"], "minimum": 0, "maximum": 50 },
        "starLevel": { "type": ["integer", "null"], "minimum": 0, "maximum": 5 },
        "nickname": {
          "type": ["string", "null"],
          "if": { "type": "string" },
          "then": { "$ref": "#/$defs/nombreDeclarado" }
        },
        "memorySlots": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 6,
          "description": "Solo Ditto y Shiny Ditto."
        },
        "memorias": {
          "type": "array",
          "maxItems": 6,
          "description": "Una entrada por Memory Slot: id de content/pokemon.json o null si el slot está vacío. Sin Memory Slots, vacía.",
          "items": {
            "type": ["string", "null"],
            "if": { "type": "string" },
            "then": { "$ref": "#/$defs/slug" }
          }
        },
        "helds": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/heldDeclarado" }
        },
        "addon": {
          "type": ["object", "null"],
          "if": { "type": "object" },
          "then": { "$ref": "#/$defs/addonDeclarado" }
        },
        "nextBoostChance": {
          "type": ["string", "null"],
          "if": { "type": "string" },
          "then": { "$ref": "#/$defs/porcentaje" }
        },
        "entrenamiento": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/entrenamiento" }
        },
        "precioNpc": {
          "type": ["object", "null"],
          "if": { "type": "object" },
          "then": { "$ref": "#/$defs/precioNpc" }
        }
      }
    },
    "itemDeclarado": {
      "type": "object",
      "description": "El item que se vende. item es el id de content/items/ si el nombre coincide con él sin mayúsculas ni acentos; si no, null y el sitio lo muestra como texto.",
      "required": ["item", "nombre", "cantidad"],
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": ["string", "null"],
          "if": { "type": "string" },
          "then": { "$ref": "#/$defs/slug" }
        },
        "nombre": { "$ref": "#/$defs/nombreItem" },
        "cantidad": { "$ref": "#/$defs/cantidad" }
      }
    },
    "anuncio": {
      "type": "object",
      "description": "Un anuncio de venta. pokemon va solo con el tipo pokemon, item solo con items y cantidad solo con diamonds y pokedolares.",
      "required": ["id", "tipo", "vendedor", "mundo", "publicado", "expira", "estado", "precio"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug",
          "description": "Identificador único del anuncio y ruta de su detalle."
        },
        "tipo": {
          "description": "Tipo de activo, en el orden de las pestañas.",
          "enum": ["pokemon", "items", "diamonds", "pokedolares"]
        },
        "vendedor": {
          "$ref": "#/$defs/handle",
          "description": "id de un vendedor de content/comercio/vendedores.json."
        },
        "mundo": {
          "$ref": "#/$defs/slug",
          "description": "id de content/mundos.json."
        },
        "publicado": { "$ref": "#/$defs/instante" },
        "expira": {
          "$ref": "#/$defs/instante",
          "description": "Posterior a publicado. Un anuncio publicado o reservado cuyo expira ya pasó se ve como expirado."
        },
        "estado": {
          "enum": ["publicado", "reservado", "completado", "expirado", "retirado"]
        },
        "precio": { "$ref": "#/$defs/precio" },
        "pokemon": { "$ref": "#/$defs/unidadPokemon" },
        "item": { "$ref": "#/$defs/itemDeclarado" },
        "cantidad": {
          "$ref": "#/$defs/cantidad",
          "description": "Diamonds o Pokédólares que se venden, en unidades base."
        },
        "borrador": {
          "const": true,
          "description": "Todo registro de Comercio de la fase A lleva \"borrador\": true."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "tipo": { "const": "pokemon" } },
            "required": ["tipo"]
          },
          "then": {
            "required": ["pokemon"],
            "properties": { "item": false, "cantidad": false }
          }
        },
        {
          "if": {
            "properties": { "tipo": { "const": "items" } },
            "required": ["tipo"]
          },
          "then": {
            "required": ["item"],
            "properties": { "pokemon": false, "cantidad": false }
          }
        },
        {
          "if": {
            "properties": { "tipo": { "enum": ["diamonds", "pokedolares"] } },
            "required": ["tipo"]
          },
          "then": {
            "required": ["cantidad"],
            "properties": { "pokemon": false, "item": false }
          }
        }
      ]
    },
    "canal": {
      "type": "object",
      "description": "Canal de contacto verificado. En público solo se ve su etiqueta: «Correo», «Teléfono +55», «Discord», «Twitch» o el nombre de otra plataforma; nunca el correo, el número ni el usuario. etiqueta lleva el código del país de un teléfono y el nombre de otra plataforma; en los demás canales es null.",
      "required": ["tipo", "etiqueta"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "enum": ["correo", "telefono", "discord", "twitch", "otra"] },
        "etiqueta": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "tipo": { "const": "telefono" } },
            "required": ["tipo"]
          },
          "then": { "properties": { "etiqueta": { "$ref": "#/$defs/codigoPais" } } }
        },
        {
          "if": {
            "properties": { "tipo": { "const": "otra" } },
            "required": ["tipo"]
          },
          "then": { "properties": { "etiqueta": { "$ref": "#/$defs/plataforma" } } }
        },
        {
          "if": {
            "properties": { "tipo": { "enum": ["correo", "discord", "twitch"] } },
            "required": ["tipo"]
          },
          "then": { "properties": { "etiqueta": { "type": "null" } } }
        }
      ]
    },
    "resena": {
      "type": "object",
      "description": "Reseña de una operación confirmada: de 0 a 5, sobre un anuncio del mismo vendedor.",
      "required": ["puntuacion", "comentario", "fecha", "anuncio", "comprador"],
      "additionalProperties": false,
      "properties": {
        "puntuacion": { "type": "integer", "minimum": 0, "maximum": 5 },
        "comentario": {
          "type": ["string", "null"],
          "if": { "type": "string" },
          "then": { "$ref": "#/$defs/comentario" }
        },
        "fecha": { "$ref": "#/$defs/instante" },
        "anuncio": {
          "$ref": "#/$defs/slug",
          "description": "id del anuncio de la operación, en content/comercio/anuncios.json."
        },
        "comprador": {
          "$ref": "#/$defs/handle",
          "description": "Handle del comprador, distinto del vendedor."
        }
      }
    },
    "vendedor": {
      "type": "object",
      "description": "Un vendedor ficticio: nunca el nombre de una persona o de un jugador real. La valoración no se guarda: se calcula de sus reseñas.",
      "required": ["id", "nombre", "desde", "canales", "resenas"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/handle",
          "description": "Handle del vendedor y ruta de su perfil."
        },
        "nombre": { "$ref": "#/$defs/nombreVendedor" },
        "desde": {
          "type": ["string", "null"],
          "description": "Desde cuándo tiene cuenta. null si no se conoce.",
          "if": { "type": "string" },
          "then": { "$ref": "#/$defs/instante" }
        },
        "canales": {
          "type": "array",
          "description": "Un canal por tipo; otra plataforma, una vez por nombre.",
          "items": { "$ref": "#/$defs/canal" }
        },
        "resenas": {
          "type": "array",
          "items": { "$ref": "#/$defs/resena" }
        },
        "borrador": {
          "const": true,
          "description": "Todo registro de Comercio de la fase A lleva \"borrador\": true."
        }
      }
    }
  }
}
