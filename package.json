{
  "name": "alliance-codex",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "node scripts/test/serve-vercel-output.mjs --port 4322",
    "check": "astro check",
    "lint": "eslint src tests scripts/build scripts/lib scripts/test scripts/perf scripts/seo scripts/visual astro.config.mjs vitest.config.ts eslint.config.js",
    "format": "prettier --write \"src/**/*.{astro,tsx,ts,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/{build,lib,test,perf,seo,visual}/**/*.mjs\" \"*.{mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{astro,tsx,ts,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/{build,lib,test,perf,seo,visual}/**/*.mjs\" \"*.{mjs,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=desktop --project=mobile --project=webkit-mobile --project=reduced-motion --project=prod",
    "test:visual": "node scripts/visual/run.mjs",
    "visual:goldens": "node scripts/visual/goldens.mjs",
    "assets:outfits": "node scripts/assets/dump-outfits.mjs",
    "content:roster": "node scripts/content/import-roster.mjs",
    "content:check": "node scripts/content/check.mjs",
    "design:tokens": "node scripts/design/tokens.mjs",
    "design:check": "node scripts/design/check.mjs",
    "i18n:check": "node scripts/i18n/check.mjs",
    "perf:budget": "node scripts/perf/check-budgets.mjs",
    "seo:check": "node scripts/seo/check-dist.mjs",
    "ci": "pnpm content:check && pnpm design:check && pnpm format:check && pnpm lint && pnpm check && pnpm i18n:check && pnpm test && pnpm build && node scripts/build/check-toc.mjs && node scripts/design/check-dist.mjs && pnpm perf:budget && pnpm seo:check",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "@floating-ui/dom": "1.8.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.2",
    "lucide-react": "^1.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/vercel": "^11.0.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
