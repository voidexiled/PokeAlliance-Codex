{
  "name": "alliance-codex",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint src tests astro.config.mjs vitest.config.ts eslint.config.js",
    "format": "prettier --write \"src/**/*.{astro,tsx,ts,css}\" \"tests/**/*.{ts,tsx}\" \"*.{mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{astro,tsx,ts,css}\" \"tests/**/*.{ts,tsx}\" \"*.{mjs,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:data": "pwsh -NoProfile -File scripts/research/validate-research.ps1 -RepositoryRoot .",
    "validate:phase2": "pwsh -NoProfile -File scripts/research/validate-phase2-model.ps1 -RepositoryRoot .",
    "ci": "pnpm format:check && pnpm lint && pnpm check && pnpm validate:data && pnpm validate:phase2 && pnpm test && pnpm build",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/vercel": "^11.0.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
