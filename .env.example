# Public values. Safe to expose in the browser.
PUBLIC_SITE_URL=http://127.0.0.1:4321

# Supabase. Leave both empty for the static site: /{locale}/cuenta/ is not generated and Guild
# stays in local mode (spec 9.3, 10.4). Account mode is developed against the LOCAL stack only
# (`supabase start`); `supabase status -o env` prints its public development values:
#   PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY printed by supabase status -o env>
# Local mail (the sign-up code, password resets) lands in Mailpit: http://127.0.0.1:54324
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose it to client-side code and never commit a value.
SUPABASE_SERVICE_ROLE_KEY=

# Build flag: "1" or "true" leaves out every record marked "borrador": true (spec R7).
OCULTAR_BORRADORES=

# Comercio (spec 9.2), "1" or "true" each. Neither is set in production until launch (docs/LANZAMIENTO.md).
# Sample listings and sellers of content/comercio/ (phase A); never in production.
COMERCIO_DEMO=
# Phase B: accounts in Comercio, deals, reviews, reports, moderation and online status (spec 9.9-9.15).
COMERCIO_PUBLICO=
# Makes a verified phone step 2b of registration (spec 9.15.1); needs Twilio Verify on in Supabase Auth.
TELEFONO_OBLIGATORIO=

# Cloudflare Turnstile site key (public); blank renders no CAPTCHA. Local test key, invisible, always passes: 1x00000000000000000000BB
PUBLIC_TURNSTILE_SITE_KEY=
# "1" or "true" shows «Vincular Discord»; set it only once Discord is on in Supabase Auth.
PUBLIC_AUTH_DISCORD=
# "1" or "true" shows «Vincular Google»; set it only once Google is on in Supabase Auth.
PUBLIC_AUTH_GOOGLE=
# "1" or "true" shows «Vincular Twitch»; set it only once Twitch is on in Supabase Auth.
PUBLIC_AUTH_TWITCH=

# LOCAL Supabase stack only: supabase/config.toml reads these when `supabase start` runs. Keep them
# in supabase/.env, which Git ignores (the CLI also reads this folder's .env, which points at the
# remote project). Each provider stays off while its _ENABLED is blank; restart the stack after a
# change. The remote project takes the same values in its dashboard, never from here (docs/LANZAMIENTO.md).
# "true" turns the Turnstile check on in Supabase Auth; the site then needs PUBLIC_TURNSTILE_SITE_KEY.
SUPABASE_AUTH_CAPTCHA_ENABLED=
# Turnstile secret key. Local test secret, always passes: 1x0000000000000000000000000000000AA
SUPABASE_AUTH_CAPTCHA_SECRET=
# "true" sends Auth mail through Resend (smtp.resend.com:465) instead of Mailpit.
SUPABASE_AUTH_EMAIL_SMTP_ENABLED=
# Resend API key, used as the SMTP password.
SUPABASE_AUTH_EMAIL_SMTP_PASS=
# Sender address on the domain verified in Resend, such as no-reply@<domain>.
SUPABASE_AUTH_EMAIL_SMTP_ADMIN_EMAIL=
# "true" turns Discord on; its app lists http://127.0.0.1:54321/auth/v1/callback as a redirect.
SUPABASE_AUTH_EXTERNAL_DISCORD_ENABLED=
# Discord application Client ID (Developer Portal, OAuth2).
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
# Discord application Client Secret.
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=
# "true" turns Google on; its OAuth client lists http://127.0.0.1:54321/auth/v1/callback as a redirect URI.
SUPABASE_AUTH_EXTERNAL_GOOGLE_ENABLED=
# Google OAuth client ID (Google Cloud Console, web application).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# Google OAuth client secret.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# "true" turns Twitch on (optional badge); its app lists http://127.0.0.1:54321/auth/v1/callback.
SUPABASE_AUTH_EXTERNAL_TWITCH_ENABLED=
# Twitch application Client ID (Twitch Developer Console).
SUPABASE_AUTH_EXTERNAL_TWITCH_CLIENT_ID=
# Twitch application Client Secret.
SUPABASE_AUTH_EXTERNAL_TWITCH_SECRET=
# Only to try Twitch locally: Twitch accepts http://localhost, not 127.0.0.1. Then http://localhost:54321/auth/v1/callback.
SUPABASE_AUTH_EXTERNAL_TWITCH_REDIRECT_URI=
# "true" turns Twilio Verify on (paid; off while TELEFONO_OBLIGATORIO is blank). Local test number without SMS: +1 202 555 0123, code 123456.
SUPABASE_AUTH_SMS_TWILIO_VERIFY_ENABLED=
# Twilio Account SID.
SUPABASE_AUTH_SMS_TWILIO_VERIFY_ACCOUNT_SID=
# Twilio Verify Service SID.
SUPABASE_AUTH_SMS_TWILIO_VERIFY_MESSAGE_SERVICE_SID=
# Twilio Auth Token.
SUPABASE_AUTH_SMS_TWILIO_VERIFY_AUTH_TOKEN=
