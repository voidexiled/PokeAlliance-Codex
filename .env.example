# Public values. Safe to expose in the browser.
PUBLIC_SITE_URL=http://127.0.0.1:4321

# Supabase. Leave both empty for the static site: /{locale}/cuenta/ is not generated and Guild
# stays in local mode (spec 9.3, 10.4). Account mode is developed against the LOCAL stack only
# (`supabase start`); `supabase status -o env` prints its public development values:
#   PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY printed by supabase status -o env>
# Local mail (sign-up confirmations, when enabled) lands in Mailpit: http://127.0.0.1:54324
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose it to client-side code and never commit a value.
SUPABASE_SERVICE_ROLE_KEY=

# Build flag: "1" or "true" leaves out every record marked "borrador": true (spec R7).
OCULTAR_BORRADORES=
