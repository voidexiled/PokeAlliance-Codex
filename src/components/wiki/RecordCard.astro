---
import DataStatus from './DataStatus.astro';
import type { ContentRecord } from '../../lib/content/types';
import { getFact } from '../../lib/content/repository';

type Props = {
  record: ContentRecord;
  href: string;
  locale: 'es' | 'en';
  collectionLabel: string;
};

const { record, href, locale, collectionLabel } = Astro.props;
const evidenceIds = new Set(Object.values(record.facts).flatMap((fact) => fact.evidenceIds ?? []));
const firstStatus = Object.values(record.facts)[0]?.status ?? 'unknown';
const summary =
  getFact<string>(record, 'summary')?.value ?? getFact<string>(record, 'description')?.value;
const meta = [
  record.pokedexNumber ? `#${record.pokedexNumber}` : null,
  record.variant,
  record.kind,
  record.itemKind,
].filter(Boolean);
---

<article
  class="group flex h-full flex-col rounded-xl border border-border/80 bg-card/70 p-5 transition-colors hover:border-accent/60 hover:bg-card"
>
  <div class="flex items-start justify-between gap-3">
    <p class="eyebrow">{collectionLabel}</p>
    <DataStatus status={firstStatus} locale={locale} />
  </div>
  <h2 class="mt-4 text-xl font-semibold tracking-tight text-foreground">
    <a
      class="outline-none after:absolute after:inset-0 focus-visible:ring-2 focus-visible:ring-ring"
      href={href}
    >
      {record.canonicalName}
    </a>
  </h2>
  {
    meta.length > 0 && (
      <p class="mt-2 font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground">
        {meta.join(' · ')}
      </p>
    )
  }
  {summary && <p class="muted-copy mt-4 line-clamp-3">{summary}</p>}
  <div
    class="relative mt-auto flex items-center justify-between gap-3 pt-6 text-xs text-muted-foreground"
  >
    <span>{evidenceIds.size} {locale === 'es' ? 'evidencias' : 'evidence items'}</span>
    <span class="text-accent transition-transform group-hover:translate-x-1">→</span>
  </div>
</article>
