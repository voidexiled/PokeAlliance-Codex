---
type Props = {
  status: string;
  locale: 'es' | 'en';
};

const { status, locale } = Astro.props;
const labels = {
  supported: { es: 'Respaldado', en: 'Supported' },
  inferred: { es: 'Inferido', en: 'Inferred' },
  unknown: { es: 'Desconocido', en: 'Unknown' },
};
const label = labels[status as keyof typeof labels]?.[locale] ?? status.replaceAll('_', ' ');
---

<span class="status-label" data-status={status}>{label}</span>
