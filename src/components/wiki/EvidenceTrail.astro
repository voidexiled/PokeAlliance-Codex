---
import type { EvidenceRecord } from '../../lib/content/types';
import { getSource } from '../../lib/content/repository';

type Props = {
  records: EvidenceRecord[];
  locale: 'es' | 'en';
};

const { records, locale } = Astro.props;
const copy =
  locale === 'es'
    ? {
        eyebrow: 'Provenance',
        title: 'De dónde sale este dato',
        retrieved: 'Consultado',
        open: 'Abrir fuente',
        none: 'Este registro todavía no tiene evidencia enlazada.',
      }
    : {
        eyebrow: 'Provenance',
        title: 'Where this data comes from',
        retrieved: 'Retrieved',
        open: 'Open source',
        none: 'This record does not have linked evidence yet.',
      };
---

<section class="wiki-evidence" aria-labelledby="evidence-title">
  <p class="eyebrow">{copy.eyebrow}</p>
  <h2 id="evidence-title" class="section-title mt-2">{copy.title}</h2>
  {
    records.length > 0 ? (
      <div class="wiki-evidence-list">
        {records.map((item) => {
          const source = getSource(item.sourceId);
          return (
            <article class="wiki-evidence-item">
              <div>
                <div>
                  <h3>{source?.name ?? item.sourceId}</h3>
                  <p class="mt-1">{item.locator}</p>
                </div>
                <p class="mt-2">
                  {copy.retrieved}:{' '}
                  <time datetime={item.retrievedAt}>{item.retrievedAt.slice(0, 10)}</time>
                </p>
                <ul>
                  {item.claims.slice(0, 3).map((claim) => (
                    <li>{claim}</li>
                  ))}
                </ul>
              </div>
              <a href={item.url} target="_blank" rel="noreferrer">
                {copy.open} ↗
              </a>
            </article>
          );
        })}
      </div>
    ) : (
      <p class="muted-copy mt-3">{copy.none}</p>
    )
  }
</section>
