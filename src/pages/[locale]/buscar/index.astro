---
// Buscar (spec 8.6): the results page of the search, in template B (8.0.2) with no crumbs (E4,
// 8.0.4): the h1 «Buscar» / «Search» and the `buscar` list island — the search region, and
// either Destacados (no query) or the results bar, the grouped results and the pagination — and
// the footer that PageLayout adds. Prerendered with the island of 7.7, which loads on
// `client:load` (7.3). A prerendered page never reads its query (PR2, B-05): `q` lives in the
// URL and the island applies it (v1 point 1).
//
// The h1 (8.6 step 1) carries `id="buscar-t"`, the name of the search field
// (`aria-labelledby`). `PageTitle` has no prop for the id of its h1, so the page writes the
// component's own markup — the same classes and the same three elements — with the id on it.
//
// Data (8.0.5, R7, X4). The results are the entries of the search index of 7.9.1, which the
// island asks for (`/{l}/buscar/indice.json`, BU5); the page only gives it the length of that
// index. What the index does not carry and the views of 8.6 draw is the registries', read here:
// each system page with its sprite and its panel (`systemTip`, 8.4.1), and each item of a
// system whose page exists with its sprite, its «Uso» and its panel (`systemItemTip`, E16).
// The cards of a Pokémon and of a Market item read the data of their own lists (PR5), which the
// island asks for when it needs them. Destacados are the entries of the Inicio and of the pinned
// group of the menu (`buildFeatured`, 8.1 step 3), rendered here as the island's children: the
// same HTML in every state, and no JavaScript for it.
//
// Text (DP1, 13.2): the h1, the description of 13.5, the count and the empty and error lines are
// `messages.search`; the placeholder of the field is `shell.searchHome` (B-06); the h2 of
// Destacados is `home.featured`. The island receives `ui`, `search`, `pokedex` (the Lista of the
// Pokédex reads its headers from it, as the Tier list does, D-021) and three labels of `items`
// (D-022).
import { getAlternatePath, getLocale, locales, type Locale } from '@/i18n/config';
import type { Messages } from '@/i18n/messages/en';
import { en } from '@/i18n/messages/en';
import { es } from '@/i18n/messages/es';
import { getSistema, getSistemas, getSpriteRegistry } from '@/lib/content/registry';
import { getSystemItemHref, getSystemItems } from '@/lib/content/repository';
import { systemItemTip, systemTip, type TipData } from '@/lib/game/tips';
import { buildFeatured } from '@/lib/nav/groups';
import { spriteOrNull } from '@/lib/sprites/resolve';

import { FeaturedSection } from '@/components/home/FeaturedSection';
import {
  SEARCH_TITLE_ID,
  searchIndexUrl,
  type SearchSystem,
  type SearchSystemItem,
} from '@/components/search/config';
import { SearchResultsRoot } from '@/components/search/SearchResultsRoot';
import { panelsUrl } from '@/lib/game/panels';
import PageLayout from '@/layouts/PageLayout.astro';

import { buildSearchIndex } from './indice.json.ts';

export const prerender = true;

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const dictionaries: Record<Locale, Messages> = { es, en };

const locale = getLocale(Astro.params.locale);
const path = Astro.url.pathname;
const alternates = Object.fromEntries(
  locales.map((option) => [option, getAlternatePath(path, option)]),
) as Record<Locale, string>;

const messages = dictionaries[locale];
const { search, ui } = messages;
const title = search.title;
const registry = getSpriteRegistry();

/** The one language the `descripcion` of a system item is written in (L-04). */
const DESCRIPTION_LANG: Locale = 'en';
/** The `lang` that text takes on this page: none on its own language, `en` on the other (T22). */
const descriptionLang = locale === DESCRIPTION_LANG ? undefined : DESCRIPTION_LANG;

// «Sistemas» (8.4.1): the sprite of each system page and its panel when it has rows (R2).
const systems: Record<string, SearchSystem> = Object.fromEntries(
  getSistemas().map((system) => {
    const sprite = spriteOrNull(registry, system.sprite);
    const tip = systemTip(
      { id: system.id, titulo: system.titulo, sprite, tooltip: system.tooltip },
      locale,
    );
    const entry: SearchSystem = tip.rows.length > 0 ? { sprite, rows: tip.rows } : { sprite };
    return [system.id, entry];
  }),
);

// «Ítems», the items of a system (E16): only those whose system page exists in this build, the
// ones the index carries. «Uso» is `descripcion`, marked in the language it is written in on
// the card, the row and the panel (T22, WA4).
const systemItems: Record<string, SearchSystemItem> = Object.fromEntries(
  getSystemItems().flatMap((item) => {
    const sistema = item.sistema === null ? undefined : getSistema(item.sistema);
    if (sistema === undefined || getSystemItemHref(item, locale) === null) return [];
    const sprite = spriteOrNull(registry, item.sprite ?? null);
    const tip: TipData = systemItemTip(
      {
        id: item.id,
        nombre: item.nombre,
        descripcion: item.descripcion,
        sistema: sistema.id,
        sprite,
        tituloSistema: sistema.titulo,
      },
      locale,
      ui.tooltip,
    );
    const rows =
      descriptionLang === undefined
        ? tip.rows
        : tip.rows.map((row) =>
            row.label === ui.tooltip.use ? { ...row, lang: descriptionLang } : row,
          );
    const entry: SearchSystemItem = {
      sprite,
      use: item.descripcion,
      ...(descriptionLang === undefined ? {} : { useLang: descriptionLang }),
      tip: { ...tip, rows },
    };
    return [[item.id, entry]];
  }),
);

// Destacados (8.6 steps 3 and 6): the entries of the Inicio and of the menu, in their order.
const featured = buildFeatured(locale);

const island = {
  locale,
  path,
  indexUrl: searchIndexUrl(locale),
  total: buildSearchIndex(locale).length,
  pokedexUrl: `/${locale}/pokedex/datos.json`,
  itemsUrl: `/${locale}/items/datos.json`,
  panelsUrl: panelsUrl(locale),
  systems,
  systemItems,
  placeholder: messages.shell.searchHome,
  ui,
  search,
  pokedex: messages.pokedex,
  items: {
    sprite: messages.items.columnSprite,
    item: messages.items.columnItem,
    droppedByCount: messages.items.droppedByCount,
  },
};
---

<PageLayout locale={locale} title={title} description={search.description} alternates={alternates}>
  <div class="ac-page-title">
    <div class="ac-page-title__row">
      <h1 id={SEARCH_TITLE_ID} class="ac-page-title__h1">{title}</h1>
    </div>
    <div role="none" class="ac-page-title__rule"></div>
  </div>
  {
    featured.length > 0 ? (
      <SearchResultsRoot client:load {...island}>
        <FeaturedSection id="buscar-destacados" title={messages.home.featured} items={featured} />
      </SearchResultsRoot>
    ) : (
      <SearchResultsRoot client:load {...island} />
    )
  }
</PageLayout>
