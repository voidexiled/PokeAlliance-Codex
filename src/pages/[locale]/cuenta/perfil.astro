---
// «Mi perfil» (spec 9.16.3, 9.15.4; Cuenta-panel.dc.html): `/{l}/cuenta/perfil/`, the account's
// reputation as a seller and as a buyer and the reviews it received and gave, in the frame of
// `/{l}/cuenta/` — the header card and the section nav, where it is «Reputación» (AccountPage.tsx,
// pages/ProfilePage.tsx). The header menu's «Mi perfil» opens it. `noindex` (9.3, 13.5); the
// crumbs are «Inicio › Cuenta › Mi perfil» and the h1 is for assistive tech only, as on
// `/{l}/cuenta/`.
//
// Render (9.3): the prerendered frame and the island, which reads the session once hydrated. The
// page exists only with the public Supabase settings and COMERCIO_PUBLICO (page-props.ts):
// without them `getStaticPaths` gives no path and the header menu's «Mi perfil» goes to the
// «Perfil» section of `/{l}/cuenta/`. An old `?pestana=` link goes on to the page that has that
// tab now (AccountPage.tsx).
//
// Data (13.2, 13.6): the texts of the frame and of the two sections, gathered here into the
// island's shape, and the worlds of content/mundos.json. JS budget: the Comercio row of 13.6.
import { getLocale } from '@/i18n/config';

import { AccountPage } from '@/components/account/AccountPage';
import {
  accountCrumbs,
  accountDictionary,
  accountPageBase,
  accountPagePaths,
  alternatesOf,
} from '@/components/account/pages/page-props';
import type { ProfilePageTexts } from '@/components/account/pages/types';
import PageLayout from '@/layouts/PageLayout.astro';

import '@/styles/components/account.css';
import '@/styles/components/account-panel.css';
import '@/styles/components/account-pages.css';

export const prerender = true;

export function getStaticPaths() {
  return accountPagePaths();
}

const locale = getLocale(Astro.params.locale);
const alternates = alternatesOf(Astro.url.pathname);
const { profile, trade, ui } = accountDictionary(locale);

const texts: ProfilePageTexts = {
  reputation: {
    asSeller: trade.reputation.asSeller,
    asBuyer: trade.reputation.asBuyer,
    outOf: ui.money.outOf,
    deals: trade.reputation.deals,
    buyers: trade.reputation.buyers,
    sellers: trade.reputation.sellers,
    none: profile.noReviews,
    distribution: profile.distribution,
    stars: trade.review.star,
  },
  reviews: {
    title: profile.reviews.title,
    filterLabel: profile.reviews.filterLabel,
    received: profile.reviews.received,
    given: profile.reviews.given,
    score: trade.seller.reviewScore,
    role: { seller: profile.reviews.asSeller, buyer: profile.reviews.asBuyer },
    deal: profile.reviews.deal,
    edit: profile.reviews.edit,
    hidden: trade.review.hidden,
    deletedAccount: trade.review.deletedAuthor,
    noneReceived: profile.reviews.emptyReceived,
    noneGiven: profile.reviews.emptyGiven,
  },
  pages: { prev: ui.prev, next: ui.next, page: ui.page },
  pagination: ui.pagination,
};
---

<PageLayout
  locale={locale}
  title={profile.title}
  description={profile.description}
  alternates={alternates}
  breadcrumb={accountCrumbs(locale, profile.title)}
  noindex
>
  <h1 class="sr-only">{profile.title}</h1>
  <AccountPage
    client:load
    {...accountPageBase(locale, profile.signInNotice)}
    body={{ page: 'reputacion', texts }}
  />
</PageLayout>
