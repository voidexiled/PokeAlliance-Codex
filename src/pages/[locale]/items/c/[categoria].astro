---
// Ítems of one Market category (spec 8.5): the `items` list of `/{l}/items/` (../index.astro)
// kept to the items of one of the 13 real categories of content/items/categorias.json, one
// prerendered page per category and locale. Template B (8.0.2): the breadcrumb, PageTitle,
// then the list island — the category navigation with this category current, the results
// bar, the active view without groups and the pagination — and the footer that PageLayout
// adds. The island loads on `client:load` (7.3). A category id the registry does not have has
// no page and answers 404 (8.5 «Rutas»); «Todo», the virtual category, is `/{l}/items/`.
//
// Data (PR5). `buildItemsData` of ../datos.json.ts writes every item; this page prints the
// first page of its category and gives the island those rows, with the part of `refs` they
// name, the length of the category, the 14 tabs and the element chips and one-Pokémon «Drop
// de» of that first page, panels included. When the category has more than one page the
// island asks for `/{l}/items/datos.json` as it hydrates and keeps the rows of its category.
// A prerendered page never reads its query (PR2). A category without items, or whose items a
// build with OCULTAR_BORRADORES=1 hides (IT2), draws the navigation and the `EmptyState` of
// 8.5, without count, view or island.
//
// Text. The h1, the current crumb, the tab and the Lista caption use the category's `nombre`
// in the page's language; the group crumb is the label of the «Ítems» group of the menu
// (src/lib/nav/groups.ts, 8.0.3), a link to `/{l}/items/` (8.0.4). The description (13.5) and
// the texts of the list come from `messages.items` and `messages.ui` (DP1, 13.2).
import { getAlternatePath, getLocale, locales, type Locale } from '@/i18n/config';
import type { Messages } from '@/i18n/messages/en';
import { en } from '@/i18n/messages/en';
import { es } from '@/i18n/messages/es';
import { fill } from '@/i18n/messages/types';
import { getCategorias } from '@/lib/content/registry';
import { buildNav } from '@/lib/nav/groups';
import {
  ItemsEmpty,
  ItemsNavigation,
  ItemsRoot,
  type ItemsListLabels,
} from '@/components/items/ItemsRoot';
import { PageTitle } from '@/components/layout/PageTitle';
import PageLayout from '@/layouts/PageLayout.astro';

import { buildItemsData, itemTabs, itemsFirstPage } from '../datos.json.ts';

export const prerender = true;

/** One page per real category of the registry and per locale; «Todo» is not one of them. */
export function getStaticPaths() {
  const categories = getCategorias().filter((category) => category.virtual !== true);
  return locales.flatMap((locale) =>
    categories.map((category) => ({ params: { locale, categoria: category.id } })),
  );
}

const dictionaries: Record<Locale, Messages> = { es, en };

const locale = getLocale(Astro.params.locale);
const id = Astro.params.categoria;
const path = Astro.url.pathname;
const alternates = Object.fromEntries(
  locales.map((option) => [option, getAlternatePath(path, option)]),
) as Record<Locale, string>;

const tabs = itemTabs(locale);
const current = tabs.find((tab) => tab.id === id);
if (current === undefined) {
  throw new Error(`content/items/categorias.json: no category «${id}» (8.5).`);
}
const title = current.nombre;

// 8.0.4: «Ítems › {categoría}», the group crumb a link to its index.
const group = buildNav(locale, path).groups.find((entry) => entry.id === 'items');
if (group === undefined) {
  throw new Error('src/lib/nav/groups.ts: no «items» group with this page in it (8.0.3).');
}

const messages = dictionaries[locale];
const copy = messages.items;
const first = itemsFirstPage(buildItemsData(locale), current.id);
const labels: ItemsListLabels = {
  count: copy.count,
  sprite: copy.columnSprite,
  item: copy.columnItem,
  droppedByCount: copy.droppedByCount,
  search: copy.searchPlaceholder,
  noResults: copy.noResults,
};
---

<PageLayout
  locale={locale}
  title={title}
  description={fill(copy.categoryDescription, { category: title })}
  alternates={alternates}
  breadcrumb={[{ label: group.label, href: `/${locale}/items/` }, { label: title }]}
>
  <PageTitle title={title} />
  {
    first.total > 0 ? (
      <ItemsRoot
        client:load
        locale={locale}
        path={path}
        dataUrl={`/${locale}/items/datos.json`}
        category={current.id}
        data={first.data}
        total={first.total}
        categories={[current]}
        elements={[]}
        droppers={{}}
        title={title}
        caption={fill(copy.caption, { category: title })}
        ui={messages.ui}
        labels={labels}
      >
        <ItemsNavigation tabs={tabs} category={current.id} label={copy.categoriesLabel} />
      </ItemsRoot>
    ) : (
      <ItemsEmpty tabs={tabs} category={current.id} label={copy.categoriesLabel}>
        {copy.empty}
      </ItemsEmpty>
    )
  }
</PageLayout>
