---
import AppLayout from '../../../layouts/AppLayout.astro';
import DataStatus from '../../../components/wiki/DataStatus.astro';
import EvidenceTrail from '../../../components/wiki/EvidenceTrail.astro';
import {
  getFact,
  getRecordEvidence,
  getRecords,
  formatFactValue,
} from '../../../lib/content/repository';
import { getLocale, locales, type Locale } from '../../../i18n/config';

export const prerender = true;

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = getLocale(Astro.params.locale) as Locale;
const quests = getRecords('quests');
const locations = getRecords('locations');
const copy =
  locale === 'es'
    ? {
        title: 'Guías',
        description: 'Misiones, viajes y rutas documentadas desde registros con evidencia.',
        eyebrow: 'Wiki Core / Guías',
        intro:
          'Procedimientos útiles con límites explícitos cuando la fuente no publica coordenadas.',
        quests: 'Misiones revisadas',
        locations: 'Ubicaciones y viaje',
        level: 'Nivel requerido',
        steps: 'Pasos',
        rewards: 'Recompensas',
        route: 'Ruta de viaje',
        evidence: 'evidencias',
      }
    : {
        title: 'Guides',
        description: 'Documented quests, travel and routes built from evidenced records.',
        eyebrow: 'Wiki Core / Guides',
        intro: 'Useful procedures with explicit limits when a source does not publish coordinates.',
        quests: 'Reviewed quests',
        locations: 'Locations & travel',
        level: 'Required level',
        steps: 'Steps',
        rewards: 'Rewards',
        route: 'Travel route',
        evidence: 'evidence items',
      };
const questViews = quests.map((quest) => ({
  quest,
  level: getFact<number>(quest, 'requiredLevel')?.value,
  steps: getFact<string[]>(quest, 'steps')?.value ?? [],
  rewards: getFact<string[]>(quest, 'rewards')?.value ?? [],
  summary: getFact<string>(quest, 'summary')?.value,
  evidence: getRecordEvidence(quest),
}));
const locationViews = locations.map((location) => ({
  location,
  region: getFact<string>(location, 'region')?.value,
  access: getFact<string[]>(location, 'accessRequirements')?.value ?? [],
  connections: getFact<unknown[]>(location, 'travelConnections')?.value ?? [],
  evidence: getRecordEvidence(location),
}));
---

<AppLayout locale={locale} title={copy.title} description={copy.description}>
  <div>
    <nav
      class="wiki-breadcrumbs"
      aria-label={locale === 'es' ? 'Ruta de navegación' : 'Breadcrumb'}
    >
      <a href={`/${locale}/`}>{locale === 'es' ? 'Inicio' : 'Home'}</a>
      <span class="wiki-breadcrumb-separator">/</span>
      <span>{copy.title}</span>
    </nav>
    <header class="wiki-page-header">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1 class="display-title">{copy.title}</h1>
      <p class="muted-copy">{copy.intro}</p>
    </header>

    <section class="wiki-section" aria-labelledby="quests-title">
      <div class="flex items-end justify-between gap-4">
        <h2 id="quests-title" class="section-title">{copy.quests}</h2>
        <span class="font-mono text-xs text-muted-foreground">{quests.length}</span>
      </div>
      <div class="mt-4 grid gap-5">
        {
          questViews.map(({ quest, level, steps, rewards, summary, evidence }) => (
            <article id={quest.canonicalSlug} class="wiki-panel wiki-article-panel p-5 sm:p-6">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <p class="eyebrow">Quest record</p>
                  <h3 class="mt-2 text-2xl font-semibold tracking-tight text-foreground">
                    {quest.canonicalName}
                  </h3>
                  {summary && <p class="muted-copy mt-3">{summary}</p>}
                </div>
                <DataStatus
                  status={Object.values(quest.facts)[0]?.status ?? 'unknown'}
                  locale={locale}
                />
              </div>
              <div class="mt-6 grid gap-5 lg:grid-cols-3">
                <div>
                  <p class="eyebrow">{copy.level}</p>
                  <p class="mt-2 text-lg font-semibold">{level ?? '—'}</p>
                </div>
                <div>
                  <p class="eyebrow">{copy.steps}</p>
                  <ol class="mt-2 grid gap-2 text-sm leading-6 text-foreground/80">
                    {steps.map((step, index) => (
                      <li>
                        {index + 1}. {step}
                      </li>
                    ))}
                  </ol>
                </div>
                <div>
                  <p class="eyebrow">{copy.rewards}</p>
                  <ul class="mt-2 grid gap-2 text-sm leading-6 text-foreground/80">
                    {rewards.map((reward) => (
                      <li>• {reward}</li>
                    ))}
                  </ul>
                </div>
              </div>
              <p class="mt-6 font-mono text-[0.65rem] uppercase tracking-[0.13em] text-muted-foreground">
                {evidence.length} {copy.evidence}
              </p>
              <EvidenceTrail records={evidence} locale={locale} />
            </article>
          ))
        }
      </div>
    </section>

    <section class="wiki-section" aria-labelledby="locations-title">
      <div class="flex items-end justify-between gap-4">
        <h2 id="locations-title" class="section-title">{copy.locations}</h2>
        <span class="font-mono text-xs text-muted-foreground">{locations.length}</span>
      </div>
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        {
          locationViews.map(({ location, region, access, connections, evidence }) => (
            <article id={location.canonicalSlug} class="wiki-panel wiki-article-panel p-5">
              <p class="eyebrow">
                {location.kind ?? 'location'} · {region ?? '—'}
              </p>
              <h3 class="mt-2 text-xl font-semibold tracking-tight">{location.canonicalName}</h3>
              <p class="eyebrow mt-5">{copy.route}</p>
              <div class="mt-2 grid gap-2 text-sm leading-6 text-foreground/80">
                {access.map((requirement) => (
                  <p>• {requirement}</p>
                ))}
                {connections.map((connection) => (
                  <p>• {formatFactValue(connection)}</p>
                ))}
              </div>
              <p class="mt-5 font-mono text-[0.65rem] uppercase tracking-[0.13em] text-muted-foreground">
                {evidence.length} {copy.evidence}
              </p>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</AppLayout>
