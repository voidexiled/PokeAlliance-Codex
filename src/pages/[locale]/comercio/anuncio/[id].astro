---
// The listing page (spec 9.6; board Anuncio-detalle «Variante 1» and its phone board, owner
// decision 2026-09-24): `noindex` (9.3), one page per listing but the `retirado` ones, which are
// a 404 to the public (9.4).
//
// Composition:
//   1. the crumbs «Comunidad › Comercio › {título}» (8.0.4): «Comunidad» has no index page;
//   2. the hero (ListingHero.tsx): the art in its frame, the h1 with the title of
//      `listingTitle` (9.4), «{Mundo} · Publicado el {fecha}» and the state when it is not
//      `publicado`, the tag «Dinero real» of phase B (9.15.2), and the facts, label over value;
//   3. «Equipo», the panel of slots of a Pokémon (16.4.5): Ball, Auras, Addons, Held X and Held Y
//      with their tier, Mega Stone; then «Entrenamiento» and «Ditto Memory» when declared;
//   4. the trade box, sticky beside them from 64rem: the price with its unit price and «El sitio
//      no procesa pagos.»; the seller with its status, the character it sells as («Void Exiled ·
//      Titan 1», «Copiar»), «Entrega solo en {mundo}» or «Cualquier mundo», its reputation, member
//      date and verified channels; then the actions (`TradeBox`, phase B), «Copiar enlace» and
//      «Reportar anuncio» (9.11). The seller sees its own actions there: «Editar anuncio» and the
//      states (owner rule 2026-09-24: editable at any time, quantity included);
//   5. «Más anuncios de {vendedor}»: up to four of its other public listings, and «Ver perfil».
// On a phone the box follows the hero, «Equipo» after it, and a bar with the price and
// «Contactar al vendedor» shows at the bottom once the box leaves the view.
//
// Every Comercio route opens with the 18+ gate (`AgeGate`, 9.15.2), in both phases.
//
// Render (9.3). No `prerender` export: src/integrations/comercio-fases.ts sets it by phase and
// fails the build on one. In phase A the build writes one HTML per listing from `getStaticPaths`,
// which is empty without COMERCIO_DEMO (9.2, CA-9.1): src/lib/trade/registry.ts gives no listing.
//
// Time (9.4, CA-9.20). The state is the one the visitor sees: a `publicado` or `reservado` listing
// whose `expira` is behind the clock is «Expirado». The build writes it with its own clock, and a
// small script writes it again with the visitor's, when the page opens and when `expira` comes.
import { createElement } from 'react';

import { getAlternatePath, getLocale, locales, type Locale } from '@/i18n/config';
import type { Messages } from '@/i18n/messages/en';
import { en } from '@/i18n/messages/en';
import { es } from '@/i18n/messages/es';
import { fill, isPluralMessage, plural } from '@/i18n/messages/types';
import {
  getAuras,
  getCategorias,
  getElementos,
  getItems,
  getMonedaDiamantes,
  getMundos,
  getOutfits,
  getSpriteRegistry,
} from '@/lib/content/registry';
import { getPokemon } from '@/lib/content/repository';
import { resolvePokemonImage } from '@/lib/content/pokemon-media';
import { formatDate } from '@/lib/format/dates';
import { formatInteger, formatPercent, formatRating, formatRealMoney } from '@/lib/format/numbers';
import { diamondsTip } from '@/lib/game/tips';
import { buildNav } from '@/lib/nav/groups';
import { COMERCIO_CACHE_CONTROL, DISCORD_EDAD_MIN_DIAS, EVIDENCIA_DIAS } from '@/lib/trade/limits';
import { comercioPublico, getAnuncios } from '@/lib/trade/registry';
import { loadAnuncio, loadVendedor } from '@/lib/trade/source';
import {
  hasPublicDetail,
  isListed,
  sellerReputation,
  tradesAcrossWorlds,
  visibleStatus,
} from '@/lib/trade/types';
import { Chip } from '@/components/content/Chip';
import { NestedEntity } from '@/components/game/NestedEntity';
import { Sprite } from '@/components/game/Sprite';
import { ChipRow } from '@/components/money/ChipRow';
import { PriceOptions } from '@/components/money/PriceOptions';
import { TrainingMeter } from '@/components/money/TrainingMeter';
import { SellerPresence } from '@/components/cards/ListingCard';
import { AgeGate } from '@/components/trade/AgeGate';
import { ListingEquipment, ListingHero, type HeroFact } from '@/components/trade/ListingHero';
import {
  realMoneyConsentLabels,
  type ContactSellerLabels,
} from '@/components/trade/RealMoneyConsent';
import { ReportAction } from '@/components/trade/ReportDialog';
import { TradeBox, type TradeBoxLabels } from '@/components/trade/TradeBox';
import {
  listingCard,
  listingHref,
  listingSprite,
  listingTitleNode,
  pokemonPanel,
  sellerHref,
  sellerPresence,
  tradeDiamonds,
  tradeLabels,
  tradeRecords,
  tradeSprites,
  unitText,
  type TradeCatalog,
  type TradeContext,
  type TradeRow,
} from '@/components/trade/TradeListRoot';
import PageLayout from '@/layouts/PageLayout.astro';

import '@/styles/components/trade-detail.css';

export function getStaticPaths() {
  const anuncios = getAnuncios().filter(hasPublicDetail);
  return locales.flatMap((locale) =>
    anuncios.map((anuncio) => ({ params: { locale, id: anuncio.id } })),
  );
}

const dictionaries: Record<Locale, Messages> = { es, en };

const locale = getLocale(Astro.params.locale);
// Egress (9.16.4): shared CDN cache; the HTML holds nothing personal (the islands ask for it).
Astro.response.headers.set('Cache-Control', COMERCIO_CACHE_CONTROL);
// Phase A reads the sample registry, phase B the database (src/lib/trade/source.ts, 9.3).
const { anuncio, vendedores } = await loadAnuncio(Astro.params.id ?? '');
// 9.4: a withdrawn listing, or one this build does not have, is not a page.
if (anuncio === undefined || !hasPublicDetail(anuncio)) {
  return new Response(null, { status: 404 });
}

const path = Astro.url.pathname;
const alternates = Object.fromEntries(
  locales.map((option) => [option, getAlternatePath(path, option)]),
) as Record<Locale, string>;
const messages = dictionaries[locale];
const { ui, trade } = messages;

// 8.0.4: «Comunidad › Comercio › {título}».
const group = buildNav(locale, path).groups.find((entry) => entry.id === 'comunidad');
const comercio = group?.items.find((item) => item.id === 'comercio');
if (group === undefined || comercio === undefined) {
  throw new Error('src/lib/nav/groups.ts: no «comercio» entry in the «comunidad» group (8.0.3).');
}

// «Más anuncios de {vendedor}»: its other public listings (phase B reads them with the profile).
const builtAt = new Date();
const { anuncios: sellerListings } = await loadVendedor(anuncio.vendedor);
const others = sellerListings
  .filter((other) => other.id !== anuncio.id && isListed(other, builtAt))
  .slice(0, 4);

const registry = getSpriteRegistry();
const catalog: TradeCatalog = {
  pokemon: getPokemon(),
  items: getItems(),
  categorias: getCategorias(),
  elementos: getElementos(),
  auras: getAuras(),
  outfits: getOutfits(),
  mundos: getMundos(locale),
  vendedores,
  sprites: registry,
  channels: trade.channels,
};
const {
  rows: [row, ...moreRows],
  refs,
} = tradeRecords([anuncio, ...others], catalog, locale);
// Phase B (9.2): the tag, the actions and the report exist only with COMERCIO_PUBLICO (S11).
const publico = comercioPublico();
const moneda = getMonedaDiamantes();
const sprites = tradeSprites(registry);
const context: TradeContext = {
  locale,
  refs,
  sprites,
  diamonds: tradeDiamonds(moneda, locale),
  ui,
  labels: tradeLabels(messages, publico),
};
// The Diamond turns in Comercio (7.8). Without a row there is no panel (R2).
const diamondsPanel = diamondsTip(moneda, locale, ui.tooltip, {
  sprite: sprites.types.diamonds,
  animated: true,
});
const diamondsLink = diamondsPanel === null ? undefined : { tip: diamondsPanel, hint: ui.pinHint };
const title = listingTitleNode(row);

// The head line (9.6): the world, the day of publication and the state the visitor sees.
const status = visibleStatus(anuncio, builtAt);
const state =
  status === 'reservado'
    ? trade.states.reservado
    : status === 'completado'
      ? trade.states.completado
      : status === 'expirado'
        ? trade.states.expirado
        : null;
const canExpire = anuncio.estado === 'publicado' || anuncio.estado === 'reservado';
const worldName = Object.hasOwn(refs.mundos, row.mundo) ? refs.mundos[row.mundo] : null;
const anyWorld = tradesAcrossWorlds(row.tipo);
const meta = [worldName, fill(trade.detail.posted, { date: formatDate(row.publicado, locale) })]
  .filter((part) => part !== null)
  .join(' · ');

// The hero's facts: the card's, label over value, with Variante first for a Pokémon.
const card = listingCard(row, context, formatDate(row.publicado, locale));
const keys = trade.listing.keys;
const facts: HeroFact[] = [];
const cardFacts = card.facts ?? {};
const pokemonRef =
  row.pokemon !== null && Object.hasOwn(refs.pokemon, row.pokemon.pokemon)
    ? refs.pokemon[row.pokemon.pokemon]
    : null;
if (row.tipo === 'pokemon') {
  if (pokemonRef !== null) {
    facts.push({
      key: 'variant',
      label: trade.box.variant,
      value: pokemonRef.variante === 'shiny' ? ui.shiny : ui.cards.normal,
    });
    facts.push({ key: 'tier', label: keys.tier, value: pokemonRef.tier, kind: 'tier' });
  }
  facts.push({ key: 'elements', label: keys.elements, value: cardFacts.elements ?? null });
  facts.push({ key: 'requirement', label: keys.requirement, value: cardFacts.requirement ?? null });
  facts.push({ key: 'boost', label: keys.boost, value: cardFacts.boost ?? null });
  facts.push({
    key: 'starLevel',
    label: keys.starLevel,
    value: row.pokemon?.starLevel ?? null,
    kind: 'stars',
  });
  facts.push({ key: 'nickname', label: keys.nickname, value: cardFacts.nickname ?? null });
  facts.push({ key: 'memorySlots', label: keys.memorySlots, value: cardFacts.memorySlots ?? null });
  const chance = row.pokemon?.nextBoostChance ?? null;
  facts.push({
    key: 'nextBoost',
    label: trade.detail.nextBoost,
    value:
      chance === null
        ? null
        : formatPercent(Number(chance), locale, { decimals: chance.includes('.') ? 2 : 0 }),
  });
  const npc = row.pokemon?.precioNpc ?? null;
  facts.push({
    key: 'npcPrice',
    label: keys.npcPrice,
    value: npc === null ? null : npc.tipo === 'unsellable' ? trade.unsellable : npc.cantidad,
    kind: npc?.tipo === 'pokedolares' ? 'pokedolares' : 'text',
  });
} else {
  const quantityKind =
    row.tipo === 'pokedolares' ? 'pokedolares' : row.tipo === 'diamonds' ? 'diamonds' : 'text';
  facts.push({
    key: 'quantity',
    label: keys.quantity,
    value: cardFacts.quantity ?? null,
    kind: quantityKind,
  });
  for (const key of ['category', 'element', 'use', 'droppedBy', 'boughtAt', 'usedFor'] as const) {
    if (key in cardFacts) facts.push({ key, label: keys[key], value: cardFacts[key] ?? null });
  }
}
const art =
  row.tipo === 'pokemon'
    ? (() => {
        const src = resolvePokemonImage(pokemonRef?.imagen);
        return src === null ? null : { src, smooth: true };
      })()
    : listingSprite(row, context);

// «Equipo» (16.4.5): the card's slots, grouped by kind.
const unit = row.pokemon;
const byId = new Map((card.helds ?? []).map((item) => [item.id ?? item.name, item]));
const slots = (ids: readonly (string | null)[]) =>
  ids.flatMap((id) => (id === null ? [] : (byId.get(id) ?? [])));
const equipment =
  unit === null
    ? []
    : [
        {
          key: 'ball',
          label: keys.ball,
          items: slots([unit.ball]),
          none: trade.box.none,
          named: true,
        },
        {
          key: 'auras',
          label: fill(trade.box.auras, { n: formatInteger(unit.auras.length, locale) }),
          items: slots(unit.auras),
          none: trade.box.noneFeminine,
          wide: true,
        },
        {
          key: 'addons',
          label: trade.detail.addon,
          items: slots(unit.addons),
          none: trade.box.none,
        },
        {
          key: 'heldX',
          label: 'Held X',
          items: slots([unit.heldX]),
          none: trade.box.none,
          named: true,
        },
        {
          key: 'heldY',
          label: 'Held Y',
          items: slots([unit.heldY]),
          none: trade.box.none,
          named: true,
        },
        {
          key: 'mega',
          label: 'Mega Stone',
          items: slots([unit.mega]),
          none: trade.box.noneFeminine,
          named: true,
        },
      ];
const trained = (unit?.entrenamiento ?? []).flatMap((entry) => {
  const percent = entry.progreso === null ? Number.NaN : Number(entry.progreso);
  return entry.nivel === null || !Number.isFinite(percent)
    ? []
    : [{ stat: entry.habilidad, level: entry.nivel, percent }];
});
const memories = (unit?.memorias ?? []).flatMap((id) => {
  if (id === null || !Object.hasOwn(refs.pokemon, id)) return [];
  const pokemon = refs.pokemon[id];
  return [
    {
      id,
      name: pokemon.nombre,
      href: `/${locale}/pokedex/${id}/`,
      tip: pokemonPanel(id, pokemon, context),
    },
  ];
});

// The price (9.6): real money first, «o en el juego» after it; the unit price under them.
const precio = row.precio;
const realMoney = publico && precio.real !== null;
const importe = precio.real === null ? Number.NaN : Number(precio.real.importe);
const fiat =
  precio.real !== null && Number.isFinite(importe)
    ? formatRealMoney(importe, precio.real.moneda, locale)
    : null;
const options = precio.juego.map((option) => ({
  kind: option.tipo === 'pokedolares' ? ('pd' as const) : ('dia' as const),
  amount: option.cantidad,
}));
const unitLine = unitText(row, context);
const priceLabel =
  fiat !== null ? trade.listing.fiat : options.length > 0 ? trade.listing.game : null;

// The seller: its status (9.15.6), the character it sells as, its reputation (9.15.4).
const seller = vendedores.find((vendedor) => vendedor.id === row.vendedor);
const sellerRef = Object.hasOwn(refs.vendedores, row.vendedor)
  ? refs.vendedores[row.vendedor]
  : null;
const reputation = sellerReputation(seller?.resenas ?? []);
const presence = sellerPresence(sellerRef, context);
const channels = sellerRef?.canales ?? [];
const counted = (template: Messages['trade']['box']['reviews'], n: number) =>
  fill(isPluralMessage(template) ? plural(locale, n, template) : template, {
    n: formatInteger(n, locale),
  });
const profile = sellerHref(locale, row.vendedor);
const sellerName = sellerRef?.nombre ?? row.vendedor;
const initial = Array.from(sellerName)[0]?.toUpperCase() ?? '';

// The actions of phase B (9.6, 9.10, 9.11, 9.15.2). Their texts travel as props (DP1).
const dialogUi = { close: ui.close, dismiss: ui.dismiss };
const contactLabels: ContactSellerLabels = {
  contact: trade.contactSeller,
  started: trade.dealStarted,
  goToDeals: trade.goToDeals,
  signIn: trade.requirements.signIn,
  account: trade.requirements.account,
  adultsOnly: trade.adultsOnly,
  discord: trade.requirements.discord,
  discordAge: fill(trade.requirements.discordAge, {
    days: formatInteger(DISCORD_EDAD_MIN_DIAS, locale),
  }),
  suspendedUntil: trade.suspension.until,
  suspended: trade.suspension.indefinite,
  goToAccount: trade.requirements.goToAccount,
  openDeal: trade.limits.openDeal,
  consent: realMoneyConsentLabels(trade, formatInteger(EVIDENCIA_DIAS, locale)),
};
const boxLabels: TradeBoxLabels = {
  buyingAs: trade.box.buyingAs,
  noCharacter: trade.box.noCharacter,
  addCharacter: trade.box.addCharacter,
  dealOpen: trade.box.dealOpen,
  viewDeal: trade.box.viewDeal,
  copy: trade.box.copy,
  copied: trade.box.copied,
  copyLink: trade.box.copyLink,
  linkCopied: trade.box.linkCopied,
  copyFailed: trade.box.copyFailed,
  published: trade.box.published,
  expires: trade.box.expires,
  completedOn: trade.box.completedOn,
  publishedAs: trade.box.publishedAs,
  openDeals: trade.box.openDeals,
  view: trade.box.view,
  edit: trade.box.edit,
  reserve: trade.box.reserve,
  release: trade.manage.release,
  complete: trade.box.complete,
  renew: trade.manage.renew,
  withdraw: trade.box.withdraw,
  withdrawTitle: trade.box.withdrawTitle,
  withdrawText: trade.box.withdrawText,
  cancel: trade.cancel,
  states: {
    reservado: trade.states.reservado,
    completado: trade.states.completado,
    expirado: trade.states.expirado,
  },
  channels: {
    email: trade.channels.correo,
    phone: trade.channels.telefono.replace('{code}', '').trim(),
    discord: trade.channels.discord,
    google: trade.channels.google,
    twitch: trade.channels.twitch,
  },
  refusals: trade.refusals,
};

// «Más anuncios de {vendedor}»: the title, the character and world, and the price.
const moreCards = moreRows.map((other: TradeRow) => {
  const otherFiat =
    other.precio.real === null
      ? null
      : formatRealMoney(Number(other.precio.real.importe), other.precio.real.moneda, locale);
  const otherWorld = Object.hasOwn(refs.mundos, other.mundo) ? refs.mundos[other.mundo] : null;
  return {
    id: other.id,
    href: listingHref(locale, other.id),
    title: other.titulo,
    heard: other.accesible === other.titulo ? null : other.accesible,
    sprite: listingSprite(other, context),
    pokemon: other.tipo === 'pokemon',
    who: [other.personaje ?? sellerName, otherWorld].filter(Boolean).join(' · '),
    fiat: otherFiat,
    game: other.precio.juego.map((option) => ({
      kind: option.tipo === 'pokedolares' ? ('pd' as const) : ('dia' as const),
      amount: option.cantidad,
    })),
    anyWorld: tradesAcrossWorlds(other.tipo),
    negotiable: other.precio.aConvenir,
  };
});
const contactable = status === 'publicado' || status === 'reservado';
---

<PageLayout
  locale={locale}
  title={row.accesible}
  description={fill(trade.detailDescription, { title: row.accesible })}
  alternates={alternates}
  breadcrumb={[
    { label: group.label },
    { label: comercio.label, href: comercio.href },
    { label: title },
  ]}
  preloadGameFont
  noindex
>
  <div class="ac-listing-page">
    <div class="ac-listing-page__main">
      <ListingHero
        label={fill(ui.sheet, { name: row.accesible })}
        title={title}
        meta={canExpire
          ? createElement(
              'span',
              null,
              meta,
              createElement(
                'span',
                { 'data-ac-expira': row.expira, 'data-ac-expirado': ` · ${trade.states.expirado}` },
                state === null ? '' : ` · ${state}`,
              ),
            )
          : state === null
            ? meta
            : `${meta} · ${state}`}
        tags={realMoney || anyWorld
          ? createElement(
              'span',
              { className: 'ac-listing-hero__tag-row' },
              realMoney ? createElement(Chip, null, trade.listing.fiat) : null,
              anyWorld ? createElement(Chip, null, trade.anyWorld) : null,
            )
          : null}
        art={art}
        pokemon={row.tipo === 'pokemon'}
        qty={card.qty ?? null}
        facts={facts}
        locale={locale}
        hint={ui.pinHint}
        shinyLabel={ui.shiny}
        orLabel={ui.or}
        starsLabel={(n: number) => `${keys.starLevel} ${formatInteger(n, locale)}`}
      />
      {
        equipment.length > 0 && (
          <ListingEquipment
            title={trade.listing.equipment}
            groups={equipment}
            locale={locale}
            hint={ui.pinHint}
            orLabel={ui.or}
          />
        )
      }
      {
        (trained.length > 0 || memories.length > 0) && (
          <section class="ac-listing-panel">
            {trained.length > 0 && (
              <>
                <h2 class="ac-listing-panel__title">
                  {fill(trade.tip.training, { n: formatInteger(trained.length, locale) })}
                </h2>
                <div class="ac-listing-panel__trainings">
                  {trained.map((training) => (
                    <TrainingMeter
                      variant="tooltip"
                      stat={training.stat}
                      level={training.level}
                      percent={training.percent}
                      locale={locale}
                      labels={ui.money}
                    />
                  ))}
                </div>
              </>
            )}
            {memories.length > 0 && (
              <>
                <h2 class="ac-listing-panel__title">
                  {fill(trade.detail.dittoMemory, { n: formatInteger(memories.length, locale) })}
                </h2>
                <p class="ac-listing-panel__memories">
                  {memories.map((memory) => (
                    <NestedEntity
                      tip={memory.tip}
                      href={memory.href}
                      variant="link"
                      placement="up"
                      align="start"
                      inline
                      locale={locale}
                      hint={ui.pinHint}
                      shinyLabel={ui.shiny}
                      orLabel={ui.or}
                    >
                      {memory.name}
                    </NestedEntity>
                  ))}
                </p>
              </>
            )}
          </section>
        )
      }
    </div>

    <aside class="ac-trade-box" id="caja" aria-label={trade.price}>
      <div class="ac-trade-box__price">
        {priceLabel !== null && <p class="ac-trade-box__label">{priceLabel}</p>}
        {
          fiat !== null ? (
            <p class="ac-trade-box__amount">{fiat}</p>
          ) : options.length > 0 ? (
            <div class="ac-trade-box__amount">
              <PriceOptions options={options} locale={locale} orLabel={ui.or} link={diamondsLink} />
            </div>
          ) : precio.aConvenir ? (
            <p class="ac-trade-box__amount">{trade.listing.negotiable}</p>
          ) : null
        }
        {
          fiat !== null && options.length > 0 && (
            <div class="ac-trade-box__or">
              <span>{trade.box.orInGame}</span>
              <PriceOptions options={options} locale={locale} orLabel={ui.or} link={diamondsLink} />
            </div>
          )
        }
        {unitLine !== null && <p class="ac-trade-box__unit">{unitLine}</p>}
        <p class="ac-trade-box__muted">{trade.box.noPayments}</p>
      </div>

      {
        sellerRef !== null && (
          <div class="ac-trade-box__seller">
            <div class="ac-trade-box__who" data-buyer-only>
              <span class="ac-trade-box__avatar" aria-hidden="true">
                {initial}
              </span>
              <span>
                <a class="ac-trade-box__handle" href={profile}>
                  {sellerRef.nombre}
                </a>
                {presence !== null && (
                  <SellerPresence state={presence.state} label={presence.label} />
                )}
              </span>
            </div>
            {row.personaje !== null && (
              <>
                <p class="ac-trade-box__label">
                  <span data-buyer-only>{trade.box.character}</span>
                  <span data-owner-only>{trade.box.publishedAs}</span>
                </p>
                <p class="ac-trade-box__character">
                  <strong>{row.personaje}</strong>
                  {worldName !== null && <Chip>{worldName}</Chip>}
                  <button
                    type="button"
                    class="ac-trade-box__copy"
                    data-ac-copy={row.personaje}
                    data-ac-copied={trade.box.copied}
                  >
                    {trade.box.copy}
                  </button>
                </p>
              </>
            )}
            {anyWorld ? (
              <p class="ac-trade-box__muted">
                {trade.box.delivery} <Chip>{trade.anyWorld}</Chip>
              </p>
            ) : (
              worldName !== null && (
                <p class="ac-trade-box__muted">{fill(trade.box.deliverIn, { world: worldName })}</p>
              )
            )}
            <dl class="ac-trade-box__rows" data-buyer-only>
              <div>
                <dt>{trade.seller.rating}</dt>
                <dd>
                  {reputation.valoracion !== null && reputation.resenas > 0 ? (
                    <>
                      {fill(trade.box.scoreOf, { score: formatRating(reputation.valoracion) })}{' '}
                      <a href={`${profile}#resenas`}>
                        {counted(trade.box.reviews, reputation.resenas)}
                      </a>
                    </>
                  ) : (
                    trade.seller.noReviews
                  )}
                </dd>
              </div>
              <div>
                <dt>{trade.confirmed}</dt>
                <dd>{formatInteger(reputation.operaciones, locale)}</dd>
              </div>
              {seller?.desde && (
                <div>
                  <dt>{trade.seller.memberSince}</dt>
                  <dd>{formatDate(seller.desde, 'es').slice(3)}</dd>
                </div>
              )}
              {channels.length > 0 && (
                <div>
                  <dt>{trade.box.contact}</dt>
                  <dd>
                    <ChipRow
                      items={channels}
                      cap={channels.length}
                      labels={ui.money}
                      locale={locale}
                    />
                  </dd>
                </div>
              )}
            </dl>
          </div>
        )
      }

      {
        publico ? (
          <TradeBox
            client:load
            locale={locale}
            listingId={anuncio.id}
            seller={row.vendedor}
            sellerName={row.personaje ?? sellerName}
            world={row.mundo}
            worldName={worldName}
            anyWorld={anyWorld}
            status={status}
            expira={row.expira}
            realMoney={precio.real !== null}
            worlds={Object.fromEntries(catalog.mundos.map((world) => [world.id, world.nombre]))}
            hrefs={{
              characters: `/${locale}/cuenta/#personajes`,
              edit: `/${locale}/comercio/publicar/?editar=${anuncio.id}`,
              deals: `/${locale}/comercio/operaciones/`,
            }}
            labels={boxLabels}
            contact={contactLabels}
            ui={dialogUi}
          />
        ) : null
      }
      {
        publico && (
          <div class="ac-trade-box__report" data-buyer-only>
            <ReportAction
              client:load
              locale={locale}
              messages={trade.report}
              ui={dialogUi}
              targetType="listing"
              targetId={anuncio.id}
            />
          </div>
        )
      }
    </aside>

    {
      moreCards.length > 0 && (
        <section class="ac-listing-more">
          <div class="ac-listing-more__head">
            <h2 class="ac-listing-more__title">{fill(trade.box.moreFrom, { name: sellerName })}</h2>
            <a class="ac-listing-more__profile" href={profile}>
              {trade.box.viewProfile}
            </a>
          </div>
          <ul class="ac-listing-more__list">
            {moreCards.map((more) => (
              <li class="ac-listing-more__card">
                <span class="ac-listing-more__art" data-pokemon={more.pokemon ? '' : undefined}>
                  {more.sprite !== null && <Sprite {...more.sprite} alt="" loading="lazy" />}
                </span>
                <span class="ac-listing-more__text">
                  <a class="ac-listing-more__link" href={more.href}>
                    {more.heard === null ? (
                      more.title
                    ) : (
                      <>
                        <span aria-hidden="true">{more.title}</span>
                        <span class="sr-only">{more.heard}</span>
                      </>
                    )}
                  </a>
                  <span class="ac-listing-more__who">{more.who}</span>
                  <span class="ac-listing-more__price">
                    {more.fiat !== null ? (
                      <strong>{more.fiat}</strong>
                    ) : more.game.length > 0 ? (
                      <PriceOptions
                        options={more.game.slice(0, 1)}
                        locale={locale}
                        orLabel={ui.or}
                      />
                    ) : more.negotiable ? (
                      trade.listing.negotiable
                    ) : null}
                    {more.anyWorld && <Chip>{trade.anyWorld}</Chip>}
                  </span>
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>

  {
    contactable && publico && (
      <div class="ac-listing-bar" data-ac-listing-bar hidden>
        <span class="ac-listing-bar__price">
          <strong>{fiat ?? (options.length > 0 ? '' : trade.listing.negotiable)}</strong>
          {options.length > 0 && <PriceOptions options={options} locale={locale} orLabel={ui.or} />}
        </span>
        <a class="ac-button ac-button--solid" href="#caja">
          {trade.contactSeller}
        </a>
      </div>
    )
  }

  {/* 9.15.2: the 18+ gate, a closed dialog until the island decides. */}
  <AgeGate
    client:load
    locale={locale}
    labels={{ title: trade.adultsOnly, adult: trade.ageGate.adult, minor: trade.ageGate.minor }}
    closeLabel={ui.close}
  />
</PageLayout>

<script>
  // 9.4, CA-9.20: a public listing whose `expira` the visitor's clock has passed reads «Expirado»,
  // at once if it already expired, or when it expires while the page is open. The build wrote the
  // state its own clock saw; a timer longer than the browser holds is not set.
  const LONGEST_TIMER = 2_147_483_647;
  for (const state of document.querySelectorAll<HTMLElement>('[data-ac-expira]')) {
    const end = Date.parse(state.dataset.acExpira ?? '');
    if (Number.isNaN(end)) continue;
    const expire = () => {
      state.textContent = state.dataset.acExpirado ?? '';
    };
    const left = end - Date.now();
    if (left <= 0) expire();
    else if (left <= LONGEST_TIMER) window.setTimeout(expire, left);
  }

  // «Copiar» of the seller's character: the player name on the clipboard, «Copiado» for a moment.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-ac-copy]')) {
    const idle = button.textContent ?? '';
    button.addEventListener('click', () => {
      navigator.clipboard.writeText(button.dataset.acCopy ?? '').then(
        () => {
          button.textContent = button.dataset.acCopied ?? idle;
          window.setTimeout(() => {
            button.textContent = idle;
          }, 2000);
        },
        () => undefined,
      );
    });
  }

  // The phone bar (board Anuncio-detalle-movil): the price and «Contactar al vendedor» show at the
  // bottom once the trade box has left the view, and hide while it is on screen.
  const bar = document.querySelector<HTMLElement>('[data-ac-listing-bar]');
  const box = document.getElementById('caja');
  if (bar && box && 'IntersectionObserver' in window) {
    const phone = window.matchMedia('(width < 64rem)');
    const observer = new IntersectionObserver(([entry]) => {
      const below = entry.boundingClientRect.bottom < 0;
      bar.hidden = !(phone.matches && below && !entry.isIntersecting);
    });
    observer.observe(box);
  }
</script>
