---
// Comercio (spec 9.5, board Comercio-filtros «Variante 2», owner decision 2026-09-24): template B
// of 8.0.2 — breadcrumb «Comunidad › Comercio», the PageTitle with «Publicar anuncio» at its right
// (the one white button of the page), and the list island (the type rail with its counts, the
// search with «Filtros», the order and the views, the panel, the tokens, the active view and the
// pagination), the one discreet line of non-affiliation (9.15.2), then the footer PageLayout
// adds. The boards have no banner: the listing page says «El sitio no procesa pagos.». The 18+ gate (`AgeGate`, 9.15.2) opens every Comercio route, in both phases,
// except the empty list of a production phase A, which has no island (CA-9.1).
//
// Render (9.3). The page exports no `prerender`: src/integrations/comercio-fases.ts sets it by
// phase (prerendered in phase A, rendered on demand in phase B) and fails the build if a Comercio
// page exports one, so the hook never wins in silence.
//
// Data (9.2, D-007, R12). The listings are the sample registry of content/comercio/, which
// src/lib/trade/registry.ts reads only with COMERCIO_DEMO=1: a production build has none, and
// then the page is the empty state of 9.5.10 alone — «Aún no hay anuncios.» and «Crear anuncio» —
// with no search, tab, filter, banner or results bar (CA-9.1, S11). With listings, the public
// ones (9.4: `publicado` or `reservado`, not yet expired when the build runs) are sorted by
// «Recientes» with the sellers «En el juego» first (9.15.6, the order of the island's
// `tradeConfig`) and the island receives the first page of that default state with what it names
// (`tradeData`, as one JSON text), and the length of the list; a list longer than one page asks
// for `/{l}/comercio/datos.json` when it hydrates (PR5). A prerendered page never reads its
// query (PR2): the state of the URL is the island's.
//
// Text (DP1, 13.2). The h1 and the crumbs are the menu entry and its group
// (src/lib/nav/groups.ts); everything else is `messages.trade` — the island gets the part of
// `ui` it reads (`tradeUi`) and the labels `tradeLabels` composes, with the tag «Dinero real» of
// phase B (9.15.2) — and the names come from the registries.
import { createElement } from 'react';

import { getAlternatePath, getLocale, locales, type Locale } from '@/i18n/config';
import type { Messages } from '@/i18n/messages/en';
import { en } from '@/i18n/messages/en';
import { es } from '@/i18n/messages/es';
import { fill } from '@/i18n/messages/types';
import {
  getAuras,
  getCategorias,
  getElementos,
  getItems,
  getMonedaDiamantes,
  getMundos,
  getOutfits,
  getSpriteRegistry,
} from '@/lib/content/registry';
import { getPokemon } from '@/lib/content/repository';
import { buildNav } from '@/lib/nav/groups';
import { COMERCIO_CACHE_CONTROL } from '@/lib/trade/limits';
import { comercioPublico } from '@/lib/trade/registry';
import { loadListado } from '@/lib/trade/source';
import { sortListings } from '@/lib/trade/sort';
import { inGameFirst, isListed } from '@/lib/trade/types';
import { EmptyState } from '@/components/content/EmptyState';
import { Button } from '@/components/controls/Button';
import { PageTitle } from '@/components/layout/PageTitle';
import { AgeGate } from '@/components/trade/AgeGate';
import { TRADE_PANEL_TEXTS_ID } from '@/components/trade/TradeFilters';
import {
  TRADE_PAGE_SIZE,
  TradeListRoot,
  publishHref,
  tradeData,
  tradeDiamonds,
  tradeLabels,
  tradePanelTexts,
  tradeSprites,
  tradeUi,
  type TradeCatalog,
} from '@/components/trade/TradeListRoot';
import PageLayout from '@/layouts/PageLayout.astro';

// The line of non-affiliation is also on the empty list, which renders no island (9.15.2).
import '@/styles/components/trade-list.css';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const dictionaries: Record<Locale, Messages> = { es, en };

const locale = getLocale(Astro.params.locale);
// Egress (9.16.4): shared CDN cache; the HTML holds nothing personal (the islands ask for it).
Astro.response.headers.set('Cache-Control', COMERCIO_CACHE_CONTROL);
const path = Astro.url.pathname;
const alternates = Object.fromEntries(
  locales.map((option) => [option, getAlternatePath(path, option)]),
) as Record<Locale, string>;
const messages = dictionaries[locale];
const { ui, trade, picker } = messages;
// 16.4.6: the «Pokémon» and «Ítem» filters. «Pokémon» is a game term (13.4).
const pickers = {
  picker: {
    search: picker.search,
    results: picker.resultsCount.other,
    selectedCount: picker.chosenCount.other,
    done: picker.done,
    clear: picker.remove,
    removeItem: picker.removeItem,
    clearFilters: picker.clearFilters,
    none: picker.none,
    noMatches: picker.noMatches,
    close: ui.close,
    // Plan «Dirección C»: the docked detail pane and the filter menus.
    choose: picker.pick,
    keysHint: picker.keysHint,
    maxHint: ui.filterBar.maxHint,
    menuClear: ui.filterBar.clear,
    ofMax: ui.filterBar.countOfMax,
    and: ui.filterBar.and,
  },
  filters: {
    tier: picker.filters.tier,
    tipo: picker.filters.type,
    moveset: picker.filters.movesetType,
    variante: picker.filters.variant,
    normal: ui.cards.normal,
    generacion: picker.filters.generation,
    tipoRule: ui.filterBar.typeRuleHint,
    movesetRule: ui.filterBar.movesetRuleHint,
    tierRule: ui.filterBar.tierRuleHint,
    maxBrokes: ui.filterBar.maxBrokes,
    all: ui.filterBar.all,
  },
  pokemon: trade.types.pokemon,
  item: trade.typeNames.items,
  category: ui.tooltip.category,
  choosePokemon: fill(picker.choose, { entity: 'Pokémon' }),
  chooseItem: fill(picker.choose, { entity: trade.typeNames.items }),
};

// 8.0.4: «Comunidad › Comercio». The group has no index page, so its crumb is text.
const group = buildNav(locale, path).groups.find((entry) => entry.id === 'comunidad');
const entry = group?.items.find((item) => item.id === 'comercio');
if (group === undefined || entry === undefined) {
  throw new Error('src/lib/nav/groups.ts: no «comercio» entry in the «comunidad» group (8.0.3).');
}
const title = entry.label;

// 9.4: what is public when the build runs, in the default order (9.5.5): «Recientes», the
// sellers «En el juego» first (9.15.6). The sort is stable, so each part keeps «Recientes».
const builtAt = new Date();
// Phase A reads the sample registry, phase B the database (src/lib/trade/source.ts, 9.3).
const { anuncios, vendedores } = await loadListado();
const presence = new Map(vendedores.map((vendedor) => [vendedor.id, vendedor.presencia]));
const listed = sortListings(
  anuncios.filter((anuncio) => isListed(anuncio, builtAt)),
  'recientes',
).sort(
  inGameFirst(
    (anuncio) => presence.get(anuncio.vendedor),
    () => 0,
  ),
);

const registry = getSpriteRegistry();
const catalog: TradeCatalog = {
  pokemon: getPokemon(),
  items: getItems(),
  categorias: getCategorias(),
  elementos: getElementos(),
  auras: getAuras(),
  outfits: getOutfits(),
  mundos: getMundos(locale),
  vendedores,
  sprites: registry,
  channels: trade.channels,
};
// Phase B has no `datos.json` (9.3): the server hands the island every row it read
// (src/lib/trade/source.ts caps them) and the island pages them itself.
const inline = comercioPublico() ? listed : listed.slice(0, TRADE_PAGE_SIZE);
const firstPage = JSON.stringify(tradeData(inline, catalog, locale));
const worlds = catalog.mundos.map((world) => [world.id, world.nombre] as const);

// Phase B publishes («Publicar anuncio»); phase A only drafts («Crear anuncio»). The 18+ gate
// guards any list with an offer (R12): phase B, or listings to show.
const publico = comercioPublico();
const guarded = publico || listed.length > 0;
const createLabel = publico ? trade.composer.publish : trade.create;

// 9.5.10: the one action of the empty list, a link to the publish page.
const create = createElement(Button, { href: publishHref(locale), children: createLabel });
---

<PageLayout
  locale={locale}
  title={title}
  description={trade.description}
  alternates={alternates}
  breadcrumb={[{ label: group.label }, { label: title }]}
>
  <div class="ac-trade-title">
    <PageTitle title={title} />
    {
      listed.length > 0 && (
        <Button href={publishHref(locale)} variant="solid">
          {createLabel}
        </Button>
      )
    }
  </div>
  {
    listed.length > 0 ? (
      <TradeListRoot
        client:load
        variant="market"
        locale={locale}
        path={path}
        data={firstPage}
        total={listed.length}
        dataUrl={inline.length < listed.length ? `/${locale}/comercio/datos.json` : undefined}
        builtAt={builtAt.toISOString()}
        sprites={tradeSprites(registry)}
        worlds={worlds}
        diamonds={tradeDiamonds(getMonedaDiamantes(), locale)}
        caption={trade.list.caption}
        ui={tradeUi(ui)}
        pickers
        labels={tradeLabels(messages, publico, true)}
      />
    ) : (
      <EmptyState action={create}>{trade.list.empty}</EmptyState>
    )
  }
  {
    /* The texts of the «Filtros» panel, read by the island when the panel first opens (13.6:
       out of its props). `<` is escaped so the JSON never closes the script. */
    listed.length > 0 && (
      <script
        type="application/json"
        id={TRADE_PANEL_TEXTS_ID}
        set:html={JSON.stringify(tradePanelTexts(messages, pickers)).replaceAll('<', '\\u003c')}
      />
    )
  }
  <p class="ac-trade-disclaimer">{trade.nonAffiliation}</p>
  {
    /* 9.15.2: the 18+ gate, a closed dialog until the island decides. The empty list of a
       production phase A has no offer to guard and no island (CA-9.1), so it has no gate. */
    guarded && (
      <AgeGate
        client:load
        locale={locale}
        labels={{
          title: trade.adultsOnly,
          adult: trade.ageGate.adult,
          minor: trade.ageGate.minor,
        }}
        closeLabel={ui.close}
      />
    )
  }
</PageLayout>
