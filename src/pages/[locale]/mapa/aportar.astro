---
import AppLayout from '../../../layouts/AppLayout.astro';
import { getLocale, locales, type Locale } from '../../../i18n/config';

export const prerender = true;

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = getLocale(Astro.params.locale) as Locale;
const copy =
  locale === 'es'
    ? {
        title: 'Aportar al mapa',
        description:
          'Formato para enviar observaciones del mapa y coordenadas para revisión manual.',
        eyebrow: 'Herramientas / Mapa',
        intro:
          'Una observación puede ayudar a completar la wiki, pero no se publica como verdad automáticamente. Este formato conserva la evidencia, el momento de captura y el estado de revisión.',
        whatTitle: 'Qué se puede aportar',
        what: [
          'Ubicación de un NPC, entrada de hunt, punto de quest o conexión de viaje.',
          'Área o punto de aparición de un Pokémon, indicando variante y condiciones cuando se conozcan.',
          'Correcciones a un marcador existente que ya esté desactualizado o mal identificado.',
        ],
        fieldsTitle: 'Datos mínimos',
        field: 'Campo',
        required: 'Qué debe contener',
        rows: [
          ['Sujeto', 'Nombre exacto mostrado en el juego; especie, variante, NPC o punto.'],
          ['Tipo', 'spawn_area, hunt_entrance, npc, quest_point, travel_point u otro.'],
          [
            'Coordenadas',
            'x, y y z copiados del cliente. Si sólo se conoce un área, debe indicarse como área.',
          ],
          ['Alcance', 'Mundo/servidor, versión del cliente y condiciones de acceso si aplican.'],
          ['Evidencia', 'Captura, guía, enlace o pasos reproducibles para comprobarlo.'],
          ['Capturado en', 'Instante original en ISO; se mostrará localmente usando Temporal.'],
        ],
        statesTitle: 'Estados de revisión',
        state: 'Estado',
        meaning: 'Significado',
        states: [
          ['pending_review', 'Recibido, todavía no publicado.'],
          ['approved', 'Revisado manualmente y apto para la capa publicada.'],
          ['rejected', 'No se pudo confirmar o contradice evidencia más fuerte.'],
          ['stale', 'Fue válido, pero necesita confirmación por un cambio posterior.'],
        ],
        boundaryTitle: 'Límite actual',
        boundary:
          'Esta página documenta el formato; todavía no existe un envío automático ni una cuenta de colaborador. Los aportes se revisarán manualmente antes de incorporarse al mapa.',
        privacy:
          'No incluyas contraseñas, tokens, datos personales ni información de cuentas. El mapa sólo necesita la observación del juego y su evidencia.',
        back: 'Volver al mapa',
      }
    : {
        title: 'Contribute to the map',
        description: 'Format for sending map observations and coordinates for manual review.',
        eyebrow: 'Tools / Map',
        intro:
          'An observation can help complete the wiki, but it is not published as truth automatically. This format preserves evidence, capture time and review state.',
        whatTitle: 'What you can contribute',
        what: [
          'An NPC, hunt entrance, quest point or travel connection.',
          'A Pokémon spawn area or point, including variant and conditions when known.',
          'A correction to an existing marker that is stale or incorrectly identified.',
        ],
        fieldsTitle: 'Minimum data',
        field: 'Field',
        required: 'What it must contain',
        rows: [
          ['Subject', 'Exact name shown in-game; species, variant, NPC or point.'],
          ['Type', 'spawn_area, hunt_entrance, npc, quest_point, travel_point or other.'],
          [
            'Coordinates',
            'x, y and z copied from the client. An area-only observation must remain an area.',
          ],
          ['Scope', 'World/server, client version and access conditions when applicable.'],
          ['Evidence', 'Screenshot, guide, link or reproducible steps to verify it.'],
          ['Captured at', 'Original instant in ISO; display time will use Temporal locally.'],
        ],
        statesTitle: 'Review states',
        state: 'State',
        meaning: 'Meaning',
        states: [
          ['pending_review', 'Received, not published yet.'],
          ['approved', 'Manually reviewed and suitable for the published layer.'],
          ['rejected', 'Could not be confirmed or conflicts with stronger evidence.'],
          ['stale', 'Previously valid, but needs confirmation after a later change.'],
        ],
        boundaryTitle: 'Current boundary',
        boundary:
          'This page documents the format; automatic submission and contributor accounts are not available yet. Contributions will be reviewed manually before entering the map.',
        privacy:
          'Do not include passwords, tokens, personal data or account information. The map only needs the in-game observation and its evidence.',
        back: 'Back to map',
      };
---

<AppLayout locale={locale} title={copy.title} description={copy.description}>
  <div>
    <nav
      class="wiki-breadcrumbs"
      aria-label={locale === 'es' ? 'Ruta de navegación' : 'Breadcrumb'}
    >
      <a href={`/${locale}/`}>{locale === 'es' ? 'Inicio' : 'Home'}</a>
      <span class="wiki-breadcrumb-separator">/</span>
      <a href={`/${locale}/herramientas/`}>{locale === 'es' ? 'Herramientas' : 'Tools'}</a>
      <span class="wiki-breadcrumb-separator">/</span>
      <a href={`/${locale}/mapa/`}>{locale === 'es' ? 'Mapa' : 'Map'}</a>
      <span class="wiki-breadcrumb-separator">/</span>
      <span>{copy.title}</span>
    </nav>

    <header class="wiki-page-header">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1 class="display-title">{copy.title}</h1>
      <p class="muted-copy">{copy.intro}</p>
    </header>

    <div class="wiki-section wiki-article-layout">
      <article class="wiki-article">
        <section aria-labelledby="what-title">
          <h2 id="what-title">{copy.whatTitle}</h2>
          <ul class="mt-4 list-disc space-y-2 pl-5">
            {copy.what.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section aria-labelledby="fields-title">
          <h2 id="fields-title">{copy.fieldsTitle}</h2>
          <div class="wiki-panel mt-4 overflow-x-auto">
            <table class="wiki-status-table">
              <thead>
                <tr><th>{copy.field}</th><th>{copy.required}</th></tr>
              </thead>
              <tbody>
                {
                  copy.rows.map(([field, value]) => (
                    <tr>
                      <>
                        <td>{field}</td>
                        <td>{value}</td>
                      </>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </section>

        <section aria-labelledby="states-title">
          <h2 id="states-title">{copy.statesTitle}</h2>
          <div class="wiki-panel mt-4 overflow-x-auto">
            <table class="wiki-status-table">
              <thead>
                <tr><th>{copy.state}</th><th>{copy.meaning}</th></tr>
              </thead>
              <tbody>
                {
                  copy.states.map(([state, meaning]) => (
                    <tr>
                      <>
                        <td>
                          <code>{state}</code>
                        </td>
                        <td>{meaning}</td>
                      </>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </section>

        <section class="wiki-panel mt-8 p-5" aria-labelledby="boundary-title">
          <p class="eyebrow">{copy.boundaryTitle}</p>
          <p id="boundary-title" class="mt-2 text-sm leading-6 text-foreground/80">
            {copy.boundary}
          </p>
          <p class="mt-3 text-sm leading-6 text-muted-foreground">{copy.privacy}</p>
        </section>

        <a
          class="mt-6 inline-block text-sm text-accent underline-offset-4 hover:underline"
          href={`/${locale}/mapa/`}>{copy.back} →</a
        >
      </article>

      <aside class="wiki-toc" aria-label={locale === 'es' ? 'Resumen' : 'Summary'}>
        <p class="wiki-toc-title">{locale === 'es' ? 'Resumen' : 'Summary'}</p>
        <a href="#what-title">{copy.whatTitle}</a>
        <a href="#fields-title">{copy.fieldsTitle}</a>
        <a href="#states-title">{copy.statesTitle}</a>
        <a href="#boundary-title">{copy.boundaryTitle}</a>
      </aside>
    </div>
  </div>
</AppLayout>
