---
// Mapa (spec 8.11, R9, A11): the placeholder of the map until its own cut, on template E of
// 8.0.2 with PageLayout, prerendered and `noindex` (13.5). The crumbs «Herramientas › Mapa» —
// the group crumb links to its index, /{l}/herramientas/ (8.0.4) —, the `PageTitle` and the one
// line of `EmptyState`; PageLayout adds the footer. Nothing else: no canvas, image, button or
// island (MP1), and no promise of an interactive map (§12.15).
//
// The explorer is no longer rendered here (R9): `MapExplorer`, content/map/* and src/lib/map/*
// stay in the repository, unused, for the map cut (§15). /{l}/mapa/aportar/ redirects to this
// page (A1).
//
// Text (13.2): the h1, the empty line and the description are `messages.map`, and the group
// crumb is the h1 of that index, `messages.tools.title`.
import { getAlternatePath, getLocale, locales, type Locale } from '@/i18n/config';
import type { Messages } from '@/i18n/messages/en';
import { en } from '@/i18n/messages/en';
import { es } from '@/i18n/messages/es';

import { EmptyState } from '@/components/content/EmptyState';
import { PageTitle } from '@/components/layout/PageTitle';
import PageLayout from '@/layouts/PageLayout.astro';

export const prerender = true;

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const dictionaries: Record<Locale, Messages> = { es, en };

const locale = getLocale(Astro.params.locale);
const path = Astro.url.pathname;
const alternates = Object.fromEntries(
  locales.map((option) => [option, getAlternatePath(path, option)]),
) as Record<Locale, string>;

const { map, tools } = dictionaries[locale];
---

<PageLayout
  locale={locale}
  title={map.title}
  description={map.description}
  alternates={alternates}
  breadcrumb={[{ label: tools.title, href: `/${locale}/herramientas/` }, { label: map.title }]}
  noindex
>
  <PageTitle title={map.title} />
  <EmptyState>{map.empty}</EmptyState>
</PageLayout>
