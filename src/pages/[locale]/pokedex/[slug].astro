---
// Pokémon page (spec 8.3, `Lienzo:Pokedex-Shiny-Charizard`): one prerendered HTML per record
// of `content/pokemon.json` and per locale, on template C of 8.0.2 — the `Toc` rail with two
// sections or more, the 208 spacer and a column of 944 with fewer (PageLayout decides both).
// A slug that is not a record has no route and falls to the 404 of 8.12.
//
// Composition, in the order of 8.3 and of the board:
//   1. the crumbs «Pokémon › Pokédex › {nombre}» (8.0.4): the group has no index page, so its
//      crumb is text;
//   2. `PageTitle` with the name and «Nº {numero}», without a subtitle when `numero` is null;
//   3. the head row (CARD_GRID_SYSTEM §6.8, one height): the art panel, the fixed sheet — a
//      `GameTooltip variant="sheet"` of `size-tt` (282, 7.5.9), with the art of 70 in its head
//      and only the rows that have a value — and, when the Pokémon has an outfit, its panel and
//      the «Aura» group (`OutfitPreview`, `client:visible`, 7.3). The sheet paints Poppins on
//      load, so this page asks PageLayout to preload it (3.9);
//   4. the sections, each one only with data and each one an entry of the `Toc`: «Drops» (the
//      `drops` list, `DropsList`), «Tier list» (the `familia` list, `FamilyList`, E15),
//      «Evolución» (`EvolutionChain`), «Ataques» (`DataTable` and the «Habilidades» chips) and
//      «Dónde encontrarlo» (`FactLines`). With none, the page ends at the head row.
// There is no paginator and no «Volver a la Pokédex» (X11), and no direction selector on the
// outfit (X11, Q11): the board draws the idle south frame alone.
//
// Data (8.0.5, R7, X4). Everything shown comes from the registries of `content/` and from
// `public/sprites/sprites.json`, read with the functions of src/lib/content/ and resolved by
// the sprite adapter (3.12). A value the registry does not have is not invented: in the sheet
// and in the tooltips its row is dropped, in a table or a card it is «—» while another row has
// it, and a section with nothing to show does not exist. No record is marked as a draft.
//
// The fields of §3.13 that `content/schemas/pokemon.schema.json` adds to a Pokémon (`hp`,
// `experiencia`, `drops`, `evolucion`, `habilidades`, `donde`, `elementoMoveset`) are optional
// in `PokemonRecord`, and so are the two an item gains in `Item` (`elemento`, `uso`, M9): a
// registry without them builds the page without their rows and sections.
//
// Text (DP1, 13.2): the page's own copy is `messages.pokemon`; what the components and the
// tooltip builders share is `messages.ui`. The islands receive those strings as props and
// nothing else of the dictionary. Game names — Pokémon, items, abilities, NPC — are written as
// the registry has them and carry no `lang` (13.4).
//
// Styles. The head row, the art panel and the abilities list are this page's alone, so they
// live in the `<style>` block at the end, inside `@layer components`, instead of adding
// utilities to the shared sheet (13.6, S17). Every other piece brings its own rules.
import { createElement } from 'react';

import { getAlternatePath, getLocale, locales, type Locale } from '@/i18n/config';
import type { Messages } from '@/i18n/messages/en';
import { en } from '@/i18n/messages/en';
import { es } from '@/i18n/messages/es';
import { fill } from '@/i18n/messages/types';
import { formatTier } from '@/lib/content/format';
import { resolvePokemonImage } from '@/lib/content/pokemon-media';
import {
  getAuras,
  getCategorias,
  getElementos,
  getItem,
  getOutfitForPokemon,
  getSpriteRegistry,
} from '@/lib/content/registry';
import type { Item } from '@/lib/content/registry-schema';
import { getMoves, getPokemon } from '@/lib/content/repository';
import type { EnlaceDato, PokemonRecord } from '@/lib/content/types';
import { formatDecimal, formatInteger } from '@/lib/format/numbers';
import { present, UNKNOWN } from '@/lib/format/unknown';
import {
  elementTip,
  itemTip,
  pokemonTip,
  type LocalizedText,
  type TipData,
  type TipRow,
} from '@/lib/game/tips';
import { buildNav } from '@/lib/nav/groups';
import { spriteData, spriteOrNull, type SpriteData } from '@/lib/sprites/resolve';

import type { DexCardDrop, DexCardLabels } from '@/components/cards/DexCard';
import { Chip } from '@/components/content/Chip';
import { DataTable, type DataTableColumn, type DataTableRow } from '@/components/content/DataTable';
import { FactLines, type FactLineData, type FactLinePart } from '@/components/content/FactLine';
import { ElementChip, type ElementChipEntry } from '@/components/game/ElementChip';
import { GameTooltip } from '@/components/game/GameTooltip';
import { Sprite } from '@/components/game/Sprite';
import { MissingSprite } from '@/components/game/SpriteStage';
import type { TocItem } from '@/components/layout/Toc.astro';
import { PageTitle } from '@/components/layout/PageTitle';
import { Section } from '@/components/layout/Section';
import type { EntityListLabels } from '@/components/lists/EntityList';
import { DropsList, FamilyList } from '@/components/pokemon/PokemonLists';
import type { DropEntry } from '@/components/pokemon/DropsList';
import EvolutionChain, {
  type EvolutionStage,
  type EvolutionStep,
} from '@/components/pokemon/EvolutionChain.astro';
import type { FamilyEntry } from '@/components/pokemon/FamilyList';
import { OutfitPreview, type OutfitAura } from '@/components/wiki/OutfitPreview';
import PageLayout from '@/layouts/PageLayout.astro';

export const prerender = true;

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    getPokemon().map((record) => ({
      params: { locale, slug: record.id },
      props: { record },
    })),
  );
}

/** A record of `content/pokemon.json`, with the optional fields of §3.13. */
type PokemonSheet = PokemonRecord;

/** A proper noun, the same in both locales (13.4); PageLayout and Header write the same one. */
const BRAND = 'Alliance Codex';

/** 8.0.5: the `variante` of a shiny record. */
const SHINY = 'shiny';

const dictionaries: Record<Locale, Messages> = { es, en };

const locale = getLocale(Astro.params.locale);
const { ui, pokemon: copy } = dictionaries[locale];
const labels = ui.tooltip;
const record: PokemonSheet = Astro.props.record;
const name = record.nombre;

const path = Astro.url.pathname;
const alternates = Object.fromEntries(
  locales.map((option) => [option, getAlternatePath(path, option)]),
) as Record<Locale, string>;

// 8.0.4: «Pokémon › Pokédex › {nombre}». The labels are the menu's (8.0.3).
const group = buildNav(locale, path).groups.find((entry) => entry.id === 'pokemon');
const pokedex = group?.items.find((item) => item.id === 'pokedex');
if (group === undefined || pokedex === undefined) {
  throw new Error('src/lib/nav/groups.ts: no «pokedex» entry in the «pokemon» group (8.0.3).');
}

const registry = getSpriteRegistry();
const allPokemon: PokemonSheet[] = getPokemon();
const byId = new Map(allPokemon.map((entry) => [entry.id, entry]));
const pageHref = (id: string) => `/${locale}/pokedex/${id}/`;

// ------------------------------------------------------------------------------ helpers

/** A `Texto` in the page's language, or in the other one with its `lang` (8.0.5, T22). */
function localized(
  value: LocalizedText | null | undefined,
): { text: string; lang?: Locale } | null {
  if (!value) return null;
  if (present(value[locale])) return { text: value[locale] };
  const other = locales.find((option) => option !== locale && present(value[option]));
  return other === undefined ? null : { text: value[other], lang: other };
}

/** A whole number as §13.3 writes it; a fractional one keeps one decimal. */
function figure(value: number): string {
  return Number.isInteger(value) ? formatInteger(value, locale) : formatDecimal(value, locale, 1);
}

/** 8.0.5: `numero` ascending (unknown last), `normal` before `shiny`, then `nombre`. */
const collator = new Intl.Collator(locale);
function pokemonOrder(a: PokemonSheet, b: PokemonSheet): number {
  if (a.numero !== b.numero) {
    if (a.numero === null) return 1;
    if (b.numero === null) return -1;
    return a.numero - b.numero;
  }
  const rank = (entry: PokemonSheet) =>
    entry.variante === 'normal' ? 0 : entry.variante === SHINY ? 1 : 2;
  return rank(a) - rank(b) || collator.compare(a.nombre, b.nombre);
}

// Elements (8.0.5): the records of `content/elementos.json`, keyed by id.
const elements = new Map(getElementos().map((element) => [element.id, element]));
const itemName = (id: string | null) => (id === null ? null : (getItem(id)?.nombre ?? null));

/** An element as `ElementChip` takes it, with its panel (7.5.3); `null` when unknown. */
function elementEntry(id: string | null | undefined): ElementChipEntry | null {
  if (!id) return null;
  const element = elements.get(id);
  if (element === undefined) return null;
  const icon = spriteOrNull(registry, element.icono);
  return {
    id,
    name: element.nombre[locale],
    icon,
    tip: elementTip(
      {
        id,
        nombre: element.nombre,
        icono: icon,
        stone: itemName(element.stone),
        fragment: itemName(element.fragment),
      },
      locale,
      labels,
    ),
  };
}

/** The element records of a Pokémon, in its order, for `pokemonTip`. */
const elementNames = (ids: readonly string[]) =>
  ids.flatMap((id) => {
    const element = elements.get(id);
    return element === undefined ? [] : [{ nombre: element.nombre }];
  });

/** The Pokémon panel of 7.5.3. */
const tipOf = (entry: PokemonSheet): TipData =>
  pokemonTip({ ...entry, elementos: elementNames(entry.elementos) }, locale, labels);

// Items (7.5.3): the category names, and «Drop de», the inverse of `drops`.
const categoryNames = new Map(getCategorias().map((category) => [category.id, category.nombre]));
const droppers = new Map<string, PokemonSheet[]>();
for (const entry of allPokemon) {
  for (const drop of entry.drops ?? []) {
    const list = droppers.get(drop.item) ?? [];
    if (!list.includes(entry)) list.push(entry);
    droppers.set(drop.item, list);
  }
}
for (const list of droppers.values()) list.sort(pokemonOrder);

/** An item of the registry with its sprite, or `null` when the id is not in it. */
function itemOf(id: string): { item: Item; sprite: SpriteData | null } | null {
  const item = getItem(id);
  return item === undefined ? null : { item, sprite: spriteOrNull(registry, item.sprite) };
}

/** The item panel of 7.5.3. */
function itemTipOf(item: Item, sprite: SpriteData | null): TipData {
  return itemTip(
    {
      id: item.id,
      nombre: item.nombre,
      categoria: item.categoria,
      sprite,
      precioNpc: item.precioNpc,
      nombreCategoria: categoryNames.get(item.categoria) ?? null,
      dropDe: (droppers.get(item.id) ?? []).map((entry) => entry.nombre),
      nombreElemento: item.elemento ? (elements.get(item.elemento)?.nombre ?? null) : null,
      uso: item.uso ?? null,
    },
    locale,
    labels,
  );
}

/** The idle south frame of a Pokémon's outfit (R18), or `null` without one. */
function outfitFrame(id: string): SpriteData | null {
  const outfit = getOutfitForPokemon(id);
  if (outfit === undefined) return null;
  const key = `outfits/${outfit.outfitId}`;
  return Object.hasOwn(registry, key) ? spriteData(registry, key, { direccion: 'sur' }) : null;
}

/** A Pokémon of the registry by id, or `null`: a reference that resolves to nothing is skipped. */
const known = (id: string) => byId.get(id) ?? null;

// ------------------------------------------------------------------------------ head row

const art = resolvePokemonImage(record.imagen);
const numberText =
  record.numero === null ? null : fill(ui.cards.number, { n: String(record.numero) });

// The sheet (7.5.9): the head of `pokemonTip` — the art of 70 and the Shiny mark — and the rows
// of 8.3 in their order, each one only with a value (FI3): Requisito, Tier, Elementos, Rol,
// HP, Experiencia, Generación.
const recordTip = tipOf(record);
const tipRow = (label: string): TipRow | null =>
  recordTip.rows.find((row) => row.label === label) ?? null;
const figureRow = (label: string, value: number | null | undefined): TipRow | null =>
  value === null || value === undefined ? null : { label, value: formatInteger(value, locale) };
const sheet: TipData = {
  ...recordTip,
  rows: [
    tipRow(labels.requirement),
    tipRow(labels.tier),
    tipRow(labels.elements),
    tipRow(labels.role),
    figureRow(copy.hp, record.hp),
    figureRow(copy.experience, record.experiencia),
    tipRow(labels.generation),
  ].filter((row): row is TipRow => row !== null),
};

// The outfit panel and «Aura» (8.3 step 3): only with an outfit in the registry.
const frame = outfitFrame(record.id);
const auras: OutfitAura[] = getAuras().map((aura) => ({
  id: aura.id,
  nombre: aura.nombre,
  shader: aura.shader,
  icon: spriteOrNull(registry, aura.icono),
}));

// ------------------------------------------------------------------------------ sections

const listLabels: EntityListLabels = {
  views: ui.views,
  pagination: ui.pagination,
  prev: ui.prev,
  next: ui.next,
  page: ui.page,
  dataError: ui.dataError,
};

// «Drops» (list `drops`, 8.0.6): one row per entry of `drops`, in the registry's order.
const drops: DropEntry[] = (record.drops ?? []).flatMap((drop) => {
  const found = itemOf(drop.item);
  if (found === null) return [];
  const { item, sprite } = found;
  const by = droppers.get(item.id) ?? [];
  const only = by.length === 1 ? by[0] : undefined;
  const use = localized(item.uso);
  return [
    {
      id: item.id,
      name: item.nombre,
      sprite,
      tip: itemTipOf(item, sprite),
      droppedBy: {
        count: by.length,
        pokemon:
          only === undefined
            ? null
            : { name: only.nombre, href: pageHref(only.id), tip: tipOf(only) },
      },
      element: elementEntry(item.elemento),
      use: use?.text ?? null,
      ...(use?.lang ? { useLang: use.lang } : {}),
      quantity: drop.cantidad,
      npcPrice: item.precioNpc.vende,
    },
  ];
});

// «Tier list» (list `familia`, E15): the evolution line with its variants when the family has
// `evolucion`, the records with the same `numero` when it does not. One closure answers both:
// from this record, every Pokémon it evolves into or from, and every record that shares a
// `numero` with one of them.
const parents = new Map<string, PokemonSheet[]>();
for (const entry of allPokemon) {
  for (const evolution of entry.evolucion ?? []) {
    const list = parents.get(evolution.a) ?? [];
    list.push(entry);
    parents.set(evolution.a, list);
  }
}
const sameNumber = new Map<number, PokemonSheet[]>();
for (const entry of allPokemon) {
  if (entry.numero === null) continue;
  const list = sameNumber.get(entry.numero) ?? [];
  list.push(entry);
  sameNumber.set(entry.numero, list);
}
const familySet = new Set<PokemonSheet>([record]);
const queue: PokemonSheet[] = [record];
for (let next = queue.shift(); next !== undefined; next = queue.shift()) {
  const neighbours = [
    ...(next.evolucion ?? []).flatMap((evolution) => known(evolution.a) ?? []),
    ...(parents.get(next.id) ?? []),
    ...(next.numero === null ? [] : (sameNumber.get(next.numero) ?? [])),
  ];
  for (const neighbour of neighbours) {
    if (familySet.has(neighbour)) continue;
    familySet.add(neighbour);
    queue.push(neighbour);
  }
}
const family = [...familySet].sort(pokemonOrder);
const familyIds = new Set(family.map((entry) => entry.id));
const hasEvolution = family.some((entry) =>
  (entry.evolucion ?? []).some((evolution) => familyIds.has(evolution.a)),
);
// The first stage (8.3): the first member of the family, in the order of 8.0.5, that no
// record names in `a` — the normal root before its Shiny.
const firstStage = family.find((entry) => !parents.has(entry.id)) ?? family[0];
// Without an evolution line the family is the records of one `numero`, which is then known.
const familyCaption =
  hasEvolution || record.numero === null
    ? fill(copy.familyCaption, { name: firstStage?.nombre ?? name })
    : fill(copy.variantsCaption, { n: String(record.numero) });

// The rows carry the record's fields and ids; what the ids name travels once, however many
// variants share it (FamilyList: 13.6 caps its props at 20 KB). A drop or an element the
// registries do not resolve is left out.
const familyElements: Record<string, ElementChipEntry> = {};
const familyItems: Record<string, DexCardDrop> = {};
const familyEntries: FamilyEntry[] = family.map((entry) => {
  const elementIds = [
    ...entry.elementos,
    ...(entry.elementoMoveset ? [entry.elementoMoveset] : []),
  ];
  for (const id of elementIds) {
    const element = familyElements[id] ?? elementEntry(id);
    if (element !== null) familyElements[id] = element;
  }
  const drops = (entry.drops ?? []).flatMap(({ item: id }) => {
    const found = familyItems[id] === undefined ? itemOf(id) : null;
    if (found !== null) {
      const { item, sprite } = found;
      familyItems[id] = { name: item.nombre, sprite, tip: itemTipOf(item, sprite) };
    }
    return familyItems[id] === undefined ? [] : [id];
  });
  return {
    id: entry.id,
    nombre: entry.nombre,
    numero: entry.numero,
    generacion: entry.generacion,
    variante: entry.variante,
    nivel: entry.nivel,
    tier: entry.tier,
    funcion: entry.funcion,
    imagen: entry.imagen,
    elementos: entry.elementos.filter((id) => familyElements[id] !== undefined),
    ...(drops.length > 0 ? { drops } : {}),
    moveset:
      entry.elementoMoveset && familyElements[entry.elementoMoveset] !== undefined
        ? entry.elementoMoveset
        : null,
  };
});

const dexLabels: DexCardLabels = {
  ...ui.cards,
  requirement: labels.requirement,
  level: labels.level,
  tier: labels.tier,
  role: labels.role,
  shiny: ui.shiny,
};

// «Evolución»: one `EvolutionChain` per line from a first stage to a last one that goes
// through this record. A line that branches after it (one Pokémon, several evolutions) is
// drawn once per branch, so no evolution of the registry is left out.
const lines: PokemonSheet[][] = [];
{
  let root = record;
  const seen = new Set<string>([root.id]);
  for (let parent = parents.get(root.id)?.[0]; parent !== undefined;) {
    if (seen.has(parent.id)) break; // content:check refuses cycles; the page never loops.
    seen.add(parent.id);
    root = parent;
    parent = parents.get(root.id)?.[0];
  }
  const walk = (line: PokemonSheet[]) => {
    const last = line[line.length - 1];
    const next = (last.evolucion ?? [])
      .map((evolution) => known(evolution.a))
      .filter((entry): entry is PokemonSheet => entry !== null && !line.includes(entry));
    if (next.length === 0) {
      if (line.includes(record) && line.length > 1) lines.push(line);
      return;
    }
    for (const entry of next) walk([...line, entry]);
  };
  walk([root]);
}

/** A level written with a template of the dictionary, or nothing when it is unknown. */
const levelText = (template: string, level: number | null) =>
  level === null ? null : fill(template, { n: formatInteger(level, locale) });

const chains = lines.map((line) => {
  // DS:EvolutionChain «No hacer»: the meta of a tile keeps the parts the other tiles have,
  // with «—» where this one misses one. Its level is the stage's own Requisito (13.3).
  const withLevel = line.some((entry) => entry.nivel !== null);
  const withTier = line.some((entry) => entry.tier !== null);
  const stages: EvolutionStage[] = line.map((entry) => {
    const parts = [
      withLevel ? (levelText(labels.level, entry.nivel) ?? UNKNOWN) : null,
      withTier ? (entry.tier === null ? UNKNOWN : formatTier(entry.tier)) : null,
    ].filter((part): part is string => part !== null);
    const current = entry.id === record.id;
    return {
      name: entry.nombre,
      sprite: outfitFrame(entry.id),
      meta: parts.length > 0 ? parts.join(' · ') : null,
      ...(current ? { current: true } : { href: pageHref(entry.id), tip: tipOf(entry) }),
    };
  });
  const steps: EvolutionStep[] = line.slice(0, -1).map((entry, index) => {
    const evolution = (entry.evolucion ?? []).find((item) => item.a === line[index + 1]?.id);
    // The requirement chip: the level the Pokémon evolves at (DS:EvolutionChain).
    return {
      requirement: levelText(copy.evolutionLevel, evolution?.nivel ?? null),
      items: (evolution?.items ?? []).flatMap(({ item: id, cantidad }) => {
        const found = itemOf(id);
        if (found === null) return [];
        const { item, sprite } = found;
        return [
          {
            name: cantidad > 1 ? `${formatInteger(cantidad, locale)} ${item.nombre}` : item.nombre,
            sprite,
            tip: itemTipOf(item, sprite),
          },
        ];
      }),
    };
  });
  return { stages, steps };
});

// «Ataques»: the moves whose `pokemon` includes this record, by `slot` in natural order.
const slotOrder = new Intl.Collator(locale, { numeric: true });
const moves = getMoves()
  .filter((move) => move.pokemon.includes(record.id))
  .sort((a, b) => {
    if (a.slot === b.slot) return 0;
    if (a.slot === null) return 1;
    if (b.slot === null) return -1;
    return slotOrder.compare(a.slot, b.slot);
  });
// 8.0.5: a key no row has disappears, so each column but the move's name is drawn only when
// one of the moves has its value; «—» stays for a row that lacks what another row has.
const moveElements = moves.map((move) => elementEntry(move.elemento));
const moveColumns: DataTableColumn[] = [
  ...(moves.some((move) => move.slot !== null)
    ? [{ key: 'slot', label: copy.columnSlot, width: 90 }]
    : []),
  { key: 'move', label: copy.columnMove },
  ...(moves.some((move) => move.cooldownSegundos !== null)
    ? [{ key: 'cooldown', label: copy.columnCooldown, width: 160, numeric: true }]
    : []),
  ...(moveElements.some((element) => element !== null)
    ? [{ key: 'element', label: labels.element, width: 220 }]
    : []),
];
const moveRows: DataTableRow[] = moves.map((move, index) => {
  const element = moveElements[index];
  return {
    key: move.id,
    cells: {
      slot: move.slot,
      move: move.nombre,
      cooldown:
        move.cooldownSegundos === null
          ? null
          : fill(copy.cooldown, { n: figure(move.cooldownSegundos) }),
      // The element of a move is its label: a table cell opens no panel (DS:ElementChip).
      element:
        element === null
          ? null
          : createElement(ElementChip, {
              element,
              variant: 'label',
              locale,
              hint: ui.pinHint,
            }),
    },
  };
});
const abilities = (record.habilidades ?? []).filter((ability) => present(ability));

// «Dónde encontrarlo»: one `FactLine` per key of `donde` with data (R2 for its values).
/** A value of `donde`: an entity with its panel when its registry has it, text otherwise. */
function linkValue(link: EnlaceDato): FactLinePart {
  if (link.ref?.tipo === 'pokemon') {
    const entry = known(link.ref.id);
    if (entry !== null) {
      return entry.id === record.id
        ? link.texto
        : { text: link.texto, tip: tipOf(entry), href: pageHref(entry.id) };
    }
  }
  if (link.ref?.tipo === 'item') {
    const found = itemOf(link.ref.id);
    if (found !== null) return { text: link.texto, tip: itemTipOf(found.item, found.sprite) };
  }
  // Systems and activities have no reader yet (8.4, 8.9): their names are text (R2).
  return link.texto;
}

// «Hunts de {especie}»: the species is the Pokémon these hunts are for — the normal record of a
// Shiny (its id without `shiny-`, with the same `numero`), the record itself otherwise.
const normalId = record.variante === SHINY ? record.id.replace(/^shiny-/, '') : record.id;
const normalRecord = known(normalId);
const species =
  normalRecord !== null &&
  normalRecord.numero === record.numero &&
  normalRecord.variante === 'normal'
    ? normalRecord
    : record;
const speciesPart: FactLinePart =
  species.id === record.id
    ? species.nombre
    : { text: species.nombre, tip: tipOf(species), href: pageHref(species.id) };
const [huntsBefore, huntsAfter = ''] = copy.hunts.split('{species}');
const huntsLabel: FactLinePart[] = [huntsBefore, speciesPart, huntsAfter].filter(
  (part) => part !== '',
);

const where = record.donde;
const whereLines: FactLineData[] =
  where === undefined
    ? []
    : [
        { key: 'hunts', label: huntsLabel, values: where.hunts.map(linkValue) },
        { key: 'linked-tasks', label: copy.linkedTasks, values: where.linkedTasks.map(linkValue) },
        { key: 'npc', label: copy.npcTeams, values: where.equiposNpc.map(linkValue) },
      ].filter((line) => line.values.length > 0);

// The `Toc` (7.11): one entry per section the page draws, in its order.
const show = {
  drops: drops.length > 0,
  tierList: family.length > 1,
  evolution: chains.length > 0,
  moves: moves.length > 0 || abilities.length > 0,
  where: whereLines.length > 0,
};
const toc: TocItem[] = [
  show.drops && { id: 'drops', label: copy.sections.drops },
  show.tierList && { id: 'tier-list', label: copy.sections.tierList },
  show.evolution && { id: 'evolucion', label: copy.sections.evolution },
  show.moves && { id: 'ataques', label: copy.sections.moves },
  show.where && { id: 'donde', label: copy.sections.where },
].filter((item): item is TocItem => item !== false);

// 13.5: «{nombre} · Pokédex · Alliance Codex», and the description with the parts that have
// data, joined by «, »: «Nº», the elements — read as one value, as the Elementos row of the
// sheet writes them («Fuego / Volador», 8.0.5) —, the level, the tier and the role.
const elementsRow = tipRow(labels.elements)?.value;
const facts = [
  numberText,
  typeof elementsRow === 'string' ? elementsRow : null,
  record.nivel === null
    ? null
    : fill(copy.descriptionLevel, { level: formatInteger(record.nivel, locale) }),
  record.tier === null ? null : fill(copy.descriptionTier, { tier: formatTier(record.tier) }),
  record.funcion === null ? null : fill(copy.descriptionRole, { role: record.funcion }),
].filter((part): part is string => part !== null && present(part));
const description =
  facts.length > 0
    ? fill(copy.description, { name, facts: facts.join(', ') })
    : fill(copy.descriptionBare, { name });
---

<PageLayout
  locale={locale}
  title={name}
  documentTitle={`${name} · ${pokedex.label} · ${BRAND}`}
  description={description}
  alternates={alternates}
  breadcrumb={[
    { label: group.label },
    { label: pokedex.label, href: pokedex.href },
    { label: name },
  ]}
  toc={toc}
  preloadGameFont
>
  <PageTitle title={name} subtitle={numberText ?? undefined} />

  <div class="ac-detail-head">
    <div class="ac-detail-head__art">
      {
        art === null ? (
          <MissingSprite size={32} />
        ) : (
          <Sprite src={art} smooth width={140} height={140} alt="" />
        )
      }
    </div>
    <GameTooltip
      tip={sheet}
      variant="sheet"
      ariaLabel={fill(ui.sheet, { name })}
      locale={locale}
      shinyLabel={ui.shiny}
      orLabel={ui.or}
    />
    {
      frame !== null && (
        <OutfitPreview
          client:visible
          frame={frame}
          auras={auras}
          name={name}
          labels={{
            outfit: copy.outfit,
            aura: copy.aura,
            none: copy.auraNone,
            auraBall: copy.auraBall,
            frame: copy.outfitAlt,
            unavailable: copy.auraUnavailable,
          }}
        />
      )
    }
  </div>

  {
    show.drops && (
      <Section id="drops" title={copy.sections.drops}>
        <DropsList
          client:visible
          locale={locale}
          path={path}
          drops={drops}
          caption={fill(copy.dropCaption, { name })}
          labels={{
            list: listLabels,
            count: copy.dropCount,
            view: copy.dropView,
            slots: ui.cards.drops,
            sprite: copy.columnSprite,
            item: copy.columnItem,
            facts: {
              droppedBy: labels.droppedBy,
              element: labels.element,
              use: labels.use,
              quantity: labels.quantity,
              npcPrice: labels.npcPrice,
              shopPrice: labels.shopPrice,
            },
            quantityRange: copy.quantityRange,
            pokemonCount: copy.droppedByCount,
            pinHint: ui.pinHint,
          }}
        />
      </Section>
    )
  }

  {
    show.tierList && (
      <Section id="tier-list" title={copy.sections.tierList}>
        <FamilyList
          client:visible
          locale={locale}
          path={path}
          current={record.id}
          entries={familyEntries}
          elements={familyElements}
          items={familyItems}
          caption={familyCaption}
          labels={{
            list: listLabels,
            count: copy.familyCount,
            view: copy.familyView,
            slots: copy.sections.tierList,
            pokemon: copy.columnPokemon,
            tier: labels.tier,
            moveset: copy.columnMoveset,
            card: dexLabels,
            pinHint: ui.pinHint,
            shiny: ui.shiny,
            tooltip: labels,
          }}
        />
      </Section>
    )
  }

  {
    show.evolution && (
      <Section id="evolucion" title={copy.sections.evolution}>
        {chains.map((chain) => (
          <EvolutionChain
            stages={chain.stages}
            steps={chain.steps}
            labels={{ evolvesWith: copy.evolvesWith }}
            locale={locale}
            hint={ui.pinHint}
            shinyLabel={ui.shiny}
            orLabel={ui.or}
          />
        ))}
      </Section>
    )
  }

  {
    show.moves && (
      <Section id="ataques" title={copy.sections.moves}>
        {moveRows.length > 0 && (
          <DataTable
            caption={fill(copy.movesCaption, { name })}
            columns={moveColumns}
            rows={moveRows}
            locale={locale}
            scroll
          />
        )}
        {abilities.length > 0 && (
          <>
            <h3 class="ac-detail-subtitle">{copy.abilities}</h3>
            <ul class="ac-detail-chips">
              {abilities.map((ability) => (
                <li>
                  <Chip>{ability}</Chip>
                </li>
              ))}
            </ul>
          </>
        )}
      </Section>
    )
  }

  {
    show.where && (
      <Section id="donde" title={copy.sections.where}>
        <FactLines
          layout="column"
          lines={whereLines}
          locale={locale}
          hint={ui.pinHint}
          shinyLabel={ui.shiny}
          orLabel={ui.or}
        />
      </Section>
    )
  }
</PageLayout>

<style is:global>
  /* The head row of 8.3 and the abilities list of «Ataques», this page's own pieces
     (8.0.2 template C, CARD_GRID_SYSTEM §6.8). Per-page CSS (13.6): the layer order of
     global.css is repeated first, so `components` keeps its place whichever sheet the browser
     reads first (3.6). */
  @reference '../../../styles/theme.css';

  @layer properties, theme, base, components, utilities;

  @layer components {
    /* One column below md (8.3 «A 390»: the art, the sheet of 282, then the outfit and its
       Aura group in a row); from md one row of one height, which wraps where the column is
       narrower than the four panels (736 at 768 and at 1280). */
    .ac-detail-head {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-24);
    }

    @media (width >= 48rem) {
      .ac-detail-head {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: stretch;
      }
    }

    /* The art panel: 172 wide and at least as tall, `bg-secondary`, radius 12, the art of the
       registry drawn smooth at 140 in its centre (the 140 px illustration at 1x). */
    .ac-detail-head__art {
      position: relative;
      display: flex;
      width: 172px; /* sin token: panel de arte del tablero */
      min-height: 172px; /* sin token: panel de arte del tablero */
      flex: none;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-12);
      background: var(--bg-secondary);
    }

    /* Remote art (7.4.4, sprite-stage.css): while it loads the panel pulses the 32 box of the
       loading state, and art that never arrives leaves the missing mark of a 64 cell — no
       fallback initial and no empty panel (8.3). */
    .ac-detail-head__art:has(> .ac-sprite--smooth[data-state='loading'])::before,
    .ac-detail-head__art:has(> .ac-sprite--smooth[data-state='error'])::before {
      content: '';
      position: absolute;
      inset: 0;
      width: var(--size-cell);
      height: var(--size-cell);
      margin: auto;
    }

    .ac-detail-head__art:has(> .ac-sprite--smooth[data-state='loading'])::before {
      border-radius: var(--radius-4);
      background: var(--bg-quaternary);
    }

    @media (prefers-reduced-motion: no-preference) {
      .ac-detail-head__art:has(> .ac-sprite--smooth[data-state='loading'])::before {
        animation: ac-pulse var(--duration-pulse) var(--ease-pulse) infinite;
      }
    }

    .ac-detail-head__art:has(> .ac-sprite--smooth[data-state='error'])::before {
      border-radius: var(--radius-3);
      background: var(--tt-track);
      box-shadow: var(--inset-missing);
    }

    /* «Habilidades»: the h3 16/24, 24 below the table (8 of margin over the 16 of the
       Section's gap), and the chips in a wrapping row, 4 apart (the board). The plain-content
       rules of section.css (sub-headings, list markers, «li + li») key on the Section's own
       children, and Astro hands a TSX component its children inside a `display: contents`
       slot element, so these two pieces carry their rules here. */
    .ac-detail-subtitle {
      margin: var(--space-8) 0 0;
      @apply type-h3;
    }

    .ac-detail-chips {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .ac-detail-chips > li {
      margin: 0;
    }
  }
</style>
