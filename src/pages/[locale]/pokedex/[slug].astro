---
// Pokémon page (spec 8.3; design «Pokemon-pagina» and «Pokemon-pagina-movil», approved
// 2026-09-24): one prerendered HTML per record of `content/pokemon.json` and per locale. A
// slug that is not a record has no route and falls to the 404 of 8.12.
//
// Composition, in the order of the design:
//   1. the crumbs «Pokémon › Pokédex › {nombre}» (8.0.4);
//   2. the hero (`#resumen`): the art with the Normal / Shiny links (each variant is its own
//      page, so the toggle is two links and needs no script), the h1 with «Nº», the element
//      chips, the facts grid — Rol, Requisito, Tier (the chip with its «Max brokes» tooltip),
//      Generación, Tipo de moveset, and Fast / Heavy only when the game marks them — and the
//      game description; beside it, when the Pokémon has an outfit, the aura preview
//      (`OutfitPreview`, `client:visible`): one row of aura slots over the outfit;
//   3. the sticky section bar: an in-page link per section the page draws. The active link
//      follows the scroll with the small script at the end (no island);
//   4. the sections, each one only with data: Movimientos, Loot (Base / Wildscape / Primal
//      tabs, CSS only), Ubicaciones, Evoluciones, Efectividad, Habilidades de campo,
//      Variantes and the Comercio link.
// There is no rail: the section bar is the index of this page, so PageLayout gets no `toc`.
//
// Data (8.0.5, R7, X4). Everything shown comes from the registries of `content/` and from
// `public/sprites/sprites.json`. A value the registry does not have is not invented: a fact
// of the hero is «—» when its field is `null` and absent when an optional field is missing,
// and a section with nothing to show does not exist. The fields the importer fills later
// (importer_plan.md §2: `movimientos`, `dropsPorZona`, `efectividad`, `descripcion`,
// `rapido`, `pesado`, `probabilidad`) are optional: while missing, their parts are absent.
//
// Text (DP1, 13.2): the page's own copy is `messages.pokemon`; what the components and the
// tooltip builders share is `messages.ui`. Game names — Pokémon, items, moves, effects,
// zones, abilities — are written as the registry has them and carry no `lang` (13.4).
import '@/styles/components/entity-page.css';

import { getAlternatePath, getLocale, locales, type Locale } from '@/i18n/config';
import type { Messages } from '@/i18n/messages/en';
import { en } from '@/i18n/messages/en';
import { es } from '@/i18n/messages/es';
import { fill, plural } from '@/i18n/messages/types';
import { formatTier } from '@/lib/content/format';
import {
  LOOT_ZONE_NAMES,
  effectivenessRows,
  lootZonesOf,
  type EffectivenessKey,
} from '@/lib/content/item-sources';
import { resolvePokemonImage } from '@/lib/content/pokemon-media';
import {
  getAuras,
  getElementos,
  getItem,
  getOutfitForPokemon,
  getSpriteRegistry,
} from '@/lib/content/registry';
import type { Item } from '@/lib/content/registry-schema';
import { getMoves, getPokemon } from '@/lib/content/repository';
import { tierInfo } from '@/lib/content/tiers';
import type {
  EnlaceDato,
  GameText,
  MoveRecord,
  PokemonRecord,
  PokemonTier,
} from '@/lib/content/types';
import { formatDecimal, formatInteger, formatPercent } from '@/lib/format/numbers';
import { present, UNKNOWN } from '@/lib/format/unknown';
import { elementTipRecord, itemTipRecord, pokemonTipRecord } from '@/lib/game/tip-records';
import { elementTip, itemTip, pokemonTip, type TipData } from '@/lib/game/tips';
import { buildNav } from '@/lib/nav/groups';
import { spriteData, spriteOrNull, type SpriteData } from '@/lib/sprites/resolve';

import { Chip } from '@/components/content/Chip';
import { FactLines, type FactLineData, type FactLinePart } from '@/components/content/FactLine';
import { ElementChip, type ElementChipEntry } from '@/components/game/ElementChip';
import { ElementIcon } from '@/components/game/ElementIcon';
import { EntitySlot, EntitySlotFace, entitySlotClasses } from '@/components/game/EntitySlot';
import { NestedEntity } from '@/components/game/NestedEntity';
import { PokemonArt } from '@/components/game/ShinyMark';
import { Glyph } from '@/components/icons/Glyph';
import { Section } from '@/components/layout/Section';
import EvolutionChain, {
  type EvolutionStage,
  type EvolutionStep,
} from '@/components/pokemon/EvolutionChain.astro';
import { TierChip } from '@/components/pokemon/TierChip';
import { OutfitPreview, type OutfitAura } from '@/components/wiki/OutfitPreview';
import PageLayout from '@/layouts/PageLayout.astro';

export const prerender = true;

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    getPokemon().map((record) => ({
      params: { locale, slug: record.id },
      props: { record },
    })),
  );
}

/** A proper noun, the same in both locales (13.4); PageLayout and Header write the same one. */
const BRAND = 'PokeAlliance Wiki';
/** A tier content/tiers.json hides (ULTIMATE for now) reads as none: «—» (spec 16.2.1). */
const shownTier = (tier: PokemonTier | null): PokemonTier | null =>
  tierInfo(tier)?.visible === false ? null : tier;

/** 8.0.5: the `variante` of a shiny record. */
const SHINY = 'shiny';

const dictionaries: Record<Locale, Messages> = { es, en };

const locale = getLocale(Astro.params.locale);
const { ui, pokemon: copy } = dictionaries[locale];
const labels = ui.tooltip;
const record: PokemonRecord = Astro.props.record;
const name = record.nombre;

const path = Astro.url.pathname;
const alternates = Object.fromEntries(
  locales.map((option) => [option, getAlternatePath(path, option)]),
) as Record<Locale, string>;

// 8.0.4: «Pokémon › Pokédex › {nombre}». The labels are the menu's (8.0.3).
const group = buildNav(locale, path).groups.find((entry) => entry.id === 'pokemon');
const pokedex = group?.items.find((item) => item.id === 'pokedex');
if (group === undefined || pokedex === undefined) {
  throw new Error('src/lib/nav/groups.ts: no «pokedex» entry in the «pokemon» group (8.0.3).');
}

const registry = getSpriteRegistry();
const allPokemon: PokemonRecord[] = getPokemon();
const byId = new Map(allPokemon.map((entry) => [entry.id, entry]));
const pageHref = (id: string) => `/${locale}/pokedex/${id}/`;
const itemHref = (id: string) => `/${locale}/items/${id}/`;

// ------------------------------------------------------------------------------ helpers

/** A game text in the page's language, or in the other one with its `lang` (8.0.5, T22). */
function localized(value: GameText | null | undefined): { text: string; lang?: Locale } | null {
  if (!value) return null;
  const own = value[locale];
  if (own !== undefined && present(own)) return { text: own };
  const other = locales.find((option) => option !== locale && present(value[option]));
  return other === undefined ? null : { text: value[other] as string, lang: other };
}

/** A whole number as §13.3 writes it; a fractional one keeps one decimal. */
function figure(value: number): string {
  return Number.isInteger(value) ? formatInteger(value, locale) : formatDecimal(value, locale, 1);
}

/** «2–3», or the number alone when both ends are the same. */
function amount(cantidad: { min: number; max: number } | null): string {
  if (cantidad === null) return UNKNOWN;
  return cantidad.min === cantidad.max
    ? formatInteger(cantidad.min, locale)
    : `${formatInteger(cantidad.min, locale)}–${formatInteger(cantidad.max, locale)}`;
}

/** 8.0.5: `normal` before `shiny`, then `nombre`. */
const collator = new Intl.Collator(locale);
function variantOrder(a: PokemonRecord, b: PokemonRecord): number {
  const rank = (entry: PokemonRecord) =>
    entry.variante === 'normal' ? 0 : entry.variante === SHINY ? 1 : 2;
  return rank(a) - rank(b) || collator.compare(a.nombre, b.nombre);
}

// Elements (8.0.5): the records of `content/elementos.json`, keyed by id, in their order.
const elementRecords = getElementos();
const elements = new Map(elementRecords.map((element) => [element.id, element]));

/** An element as `ElementChip` takes it, with its panel (7.5.3); `null` when unknown. */
function elementEntry(id: string | null | undefined): ElementChipEntry | null {
  if (!id) return null;
  const element = elements.get(id);
  if (element === undefined) return null;
  const icon = spriteOrNull(registry, element.icono);
  return {
    id,
    name: element.nombre[locale],
    icon,
    // Every row of its panel (7.5.3): Stone, Fragment and the Balls that favour it.
    tip: elementTip(elementTipRecord(element, locale), locale, labels),
  };
}

/** The Pokémon panel of 7.5.3, every row its record has. */
const tipOf = (entry: PokemonRecord): TipData =>
  pokemonTip(pokemonTipRecord(entry), locale, labels);

/** An item of the registry with its sprite, or `null` when the id is not in it. */
function itemOf(id: string): { item: Item; sprite: SpriteData | null } | null {
  const item = getItem(id);
  return item === undefined ? null : { item, sprite: spriteOrNull(registry, item.sprite) };
}

/**
 * The item panel of 7.5.3: its game text and every fact the registries give of it, «Drop de»
 * in every zone included (src/lib/game/tip-records.ts).
 */
function itemTipOf(item: Item, sprite: SpriteData | null): TipData {
  return itemTip(itemTipRecord(item, locale, { sprite }), locale, labels);
}

/** The idle south frame of a Pokémon's outfit (R18), or `null` without one. */
function outfitFrame(id: string): SpriteData | null {
  const outfit = getOutfitForPokemon(id);
  if (outfit === undefined) return null;
  const key = `outfits/${outfit.outfitId}`;
  if (!Object.hasOwn(registry, key)) return null;
  // An outfit registered with its four directions draws its south one; one registered by
  // scripts/assets/extract-game-sprites.mjs has only that frame, as its `archivo`, or the
  // strip of the idle animation the client plays while the Pokémon stands (`animacion`).
  const entry = registry[key];
  if (entry.direcciones) return spriteData(registry, key, { direccion: 'sur' });
  return spriteData(registry, key, entry.modo === 'animacion' ? { animado: true } : {});
}

/** A Pokémon of the registry by id, or `null`: a reference that resolves to nothing is skipped. */
const known = (id: string) => byId.get(id) ?? null;

// ------------------------------------------------------------------------------ hero

const art = resolvePokemonImage(record.imagen, 140);
const isShiny = record.variante === SHINY;
const numberText =
  record.numero === null ? null : fill(ui.cards.number, { n: String(record.numero) });

// Normal / Shiny: two links when both records of the species exist with the same `numero`.
const normalId = isShiny ? record.id.replace(/^shiny-/, '') : record.id;
const normalRecord = known(normalId);
const shinyRecord = known(`shiny-${normalId}`);
const variantLinks =
  normalRecord !== null &&
  shinyRecord !== null &&
  normalRecord.variante === 'normal' &&
  shinyRecord.variante === SHINY &&
  normalRecord.numero === shinyRecord.numero
    ? [
        { label: ui.cards.normal, href: pageHref(normalRecord.id), current: !isShiny },
        { label: ui.shiny, href: pageHref(shinyRecord.id), current: isShiny },
      ]
    : null;

const heroElements = record.elementos
  .map((id) => elementEntry(id))
  .filter((entry): entry is ElementChipEntry => entry !== null);
const movesetElement =
  record.elementoMoveset === undefined ? undefined : elementEntry(record.elementoMoveset);
const traits = [
  record.rapido === true ? 'Fast' : null,
  record.pesado === true ? 'Heavy' : null,
].filter((trait): trait is string => trait !== null);
const heroDescription = localized(record.descripcion);

// The aura preview: only with an outfit in the registry.
const frame = outfitFrame(record.id);
const auras: OutfitAura[] = getAuras().map((aura) => ({
  id: aura.id,
  nombre: aura.nombre,
  shader: aura.shader,
  icon: spriteOrNull(registry, aura.icono),
}));

// ------------------------------------------------------------------------------ Movimientos

interface MoveRow {
  move: MoveRecord;
  slot: string | null;
  pve: number | null;
  pvp: number | null;
}
const moveById = new Map(getMoves().map((move) => [move.id, move]));
const slotOrder = new Intl.Collator(locale, { numeric: true });
// With `movimientos` the order and the per-Pokémon slot and cooldowns are the game's; without
// it, the moves of content/moves.json that name this record, by slot, with their one cooldown
// in the column of its `modo`.
const moveRows: MoveRow[] =
  record.movimientos !== undefined
    ? record.movimientos.flatMap((entry) => {
        const move = moveById.get(entry.movimiento);
        if (move === undefined) return [];
        // The game gives some moves another element, reach or effects on some Pokémon: the
        // entry carries them only then, over the move's own.
        const own: MoveRecord = {
          ...move,
          elemento: entry.elemento !== undefined ? entry.elemento : move.elemento,
          alcance: entry.alcance !== undefined ? entry.alcance : move.alcance,
          efectos: entry.efectos ?? move.efectos,
        };
        return [{ move: own, slot: entry.slot, pve: entry.cooldownPve, pvp: entry.cooldownPvp }];
      })
    : [...moveById.values()]
        .filter((move) => move.pokemon.includes(record.id))
        .sort((a, b) => {
          if (a.slot === b.slot) return 0;
          if (a.slot === null) return 1;
          if (b.slot === null) return -1;
          return slotOrder.compare(a.slot, b.slot);
        })
        .map((move) => ({
          move,
          slot: move.slot,
          pve: move.modo === 'PVE' ? move.cooldownSegundos : null,
          pvp: move.modo === 'PVP' ? move.cooldownSegundos : null,
        }));
// A column no row has a value for is not drawn; «—» stays for a row that lacks what another has.
const moveCols = {
  slot: moveRows.some((row) => row.slot !== null),
  element: moveRows.some((row) => elements.has(row.move.elemento ?? '')),
  range: moveRows.some((row) => row.move.alcance !== undefined && row.move.alcance !== null),
  effects: moveRows.some((row) => (row.move.efectos ?? []).length > 0),
  pve: moveRows.some((row) => row.pve !== null),
  pvp: moveRows.some((row) => row.pvp !== null),
};
const rangeLabels: Record<string, string> = {
  area: copy.range.area,
  objetivo: copy.range.objetivo,
  pasivo: copy.range.pasivo,
};
const rangeLabel = (value: string) => rangeLabels[value] ?? value;
/** A game effect id as the game writes it: «damage» → «Damage», «life-steal» → «Life Steal». */
const effectName = (id: string) =>
  id
    .split('-')
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(' ');
const cooldownText = (seconds: number | null) =>
  seconds === null ? UNKNOWN : fill(copy.cooldown, { n: figure(seconds) });
// «3 de 4 movimientos de área»: the area moves of the moveset element, over every area move.
const areaMoves = moveRows.filter((row) => row.move.alcance === 'area');
const areaLine =
  record.elementoMoveset && areaMoves.length > 0
    ? fill(copy.areaMoves, {
        n: formatInteger(
          areaMoves.filter((row) => row.move.elemento === record.elementoMoveset).length,
          locale,
        ),
        total: formatInteger(areaMoves.length, locale),
      })
    : null;

// ------------------------------------------------------------------------------ Loot

interface LootRow {
  id: string;
  name: string;
  sprite: SpriteData | null;
  tip: TipData;
  chance: number | null;
  /** The game shows «Muy Raro»: a hidden rate under 1%, with `chance` null. */
  veryRare: boolean;
  quantity: string;
}
const lootZones = lootZonesOf(record).map(({ zone, drops }) => ({
  zone,
  label: LOOT_ZONE_NAMES[zone],
  rows: drops.flatMap((drop): LootRow[] => {
    const found = itemOf(drop.item);
    if (found === null) return [];
    return [
      {
        id: found.item.id,
        name: found.item.nombre,
        sprite: found.sprite,
        tip: itemTipOf(found.item, found.sprite),
        chance: drop.probabilidad ?? null,
        veryRare: drop.muyRaro === true,
        quantity: amount(drop.cantidad),
      },
    ];
  }),
}));
const lootHasChance = lootZones.some((zone) =>
  zone.rows.some((row) => row.chance !== null || row.veryRare),
);

// ------------------------------------------------------------------------------ Ubicaciones

/** A value of `donde`: an entity with its panel when its registry has it, text otherwise. */
function linkValue(link: EnlaceDato): FactLinePart {
  if (link.ref?.tipo === 'pokemon') {
    const entry = known(link.ref.id);
    if (entry !== null) {
      return entry.id === record.id
        ? link.texto
        : { text: link.texto, tip: tipOf(entry), href: pageHref(entry.id) };
    }
  }
  if (link.ref?.tipo === 'item') {
    const found = itemOf(link.ref.id);
    if (found !== null)
      return {
        text: link.texto,
        tip: itemTipOf(found.item, found.sprite),
        href: itemHref(found.item.id),
      };
  }
  // Systems and activities have no reader here yet (8.4, 8.9): their names are text (R2).
  return link.texto;
}

// «Hunts de {especie}»: the species is the normal record of a Shiny, the record otherwise.
const species =
  normalRecord !== null &&
  normalRecord.numero === record.numero &&
  normalRecord.variante === 'normal'
    ? normalRecord
    : record;
const speciesPart: FactLinePart =
  species.id === record.id
    ? species.nombre
    : { text: species.nombre, tip: tipOf(species), href: pageHref(species.id) };
const [huntsBefore, huntsAfter = ''] = copy.hunts.split('{species}');
const huntsLabel: FactLinePart[] = [huntsBefore, speciesPart, huntsAfter].filter(
  (part) => part !== '',
);
const where = record.donde;
const whereLines: FactLineData[] =
  where === undefined
    ? []
    : [
        { key: 'hunts', label: huntsLabel, values: where.hunts.map(linkValue) },
        { key: 'linked-tasks', label: copy.linkedTasks, values: where.linkedTasks.map(linkValue) },
        { key: 'npc', label: copy.npcTeams, values: where.equiposNpc.map(linkValue) },
      ].filter((line) => line.values.length > 0);

// ------------------------------------------------------------------------------ Evoluciones

// One `EvolutionChain` per line from a first stage to a last one that goes through this
// record; a line that branches after it is drawn once per branch.
const parents = new Map<string, PokemonRecord[]>();
for (const entry of allPokemon) {
  for (const evolution of entry.evolucion ?? []) {
    const list = parents.get(evolution.a) ?? [];
    list.push(entry);
    parents.set(evolution.a, list);
  }
}
const lines: PokemonRecord[][] = [];
{
  let root = record;
  const seen = new Set<string>([root.id]);
  for (let parent = parents.get(root.id)?.[0]; parent !== undefined;) {
    if (seen.has(parent.id)) break; // content:check refuses cycles; the page never loops.
    seen.add(parent.id);
    root = parent;
    parent = parents.get(root.id)?.[0];
  }
  const walk = (line: PokemonRecord[]) => {
    const last = line[line.length - 1];
    const next = (last.evolucion ?? [])
      .map((evolution) => known(evolution.a))
      .filter((entry): entry is PokemonRecord => entry !== null && !line.includes(entry));
    if (next.length === 0) {
      if (line.includes(record) && line.length > 1) lines.push(line);
      return;
    }
    for (const entry of next) walk([...line, entry]);
  };
  walk([root]);
}

/** A level written with a template of the dictionary, or nothing when it is unknown. */
const levelText = (template: string, level: number | null) =>
  level === null ? null : fill(template, { n: formatInteger(level, locale) });

const chains = lines.map((line) => {
  // DS:EvolutionChain «No hacer»: the meta of a tile keeps the parts the other tiles have,
  // with «—» where this one misses one.
  const withLevel = line.some((entry) => entry.nivel !== null);
  const withTier = line.some((entry) => shownTier(entry.tier) !== null);
  const stages: EvolutionStage[] = line.map((entry) => {
    const parts = [
      withLevel ? (levelText(labels.level, entry.nivel) ?? UNKNOWN) : null,
      withTier ? (shownTier(entry.tier) === null ? UNKNOWN : formatTier(entry.tier)) : null,
    ].filter((part): part is string => part !== null);
    const current = entry.id === record.id;
    return {
      name: entry.nombre,
      sprite: outfitFrame(entry.id),
      meta: parts.length > 0 ? parts.join(' · ') : null,
      ...(current ? { current: true } : { href: pageHref(entry.id), tip: tipOf(entry) }),
    };
  });
  const steps: EvolutionStep[] = line.slice(0, -1).map((entry, index) => {
    const evolution = (entry.evolucion ?? []).find((item) => item.a === line[index + 1]?.id);
    return {
      requirement: levelText(copy.evolutionLevel, evolution?.nivel ?? null),
      items: (evolution?.items ?? []).flatMap(({ item: id, cantidad }) => {
        const found = itemOf(id);
        if (found === null) return [];
        const { item, sprite } = found;
        return [
          {
            name: cantidad > 1 ? `${formatInteger(cantidad, locale)} ${item.nombre}` : item.nombre,
            sprite,
            tip: itemTipOf(item, sprite),
            href: itemHref(item.id),
          },
        ];
      }),
    };
  });
  return { stages, steps };
});

// ------------------------------------------------------------------------------ Efectividad

const effectivenessLabel: Record<EffectivenessKey, string> = {
  muyDebil: copy.effectiveness.muyDebil,
  debil: copy.effectiveness.debil,
  neutro: copy.effectiveness.neutro,
  resiste: copy.effectiveness.resiste,
  muyResistente: copy.effectiveness.muyResistente,
  inmune: copy.effectiveness.inmune,
};
const effectiveness =
  record.efectividad === undefined
    ? []
    : effectivenessRows(
        record.efectividad,
        elementRecords.map((element) => element.id),
      ).map((row) => ({
        ...row,
        label: effectivenessLabel[row.key],
        multiplier: `×${figure(row.multiplier)}`,
        entries: row.elements
          .map((id) => elementEntry(id))
          .filter((entry): entry is ElementChipEntry => entry !== null),
      }));

// ------------------------------------------------------------------------------ the rest

const abilities = (record.habilidades ?? []).filter((ability) => present(ability));

// Variantes: the records with the same `numero`, normal first; only with two or more.
const variants =
  record.numero === null
    ? []
    : allPokemon.filter((entry) => entry.numero === record.numero).sort(variantOrder);

const tradeHref = `/${locale}/comercio/?pokemon=${encodeURIComponent(record.id)}`;

// The section bar: one link per section the page draws, in its order.
const show = {
  moves: moveRows.length > 0,
  loot: lootZones.some((zone) => zone.rows.length > 0),
  where: whereLines.length > 0,
  evolution: chains.length > 0,
  effectiveness: effectiveness.length > 0,
  fieldAbilities: abilities.length > 0,
  variants: variants.length > 1,
};
const sectionLinks = [
  { id: 'resumen', label: copy.sections.summary },
  show.moves && { id: 'movimientos', label: copy.sections.moves },
  show.loot && { id: 'loot', label: copy.sections.loot },
  show.where && { id: 'ubicaciones', label: copy.sections.where },
  show.evolution && { id: 'evoluciones', label: copy.sections.evolution },
  show.effectiveness && { id: 'efectividad', label: copy.sections.effectiveness },
  show.fieldAbilities && { id: 'habilidades', label: copy.sections.fieldAbilities },
  show.variants && { id: 'variantes', label: copy.sections.variants },
  { id: 'comercio', label: copy.sections.trade },
].filter((item): item is { id: string; label: string } => item !== false);
const sideColumn = show.fieldAbilities || show.variants;

// 13.5: «{nombre} · Pokédex · PokeAlliance Wiki», and the description with the parts that have
// data, joined by «, »: «Nº», the elements, the level, the tier and the role.
const facts = [
  numberText,
  heroElements.length > 0 ? heroElements.map((entry) => entry.name).join(' / ') : null,
  record.nivel === null
    ? null
    : fill(copy.descriptionLevel, { level: formatInteger(record.nivel, locale) }),
  shownTier(record.tier) === null
    ? null
    : fill(copy.descriptionTier, { tier: formatTier(record.tier) }),
  record.funcion === null ? null : fill(copy.descriptionRole, { role: record.funcion }),
].filter((part): part is string => part !== null && present(part));
const description =
  facts.length > 0
    ? fill(copy.description, { name, facts: facts.join(', ') })
    : fill(copy.descriptionBare, { name });
---

<PageLayout
  locale={locale}
  title={name}
  documentTitle={`${name} · ${pokedex.label} · ${BRAND}`}
  description={description}
  alternates={alternates}
  breadcrumb={[
    { label: group.label },
    { label: pokedex.label, href: pokedex.href },
    { label: name },
  ]}
>
  <header id="resumen" class:list={['ac-entity-hero', frame !== null && 'ac-entity-hero--aside']}>
    <div class="ac-entity-hero__media">
      <div class="ac-entity-hero__art">
        <PokemonArt src={art} size={140} shiny={isShiny} loading="eager" />
      </div>
      {
        variantLinks && (
          <nav class="ac-entity-segment" aria-label={ui.cards.variant}>
            {variantLinks.map((link) => (
              <a href={link.href} aria-current={link.current ? 'page' : undefined}>
                {link.label}
              </a>
            ))}
          </nav>
        )
      }
    </div>

    <div class="ac-entity-hero__body">
      <div class="ac-entity-hero__title">
        <h1>{name}</h1>
        {numberText && <span class="ac-entity-hero__number">{numberText}</span>}
      </div>
      {
        heroElements.length > 0 && (
          <ul class="ac-entity-hero__chips">
            {heroElements.map((element) => (
              <li>
                <ElementChip element={element} locale={locale} hint={ui.pinHint} />
              </li>
            ))}
          </ul>
        )
      }
      <dl class="ac-entity-facts">
        <div>
          <dt>{labels.role}</dt>
          <dd>{record.funcion ?? UNKNOWN}</dd>
        </div>
        <div>
          <dt>{labels.requirement}</dt>
          <dd>{levelText(labels.level, record.nivel) ?? UNKNOWN}</dd>
        </div>
        <div>
          <dt>{labels.tier}</dt>
          <dd>
            {
              shownTier(record.tier) === null ? (
                UNKNOWN
              ) : (
                <TierChip
                  tier={record.tier}
                  maxBrokesLabel={ui.filterBar.maxBrokes}
                  locale={locale}
                />
              )
            }
          </dd>
        </div>
        <div>
          <dt>{labels.generation}</dt>
          <dd>{record.generacion === null ? UNKNOWN : formatInteger(record.generacion, locale)}</dd>
        </div>
        {
          movesetElement !== undefined && (
            <div>
              <dt>{copy.movesetType}</dt>
              <dd>
                {movesetElement === null ? (
                  UNKNOWN
                ) : (
                  <ElementChip
                    element={movesetElement}
                    variant="link"
                    locale={locale}
                    hint={ui.pinHint}
                  />
                )}
              </dd>
            </div>
          )
        }
        {
          traits.length > 0 && (
            <div class="ac-entity-facts__traits">
              {traits.map((trait) => (
                <Chip>{trait}</Chip>
              ))}
            </div>
          )
        }
      </dl>
      {
        heroDescription && (
          <p class="ac-entity-hero__text" lang={heroDescription.lang}>
            {heroDescription.text}
          </p>
        )
      }
    </div>

    {
      frame !== null && (
        <div class="ac-entity-hero__aside">
          <OutfitPreview
            client:visible
            frame={frame}
            auras={auras}
            name={name}
            locale={locale}
            labels={{
              outfit: copy.outfit,
              aura: copy.aura,
              none: copy.auraNone,
              auraBall: copy.auraBall,
              frame: copy.outfitAlt,
              unavailable: copy.auraUnavailable,
            }}
          />
        </div>
      )
    }
  </header>

  {
    sectionLinks.length > 2 && (
      <nav class="ac-section-bar" aria-label={copy.sectionsNav} data-ac-section-bar>
        <ul>
          {sectionLinks.map((link, index) => (
            <li>
              <a href={`#${link.id}`} aria-current={index === 0 ? 'location' : undefined}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  {
    show.moves && (
      <Section id="movimientos" title={copy.sections.moves}>
        <div class="ac-entity-meta">
          {movesetElement && (
            <span class="ac-entity-meta__item">
              {copy.movesetType}
              <ElementChip element={movesetElement} locale={locale} hint={ui.pinHint} />
            </span>
          )}
          {areaLine && <span class="ac-entity-meta__item">{areaLine}</span>}
          <span class="ac-entity-meta__count">
            {fill(plural(locale, moveRows.length, copy.movesCount), {
              n: formatInteger(moveRows.length, locale),
            })}
          </span>
        </div>
        <div class="ac-entity-table ac-entity-table--moves">
          <table>
            <caption class="sr-only">{fill(copy.movesCaption, { name })}</caption>
            <thead>
              <tr>
                {moveCols.slot && (
                  <th scope="col" data-col="slot">
                    {copy.columnSlot}
                  </th>
                )}
                <th scope="col" data-col="move">
                  {copy.columnMove}
                </th>
                {moveCols.element && (
                  <th scope="col" data-col="element">
                    {labels.element}
                  </th>
                )}
                {moveCols.range && (
                  <th scope="col" data-col="range">
                    {copy.columnRange}
                  </th>
                )}
                {moveCols.effects && (
                  <th scope="col" data-col="effects">
                    {copy.columnEffects}
                  </th>
                )}
                {moveCols.pve && (
                  <th scope="col" data-col="pve" class="ac-num">
                    {copy.columnCooldownPve}
                  </th>
                )}
                {moveCols.pvp && (
                  <th scope="col" data-col="pvp" class="ac-num">
                    {copy.columnCooldownPvp}
                  </th>
                )}
              </tr>
            </thead>
            <tbody>
              {moveRows.map((row) => {
                const element = elementEntry(row.move.elemento);
                const icon = row.move.icono ? spriteOrNull(registry, row.move.icono) : null;
                const text = localized(row.move.descripcion);
                return (
                  <tr>
                    {moveCols.slot && <td data-col="slot">{row.slot ?? UNKNOWN}</td>}
                    <th scope="row" data-col="move">
                      <span class="ac-entity-move">
                        {icon && (
                          <span class={entitySlotClasses(32)} aria-hidden="true">
                            <EntitySlotFace sprite={icon} locale={locale} size={32} />
                          </span>
                        )}
                        <span class="ac-entity-move__text">
                          <span class="ac-entity-move__name">{row.move.nombre}</span>
                          {text && (
                            <span class="ac-entity-move__desc" lang={text.lang}>
                              {text.text}
                            </span>
                          )}
                        </span>
                      </span>
                    </th>
                    {moveCols.element && (
                      <td data-col="element">
                        {element ? (
                          <ElementIcon
                            element={element}
                            size={24}
                            locale={locale}
                            hint={ui.pinHint}
                          />
                        ) : (
                          UNKNOWN
                        )}
                      </td>
                    )}
                    {moveCols.range && (
                      <td data-col="range">
                        {row.move.alcance ? <Chip>{rangeLabel(row.move.alcance)}</Chip> : UNKNOWN}
                      </td>
                    )}
                    {moveCols.effects && (
                      <td data-col="effects">
                        {(row.move.efectos ?? []).length > 0 ? (
                          <span class="ac-entity-chips">
                            {(row.move.efectos ?? []).map((effect) => (
                              <Chip>{effectName(effect)}</Chip>
                            ))}
                          </span>
                        ) : (
                          UNKNOWN
                        )}
                      </td>
                    )}
                    {moveCols.pve && (
                      <td data-col="pve" class="ac-num" data-label={copy.columnCooldownPve}>
                        {cooldownText(row.pve)}
                      </td>
                    )}
                    {moveCols.pvp && (
                      <td data-col="pvp" class="ac-num" data-label={copy.columnCooldownPvp}>
                        {cooldownText(row.pvp)}
                      </td>
                    )}
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </Section>
    )
  }

  {
    show.loot && (
      <Section id="loot" title={copy.sections.loot}>
        <div class="ac-entity-tabs">
          {lootZones.length > 1 && (
            <fieldset class="ac-entity-tabs__list">
              <legend class="sr-only">{copy.lootZones}</legend>
              {lootZones.map((zone, index) => (
                <label>
                  <input
                    type="radio"
                    name="loot-zona"
                    value={zone.zone}
                    checked={index === 0}
                    class="sr-only"
                  />
                  {zone.label}
                  <span class="ac-entity-tabs__count">
                    {formatInteger(zone.rows.length, locale)}
                  </span>
                </label>
              ))}
            </fieldset>
          )}
          {lootZones.map((zone) => (
            <div class="ac-entity-tabs__panel" data-zone={zone.zone}>
              {zone.rows.length === 0 ? (
                <p class="ac-entity-empty">{fill(copy.lootEmpty, { zone: zone.label })}</p>
              ) : (
                <div class="ac-entity-table">
                  <table>
                    <caption class="sr-only">
                      {fill(copy.lootCaption, { name, zone: zone.label })}
                    </caption>
                    <thead>
                      <tr>
                        <th scope="col">{copy.columnItem}</th>
                        {lootHasChance && (
                          <th scope="col" class="ac-num ac-entity-table__chance">
                            {copy.columnChance}
                          </th>
                        )}
                        <th scope="col" class="ac-num">
                          {copy.columnQuantity}
                        </th>
                      </tr>
                    </thead>
                    <tbody>
                      {zone.rows.map((row) => (
                        <tr>
                          <th scope="row">
                            <span class="ac-entity-move">
                              <EntitySlot
                                size={32}
                                name={row.name}
                                sprite={row.sprite}
                                tip={row.tip}
                                href={itemHref(row.id)}
                                locale={locale}
                                hint={ui.pinHint}
                              />
                              <NestedEntity
                                tip={row.tip}
                                href={itemHref(row.id)}
                                locale={locale}
                                hint={ui.pinHint}
                              >
                                {row.name}
                              </NestedEntity>
                            </span>
                          </th>
                          {lootHasChance && (
                            <td class="ac-num ac-entity-table__chance">
                              {row.chance === null ? (
                                row.veryRare ? (
                                  <span class="ac-entity-chance">
                                    {copy.chanceVeryRare}
                                    <span class="ac-entity-chance__bar" aria-hidden="true" />
                                  </span>
                                ) : (
                                  UNKNOWN
                                )
                              ) : (
                                <span class="ac-entity-chance">
                                  {formatPercent(row.chance, locale)}
                                  <span class="ac-entity-chance__bar" aria-hidden="true">
                                    <span style={`inline-size: ${row.chance}%`} />
                                  </span>
                                </span>
                              )}
                            </td>
                          )}
                          <td class="ac-num">{row.quantity}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          ))}
        </div>
      </Section>
    )
  }

  {
    show.where && (
      <Section id="ubicaciones" title={copy.sections.where}>
        <FactLines
          layout="column"
          lines={whereLines}
          locale={locale}
          hint={ui.pinHint}
          shinyLabel={ui.shiny}
          orLabel={ui.or}
        />
      </Section>
    )
  }

  {
    show.evolution && (
      <Section id="evoluciones" title={copy.sections.evolution}>
        {chains.map((chain) => (
          <EvolutionChain
            stages={chain.stages}
            steps={chain.steps}
            labels={{ evolvesWith: copy.evolvesWith }}
            locale={locale}
            hint={ui.pinHint}
            shinyLabel={ui.shiny}
            orLabel={ui.or}
          />
        ))}
      </Section>
    )
  }

  {
    (show.effectiveness || sideColumn) && (
      <div class:list={['ac-entity-duo', show.effectiveness && sideColumn && 'ac-entity-duo--two']}>
        {show.effectiveness && (
          <Section id="efectividad" title={copy.sections.effectiveness}>
            <p class="ac-entity-note">{copy.effectivenessCaption}</p>
            <div class="ac-entity-table">
              <table>
                <caption class="sr-only">{copy.effectivenessCaption}</caption>
                <tbody>
                  {effectiveness.map((row) => (
                    <tr>
                      <th scope="row" class="ac-entity-table__label">
                        {row.label}
                        <span class="ac-entity-table__mult">{row.multiplier}</span>
                      </th>
                      <td>
                        {row.entries.length === 0 ? (
                          <span class="ac-entity-muted">{copy.effectivenessNone}</span>
                        ) : (
                          <span class="ac-entity-icons">
                            {row.entries.map((element) => (
                              <ElementIcon
                                element={element}
                                size={24}
                                locale={locale}
                                hint={ui.pinHint}
                              />
                            ))}
                          </span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </Section>
        )}
        {sideColumn && (
          <div class="ac-entity-duo__side">
            {show.fieldAbilities && (
              <Section id="habilidades" title={copy.sections.fieldAbilities}>
                <ul class="ac-entity-chips">
                  {abilities.map((ability) => (
                    <li>
                      <Chip>{ability}</Chip>
                    </li>
                  ))}
                </ul>
              </Section>
            )}
            {show.variants && (
              <Section id="variantes" title={copy.sections.variants}>
                <ul class="ac-entity-cards">
                  {variants.map((entry) => {
                    const current = entry.id === record.id;
                    const source = resolvePokemonImage(entry.imagen);
                    const tier = shownTier(entry.tier);
                    const meta = [
                      entry.variante === SHINY ? ui.shiny : ui.cards.normal,
                      levelText(labels.level, entry.nivel),
                    ]
                      .filter((part): part is string => part !== null)
                      .join(' · ');
                    return (
                      <li class="ac-entity-card">
                        <EntitySlot
                          size={56}
                          name={entry.nombre}
                          sprite={source === null ? null : { src: source, smooth: true }}
                          shiny={entry.variante === SHINY}
                          art
                          tip={tipOf(entry)}
                          href={current ? undefined : pageHref(entry.id)}
                          locale={locale}
                          hint={ui.pinHint}
                          shinyLabel={ui.shiny}
                        />
                        <span class="ac-entity-card__text">
                          {current ? (
                            <strong aria-current="page">{entry.nombre}</strong>
                          ) : (
                            <a href={pageHref(entry.id)}>{entry.nombre}</a>
                          )}
                          <span class="ac-entity-muted">{meta}</span>
                          <span class="ac-entity-muted">
                            {labels.tier}{' '}
                            {tier === null ? (
                              UNKNOWN
                            ) : (
                              <TierChip
                                tier={entry.tier}
                                maxBrokesLabel={ui.filterBar.maxBrokes}
                                locale={locale}
                              />
                            )}
                          </span>
                        </span>
                      </li>
                    );
                  })}
                </ul>
              </Section>
            )}
          </div>
        )}
      </div>
    )
  }

  <Section id="comercio" title={copy.sections.trade}>
    <a class="ac-entity-action" href={tradeHref}>
      {fill(copy.tradeLink, { name })}
      <Glyph name="arrow-right" size={16} />
    </a>
  </Section>
</PageLayout>

<script>
  // The section bar (design «Pokemon-pagina»): the link of the section at the top of the
  // viewport carries `aria-current="location"`. No island: a few lines over the printed links.
  const bar = document.querySelector<HTMLElement>('[data-ac-section-bar]');
  if (bar) {
    const links = [...bar.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const targets = links
      .map((link) => document.getElementById(link.hash.slice(1)))
      .filter((target): target is HTMLElement => target !== null);
    const list = bar.querySelector('ul');
    let active: string | undefined;
    const mark = () => {
      const edge = bar.getBoundingClientRect().bottom + 8;
      let current = targets[0];
      for (const target of targets)
        if (target.getBoundingClientRect().top <= edge) current = target;
      if (current?.id === active) return;
      active = current?.id;
      for (const link of links) {
        const on = link.hash === `#${active}`;
        if (!on) {
          link.removeAttribute('aria-current');
          continue;
        }
        link.setAttribute('aria-current', 'location');
        // On a phone the bar scrolls sideways: keep the current link in view.
        if (
          list &&
          (link.offsetLeft < list.scrollLeft ||
            link.offsetLeft + link.offsetWidth > list.scrollLeft + list.clientWidth)
        )
          list.scrollLeft = link.offsetLeft;
      }
    };
    let queued = false;
    window.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          mark();
        });
      },
      { passive: true },
    );
    mark();
  }
</script>
