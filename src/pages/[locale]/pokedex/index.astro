---
import AppLayout from '../../../layouts/AppLayout.astro';
import { ContentSearch, type SearchItem } from '../../../components/wiki/ContentSearch';
import { getFact, getRecords } from '../../../lib/content/repository';
import { getLocale, locales, type Locale } from '../../../i18n/config';

export const prerender = true;

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = getLocale(Astro.params.locale) as Locale;
const records = getRecords('pokemon');
const strings =
  locale === 'es'
    ? {
        title: 'Pokédex',
        description: 'Índice de especies y variantes con hechos revisados y evidencia enlazada.',
        eyebrow: 'Wiki Core / Pokédex',
        intro: 'Una primera capa de conocimiento navegable, basada en registros normalizados.',
        status: 'Muestra investigada',
      }
    : {
        title: 'Pokédex',
        description: 'Species and variant index with reviewed facts and linked evidence.',
        eyebrow: 'Wiki Core / Pokédex',
        intro: 'A first navigable knowledge layer built from normalized records.',
        status: 'Research sample',
      };

const items: SearchItem[] = records.map((record) => {
  const tier = getFact<string>(record, 'tier')?.value;
  const role = getFact<string>(record, 'function')?.value;
  const hp = getFact<number>(record, 'hp')?.value;
  return {
    id: record.id,
    name: record.canonicalName,
    collection: 'Pokémon',
    href: `/${locale}/pokedex/${record.canonicalSlug}/`,
    meta: [
      record.pokedexNumber ? `#${record.pokedexNumber}` : '',
      record.variant ?? '',
      tier ? `Tier ${tier}` : '',
      role ?? '',
    ]
      .filter(Boolean)
      .join(' · '),
    summary: hp ? `HP ${hp}` : '',
    status: Object.values(record.facts)[0]?.status ?? 'unknown',
  };
});
const initialQuery = Astro.url.searchParams.get('q') ?? '';
---

<AppLayout locale={locale} title={strings.title} description={strings.description}>
  <div>
    <nav
      class="wiki-breadcrumbs"
      aria-label={locale === 'es' ? 'Ruta de navegación' : 'Breadcrumb'}
    >
      <a href={`/${locale}/`}>{locale === 'es' ? 'Inicio' : 'Home'}</a>
      <span class="wiki-breadcrumb-separator">/</span>
      <span>{strings.title}</span>
    </nav>
    <header class="wiki-page-header">
      <p class="eyebrow">{strings.eyebrow}</p>
      <div class="wiki-page-header-row">
        <div>
          <h1 class="display-title">{strings.title}</h1>
          <p class="muted-copy">{strings.intro}</p>
        </div>
        <span class="wiki-section-count">{strings.status} · {items.length}</span>
      </div>
    </header>

    <section class="wiki-section" aria-label={strings.title}>
      <ContentSearch items={items} locale={locale} initialQuery={initialQuery} client:load />
    </section>
  </div>
</AppLayout>
