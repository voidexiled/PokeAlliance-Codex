---
// Pokédex (spec 8.2, `Lienzo:Pokedex`): every variant of `content/pokemon.json` in the
// `pokedex` list, in template B (8.0.2): breadcrumb, PageTitle, then the list island —
// FilterBar, results bar, the active view and the pagination — and the footer that
// PageLayout adds. Prerendered with the island of 7.7, which loads on `client:load` (7.3).
//
// Data (PR5). `buildPokedexData` of ./datos.json.ts writes the whole list in the order of
// 8.0.5; this page prints its first page and gives the island only those rows, the length of
// the list, the values its filters accept and the element chips and drops of that first
// page, panels included. The island asks for the rest, the other elements and items with it,
// when it hydrates. A prerendered page never reads its query (PR2): the state of the URL is
// the island's.
//
// Text. The h1 and the breadcrumb are the labels of the menu entry and of its group, which
// src/lib/nav/groups.ts owns (8.0.3). The description (13.5) and every text of the list —
// the filters, the count, the empty state, the captions and column headers of the Lista and
// the card texts of `DexCard` — come from `messages.pokedex` and `messages.ui` of the page's
// locale (DP1, 13.2): the island receives those two namespaces and nothing else of the
// dictionary.
import { getAlternatePath, getLocale, locales, type Locale } from '@/i18n/config';
import type { Messages } from '@/i18n/messages/en';
import { en } from '@/i18n/messages/en';
import { es } from '@/i18n/messages/es';
import { fill } from '@/i18n/messages/types';
import { formatInteger } from '@/lib/format/numbers';
import { leanTipLabels, type ListUi } from '@/lib/game/tip-labels';
import { tierInfo } from '@/lib/content/tiers';
import { buildNav } from '@/lib/nav/groups';
import { PageTitle } from '@/components/layout/PageTitle';
import { POKEDEX_PAGE_SIZE, decodePokedex, dropProp } from '@/components/pokedex/config';
import { PokedexRoot } from '@/components/pokedex/PokedexRoot';
import PageLayout from '@/layouts/PageLayout.astro';

import { buildPokedexData, pokedexDrops, pokedexElements, pokedexIds } from './datos.json.ts';

export const prerender = true;

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const dictionaries: Record<Locale, Messages> = { es, en };

const locale = getLocale(Astro.params.locale);
const path = Astro.url.pathname;
const alternates = Object.fromEntries(
  locales.map((option) => [option, getAlternatePath(path, option)]),
) as Record<Locale, string>;

// 8.0.4: «Pokémon › Pokédex». The group has no index page, so its crumb is text.
const group = buildNav(locale, path).groups.find((entry) => entry.id === 'pokemon');
const entry = group?.items.find((item) => item.id === 'pokedex');
if (group === undefined || entry === undefined) {
  throw new Error('src/lib/nav/groups.ts: no «pokedex» entry in the «pokemon» group (8.0.3).');
}
const title = entry.label;

const messages = dictionaries[locale];
const data = buildPokedexData(locale);
const records = decodePokedex(data);
const first = { v: data.v, campos: data.campos, filas: data.filas.slice(0, POKEDEX_PAGE_SIZE) };
const firstRows = decodePokedex(first);
// The drops of the first page travel without their panels: with the imported loot, twelve
// Pokémon name ten items whose panels alone would take the props past the 20 KB of §13.6. The
// island builds them with `itemTip` once `datos.json` and its deferred part are here.
const firstDrops = Object.fromEntries(
  Object.entries(
    pokedexDrops(firstRows, records, data.refs.items, locale, messages.ui.tooltip),
  ).map(([id, { name, sprite }]) => [id, dropProp({ name, sprite })]),
);
const description = fill(messages.pokedex.description, {
  n: formatInteger(records.length, locale),
});
// The list islands use no money text: `money` stays out of their props (§13.6, 20 KB). The
// labels of the panel rows `/{l}/paneles.json` completes travel with that file, not here.
const listUi = {
  ...Object.fromEntries(Object.entries(messages.ui).filter(([key]) => key !== 'money')),
  tooltip: leanTipLabels(messages.ui.tooltip),
} as ListUi<Messages['ui']>;
---

<PageLayout
  locale={locale}
  title={title}
  description={description}
  alternates={alternates}
  breadcrumb={[{ label: group.label }, { label: title }]}
>
  <PageTitle title={title} />
  <PokedexRoot
    client:load
    locale={locale}
    path={path}
    dataUrl={`/${locale}/pokedex/datos.json`}
    data={first}
    total={records.length}
    ids={pokedexIds(records, data.refs.elementos, tierInfo)}
    elements={pokedexElements(firstRows, locale, messages.ui.tooltip)}
    drops={firstDrops}
    title={title}
    ui={listUi}
    pokedex={messages.pokedex}
  />
</PageLayout>
