---
import AppLayout from '../../../layouts/AppLayout.astro';
import { getLocale, locales, type Locale } from '../../../i18n/config';
import { GuildRankingTool } from '../../../components/tools/GuildRankingTool';

export const prerender = true;

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = getLocale(Astro.params.locale) as Locale;
const copy =
  locale === 'es'
    ? {
        title: 'Ranking de guild',
        description:
          'Calcula el progreso semanal de una guild a partir del JSON exportado por el cliente.',
        home: 'Inicio',
        tools: 'Herramientas',
        eyebrow: 'Herramientas / Guild',
        intro:
          'La semana se mide desde el lunes 00:00 de Server Save BR. El valor de cada daily sigue el nivel de cada miembro y las metas de puntos, dailies y contribución pueden combinarse por día, semana o ambas.',
      }
    : {
        title: 'Guild ranking',
        description: 'Calculate weekly guild progress from the JSON exported by the client.',
        home: 'Home',
        tools: 'Tools',
        eyebrow: 'Tools / Guild',
        intro:
          'The week is measured from Monday 00:00 BR Server Save. Daily values follow each member level, while total points, dailies and contribution goals can be combined by day, week or both.',
      };
---

<AppLayout locale={locale} title={copy.title} description={copy.description}>
  <div>
    <nav
      class="wiki-breadcrumbs"
      aria-label={locale === 'es' ? 'Ruta de navegación' : 'Breadcrumb'}
    >
      <a href={`/${locale}/`}>{copy.home}</a>
      <span class="wiki-breadcrumb-separator">/</span>
      <a href={`/${locale}/herramientas/`}>{copy.tools}</a>
      <span class="wiki-breadcrumb-separator">/</span>
      <span>{copy.title}</span>
    </nav>
    <header class="wiki-page-header">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1 class="display-title">{copy.title}</h1>
      <p class="muted-copy">{copy.intro}</p>
    </header>

    <GuildRankingTool client:load locale={locale} />
  </div>
</AppLayout>
