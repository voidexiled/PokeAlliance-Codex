---
// Herramientas (spec 8.10): the index of the menu's «Herramientas» group, on template D of
// 8.0.2 with PageLayout, prerendered. The single crumb «Herramientas» / «Tools» (8.0.4, T15),
// the `PageTitle` with the same text, and the `IndexLinks` grid across the main column with
// one link per entry of the group — «Guild» and «Mapa» / «Map» —, each with its fixed sprite
// key of 3.13 at 1x in the 32 cell. No description, state, count or roadmap under a link
// (TI-01 to TI-10, HT1): the search is not a tool, and «Comparar Pokémon» lives in the Pokémon
// group (8.0.3, §11). PageLayout adds the footer, the 208 spacer and the frame. Nothing here
// varies with the data, so there is no empty or loading state.
//
// Data. The links are the entries of the menu group (src/lib/nav/groups.ts, 8.0.3) whose route
// the build writes (WG5), with their labels and in the menu's order, so the index and the menu
// never list different tools. The sprites go through the adapter (DP2): `ui/herramientas/guild`
// and `ui/herramientas/mapa` answer `null` — the cell stays empty — until the owner adds them
// to the registry (D-011).
//
// Text (13.2): the h1, the crumb and the description of 13.5 are `messages.tools`. No link opens
// a panel: a tool is not an entity of the game (R2).
//
// Styles: `IndexLinks` brings its per-page sheet (index-links.css); the page adds none.
import { getAlternatePath, getLocale, locales, type Locale } from '@/i18n/config';
import type { Messages } from '@/i18n/messages/en';
import { en } from '@/i18n/messages/en';
import { es } from '@/i18n/messages/es';
import { getSpriteRegistry } from '@/lib/content/registry';
import { buildNav } from '@/lib/nav/groups';
import { spriteOrNull } from '@/lib/sprites/resolve';

import { IndexLinks, type IndexLinkEntry } from '@/components/home/IndexLinks';
import { PageTitle } from '@/components/layout/PageTitle';
import PageLayout from '@/layouts/PageLayout.astro';

export const prerender = true;

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

/** 8.10, 3.13: the fixed sprite key of each entry of the group, by its menu id. */
const TOOL_SPRITES: Readonly<Record<string, string>> = {
  guild: 'ui/herramientas/guild',
  mapa: 'ui/herramientas/mapa',
};

const dictionaries: Record<Locale, Messages> = { es, en };

const locale = getLocale(Astro.params.locale);
const path = Astro.url.pathname;
const alternates = Object.fromEntries(
  locales.map((option) => [option, getAlternatePath(path, option)]),
) as Record<Locale, string>;

const { tools } = dictionaries[locale];
const title = tools.title;

const group = buildNav(locale, path).groups.find((entry) => entry.id === 'herramientas');
if (group === undefined) {
  throw new Error('src/lib/nav/groups.ts: no «herramientas» group with a link (8.0.3).');
}
const registry = getSpriteRegistry();

const links: IndexLinkEntry[] = group.items.map((item) => ({
  id: item.id,
  label: item.label,
  href: item.href,
  sprite: spriteOrNull(registry, TOOL_SPRITES[item.id]),
}));
---

<PageLayout
  locale={locale}
  title={title}
  description={tools.description}
  alternates={alternates}
  breadcrumb={[{ label: title }]}
>
  <PageTitle title={title} />
  <IndexLinks links={links} locale={locale} />
</PageLayout>
