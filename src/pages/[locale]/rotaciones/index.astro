---
import AppLayout from '../../../layouts/AppLayout.astro';
import DataStatus from '../../../components/wiki/DataStatus.astro';
import EvidenceTrail from '../../../components/wiki/EvidenceTrail.astro';
import {
  formatFactValue,
  getFact,
  getRecordEvidence,
  getRecords,
} from '../../../lib/content/repository';
import { getLocale, locales, type Locale } from '../../../i18n/config';

export const prerender = true;

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = getLocale(Astro.params.locale) as Locale;
const records = getRecords('rotations');
const copy =
  locale === 'es'
    ? {
        title: 'Rotaciones y tiers',
        description: 'Afirmaciones de disponibilidad y rareza con contexto y procedencia.',
        eyebrow: 'Wiki Core / Rotaciones',
        intro:
          'Las categorías del juego se muestran como afirmaciones de guía, no como hechos universales del canon Pokémon.',
        assertion: 'Afirmación actual',
        context: 'Contexto',
        comparison: 'Conjunto comparado',
        evidence: 'evidencias',
      }
    : {
        title: 'Rotations & tiers',
        description: 'Availability and rarity assertions with context and provenance.',
        eyebrow: 'Wiki Core / Rotations',
        intro:
          'Game categories are presented as guide assertions, not universal Pokémon canon facts.',
        assertion: 'Current assertion',
        context: 'Context',
        comparison: 'Compared set',
        evidence: 'evidence items',
      };
const views = records.map((record) => ({
  record,
  assertionKind: getFact<string>(record, 'assertionKind')?.value,
  value: getFact<string>(record, 'value')?.value,
  context: getFact<unknown>(record, 'context')?.value,
  comparison: getFact<unknown>(record, 'comparisonSet')?.value,
  evidence: getRecordEvidence(record),
}));
---

<AppLayout locale={locale} title={copy.title} description={copy.description}>
  <div>
    <nav
      class="wiki-breadcrumbs"
      aria-label={locale === 'es' ? 'Ruta de navegación' : 'Breadcrumb'}
    >
      <a href={`/${locale}/`}>{locale === 'es' ? 'Inicio' : 'Home'}</a>
      <span class="wiki-breadcrumb-separator">/</span>
      <span>{copy.title}</span>
    </nav>
    <header class="wiki-page-header">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1 class="display-title">{copy.title}</h1>
      <p class="muted-copy">{copy.intro}</p>
    </header>

    <div class="wiki-section grid gap-5">
      {
        views.map(({ record, assertionKind, value, context, comparison, evidence }) => (
          <article id={record.canonicalSlug} class="wiki-panel wiki-article-panel p-5 sm:p-6">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <p class="eyebrow">{assertionKind ?? 'assertion'}</p>
                <h2 class="mt-2 text-2xl font-semibold tracking-tight">{record.canonicalName}</h2>
              </div>
              <DataStatus
                status={Object.values(record.facts)[0]?.status ?? 'unknown'}
                locale={locale}
              />
            </div>
            <div class="mt-6 grid gap-5 lg:grid-cols-[1.3fr_0.7fr]">
              <div>
                <p class="eyebrow">{copy.assertion}</p>
                <p class="mt-2 text-lg leading-8 text-foreground/90">{value ?? '—'}</p>
              </div>
              <div class="grid gap-5">
                <div>
                  <p class="eyebrow">{copy.context}</p>
                  <p class="mt-2 text-sm leading-6 text-foreground/80">
                    {formatFactValue(context)}
                  </p>
                </div>
                <div>
                  <p class="eyebrow">{copy.comparison}</p>
                  <p class="mt-2 text-sm leading-6 text-foreground/80">
                    {formatFactValue(comparison)}
                  </p>
                </div>
              </div>
            </div>
            <p class="mt-6 font-mono text-[0.65rem] uppercase tracking-[0.13em] text-muted-foreground">
              {evidence.length} {copy.evidence}
            </p>
            <EvidenceTrail records={evidence} locale={locale} />
          </article>
        ))
      }
    </div>
  </div>
</AppLayout>
