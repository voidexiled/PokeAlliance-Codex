---
// Cambios (spec 8.7): the changes of content/cambios.json, newest first, one `Section` per
// month. Template C of 8.0.2 on PageLayout, prerendered: the crumbs «Comunidad › Cambios» —
// «Comunidad» has no index, so its crumb is text (8.0.4) —, the `PageTitle`, the sections and
// the footer PageLayout adds. The page is in the menu (group Comunidad) and indexable (A2).
//
// Composition (8.7):
//   - one `Section` per month that has changes, the most recent first, with the id `AAAA-MM`
//     and titled with the month and year of `Intl.DateTimeFormat` (`month: 'long', year:
//     'numeric'`), first letter capitalised: «Septiembre de 2026» / «September 2026»;
//   - inside, `ChangeTimeline`: one step per change, by `fecha` descending and then by `id`;
//   - the `Toc` of the months: PageLayout draws it as the rail with two months or more (CA1)
//     and keeps the 944 column and its spacer with one;
//   - without a change, the one line of `EmptyState` under the title and no `Toc` (CA2). There
//     is no loading state.
// No change links out of the site or says where it comes from (R6): the shape of a record
// (3.13) has no field for either.
//
// Data (8.0.5, R7, X4). `getCambios` gives the records in the order of 8.7 and without the
// drafts of a build with OCULTAR_BORRADORES=1 — the page never marks one — and
// `groupCambiosByMonth` cuts them into months; the Zod mirror has already refused a `fecha` that
// is not a day of the calendar. Each step's node is the change's `sprite`, or the fixed key
// `ui/cambios` (3.13); both go through the adapter (DP2), which answers `null` for the fixed key
// while the registry lacks it and fails the build for any other unknown key (7.4.1). Each
// entity of `entidades` is resolved from its registry as the other pages resolve their mentions
// (8.0.5, 7.5.3): a Pokémon with `pokemonTip` and its page, an item with `itemTip` and no page
// (§15), a system with `systemTip` and its page, and an activity, which has no panel, as its
// name alone (R2, 8.9). `pnpm content:check` refuses an entity with no record; one that only a
// hidden draft has — a build with OCULTAR_BORRADORES=1 — is its name as text, the way the system
// pages show it (D-020). An entity with no record at all stops the build here too.
//
// Text (DP1, 13.2). The h1, the description of 13.5, the empty line and the label of a step are
// `messages.changes`; the crumb of the group is the label of the menu's «Comunidad» group, which
// src/lib/nav/groups.ts owns (8.0.3); the three strings of the panels are `messages.ui`. Every
// text of a record exists in both languages (`Texto`), so the page marks none with `lang`, and
// the names of the game carry none (13.4).
//
// Styles: PageTitle, Section, Timeline, Chip and EmptyState are components of the shared sheet;
// the page adds no stylesheet and no island.
import { getAlternatePath, getLocale, locales, type Locale } from '@/i18n/config';
import type { Messages } from '@/i18n/messages/en';
import { en } from '@/i18n/messages/en';
import { es } from '@/i18n/messages/es';
import {
  getCambios,
  getCategorias,
  getElementos,
  getItem,
  getItemIncluidoBorrador,
  getSistema,
  getSistemaIncluidoBorrador,
  getSpriteRegistry,
  groupCambiosByMonth,
} from '@/lib/content/registry';
import type { Cambio, Item } from '@/lib/content/registry-schema';
import { getPokemon, getQuests } from '@/lib/content/repository';
import type { ContentRef, PokemonRecord } from '@/lib/content/types';
import { itemTip, pokemonTip, systemTip, type TipData } from '@/lib/game/tips';
import { buildNav } from '@/lib/nav/groups';
import { spriteOrNull } from '@/lib/sprites/resolve';

import ChangeTimeline, {
  type ChangeEntity,
  type ChangeEntry,
  type ChangeTimelineLabels,
} from '@/components/changes/ChangeTimeline.astro';
import { EmptyState } from '@/components/content/EmptyState';
import { PageTitle } from '@/components/layout/PageTitle';
import { Section } from '@/components/layout/Section';
import type { TocItem } from '@/components/layout/Toc.astro';
import { pokedexOrder } from '@/components/pokedex/config';
import PageLayout from '@/layouts/PageLayout.astro';

export const prerender = true;

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

/** The `changes` keys this page reads (13.2). */
interface ChangesCopy {
  /** The h1, the current crumb and the document title. */
  title: string;
  /** `<meta name="description">` of 13.5. */
  description: string;
  /** The `EmptyState` of 8.7 without changes. */
  empty: string;
  /** The label of a step: `{date}` with its colon (T33). */
  dateLabel: string;
}

/** 3.13: the node of a change without a `sprite` of its own. */
const CHANGE_SPRITE = 'ui/cambios';

const dictionaries: Record<Locale, Messages> = { es, en };

const locale = getLocale(Astro.params.locale);
const path = Astro.url.pathname;
const alternates = Object.fromEntries(
  locales.map((option) => [option, getAlternatePath(path, option)]),
) as Record<Locale, string>;

const messages = dictionaries[locale];
const { ui } = messages;
const copy: ChangesCopy = messages.changes;

const title = copy.title;

// 8.0.4: «Comunidad › Cambios». The group has no index page, so its crumb is text.
const group = buildNav(locale, path).groups.find((entry) => entry.id === 'comunidad');
if (group === undefined) {
  throw new Error('src/lib/nav/groups.ts: no «comunidad» group with a link (8.0.3).');
}

const registry = getSpriteRegistry();

// 8.7 step 3: the month and year of `Intl` in the page's language, first letter capitalised.
// The first day of the month at midnight UTC is that month in every zone.
const monthFormat = new Intl.DateTimeFormat(locale, {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

function monthTitle(id: string): string {
  const text = monthFormat.format(new Date(`${id}-01T00:00:00Z`));
  return text.charAt(0).toLocaleUpperCase(locale) + text.slice(1);
}

// ------------------------------------------------------------------------------ entities
// What `entidades` names, resolved once per page and only when a change names it.

const elements = new Map(getElementos().map((element) => [element.id, element]));
const pokemonById = new Map(getPokemon().map((record) => [record.id, record]));
const questsById = new Map(getQuests().map((quest) => [quest.id, quest]));
const categoryNames = new Map(getCategorias().map((category) => [category.id, category.nombre]));

/** The Pokémon panel of 7.5.3, with the names of its elements (8.0.5). */
function pokemonTipOf(record: PokemonRecord): TipData {
  const names = record.elementos.flatMap((id) => {
    const element = elements.get(id);
    return element === undefined ? [] : [{ nombre: element.nombre }];
  });
  return pokemonTip({ ...record, elementos: names }, locale, ui.tooltip);
}

// «Drop de» of an item (7.5.3): the Pokémon whose `drops` name it, each once, in the order of
// 8.0.5 — the inverse of the field over every Pokémon, as on the item lists.
let droppers: Map<string, PokemonRecord[]> | null = null;
function droppedBy(item: string): string[] {
  if (droppers === null) {
    droppers = new Map();
    for (const record of [...getPokemon()].sort(pokedexOrder(locale))) {
      for (const drop of record.drops ?? []) {
        const list = droppers.get(drop.item) ?? [];
        if (!list.includes(record)) list.push(record);
        droppers.set(drop.item, list);
      }
    }
  }
  return (droppers.get(item) ?? []).map((record) => record.nombre);
}

/** The item panel of 7.5.3. */
function itemTipOf(item: Item): TipData {
  return itemTip(
    {
      id: item.id,
      nombre: item.nombre,
      categoria: item.categoria,
      sprite: spriteOrNull(registry, item.sprite),
      precioNpc: item.precioNpc,
      nombreCategoria: categoryNames.get(item.categoria) ?? null,
      dropDe: droppedBy(item.id),
      nombreElemento: item.elemento ? (elements.get(item.elemento)?.nombre ?? null) : null,
      uso: item.uso ?? null,
    },
    locale,
    ui.tooltip,
  );
}

/** An entity of `entidades` (3.13) as its chip draws it, or `null` when content/ lacks it. */
function resolve(ref: ContentRef): ChangeEntity | null {
  switch (ref.tipo) {
    case 'pokemon': {
      const record = pokemonById.get(ref.id);
      return record === undefined
        ? null
        : {
            text: record.nombre,
            tip: pokemonTipOf(record),
            href: `/${locale}/pokedex/${record.id}/`,
          };
    }
    case 'item': {
      const item = getItem(ref.id);
      if (item !== undefined) return { text: item.nombre, tip: itemTipOf(item) };
      // A draft this build hides: its name as text (D-020).
      const hidden = getItemIncluidoBorrador(ref.id);
      return hidden === undefined ? null : { text: hidden.nombre, tip: null };
    }
    case 'sistema': {
      const system = getSistema(ref.id);
      if (system !== undefined) {
        const tip = systemTip(
          {
            id: system.id,
            titulo: system.titulo,
            sprite: spriteOrNull(registry, system.sprite),
            tooltip: system.tooltip,
          },
          locale,
        );
        return { text: system.titulo[locale], tip, href: `/${locale}/sistemas/${system.id}/` };
      }
      const hidden = getSistemaIncluidoBorrador(ref.id);
      return hidden === undefined ? null : { text: hidden.titulo[locale], tip: null };
    }
    case 'actividad': {
      // An activity has no panel (8.9): its name is text (R2).
      const quest = questsById.get(ref.id);
      return quest === undefined ? null : { text: quest.nombre, tip: null };
    }
  }
}

const entities = new Map<string, ChangeEntity>();
function entity(ref: ContentRef, change: Cambio): ChangeEntity {
  const key = `${ref.tipo}:${ref.id}`;
  const known = entities.get(key) ?? resolve(ref);
  if (known === null) {
    throw new Error(
      `content/cambios.json: el cambio «${change.id}» nombra ${key}, que no tiene registro en ` +
        'content/ (8.7).',
    );
  }
  entities.set(key, known);
  return known;
}

// ------------------------------------------------------------------------------ page

/** One change in the page's language, ready for its step (8.7 step 4). */
function entryOf(change: Cambio): ChangeEntry {
  return {
    id: change.id,
    date: change.fecha,
    title: change.titulo[locale],
    points: change.puntos?.[locale] ?? [],
    sprite: spriteOrNull(registry, change.sprite ?? CHANGE_SPRITE),
    entities: (change.entidades ?? []).map((ref) => entity(ref, change)),
  };
}

// 8.7 steps 3 and 4: the months, the most recent first, each with its changes in order.
const months = groupCambiosByMonth(getCambios()).map((month) => ({
  id: month.id,
  title: monthTitle(month.id),
  entries: month.cambios.map(entryOf),
}));

// 7.11: the Toc lists the sections with the same ids, titles and order.
const toc: TocItem[] = months.map((month) => ({ id: month.id, label: month.title }));

const labels: ChangeTimelineLabels = {
  dateLabel: copy.dateLabel,
  pinHint: ui.pinHint,
  shiny: ui.shiny,
  or: ui.or,
};
---

<PageLayout
  locale={locale}
  title={title}
  description={copy.description}
  alternates={alternates}
  breadcrumb={[{ label: group.label }, { label: title }]}
  toc={toc}
>
  <PageTitle title={title} />
  {
    months.length > 0 ? (
      months.map((month) => (
        <Section id={month.id} title={month.title}>
          <ChangeTimeline entries={month.entries} locale={locale} labels={labels} />
        </Section>
      ))
    ) : (
      <EmptyState>{copy.empty}</EmptyState>
    )
  }
</PageLayout>
