---
// Systems index (spec 8.4.1): template D of 8.0.2 on PageLayout, prerendered. The single
// crumb «Sistemas» / «Systems» (8.0.4, T15), the `PageTitle` with the same text, and the
// `IndexLinks` grid across the main column with one link per system page of
// `content/sistemas/`, in the order of the registry: its sprite at 1x in the 32 cell and, when
// the record has tooltip rows, its panel above the link, anchored to its left edge
// (`systemTip`, DS:IndexPanel). No description, state or count under a link. With no system
// published the grid gives way to the one line of `EmptyState`; there is no loading state.
// PageLayout adds the footer, the 208 spacer and the frame.
//
// Data (8.0.5, R7, X4). Every entry comes from `content/sistemas/<id>.json` through
// `getSistemas`, which already orders the records by `orden` and leaves out the drafts under
// OCULTAR_BORRADORES=1 (SI4); the page never marks one as a draft. `titulo` is a `Texto` with
// both locales (§3.13), so the name of a link is the page's own. Sprites go through the adapter
// (DP2): a key the registry does not have fails the build, `null` leaves the cell empty. The
// record holds only the tooltip rows it knows (`[]` while it has none); `systemTip` still drops
// a value that reads as empty (X13), and the panel exists only when a row is left (R2).
//
// Text (DP1, 13.2). The h1, the crumb, the description of 13.5 and the empty line are
// `messages.systems`; the strip of the panels is `ui.pinHint`. What the index showed before
// this template — the label above the title, the intro, the system items and the moves — is
// gone (Y-01 to Y-11): the items live on the page of their system and the moves in «Ataques»
// of the Pokémon page.
//
// Styles. `IndexLinks` brings its own per-page sheet (index-links.css); the page adds none.
import { getAlternatePath, getLocale, locales, type Locale } from '@/i18n/config';
import type { Messages } from '@/i18n/messages/en';
import { en } from '@/i18n/messages/en';
import { es } from '@/i18n/messages/es';
import { getSistemas, getSpriteRegistry } from '@/lib/content/registry';
import { systemTip } from '@/lib/game/tips';
import { spriteOrNull } from '@/lib/sprites/resolve';

import { EmptyState } from '@/components/content/EmptyState';
import { IndexLinks, type IndexLinkEntry } from '@/components/home/IndexLinks';
import { PageTitle } from '@/components/layout/PageTitle';
import PageLayout from '@/layouts/PageLayout.astro';

export const prerender = true;

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const dictionaries: Record<Locale, Messages> = { es, en };

const locale = getLocale(Astro.params.locale);
const path = Astro.url.pathname;
const alternates = Object.fromEntries(
  locales.map((option) => [option, getAlternatePath(path, option)]),
) as Record<Locale, string>;

const messages = dictionaries[locale];
const title = messages.systems.title;
const registry = getSpriteRegistry();

const links: IndexLinkEntry[] = getSistemas().map((system) => {
  const sprite = spriteOrNull(registry, system.sprite);
  const tip = systemTip(
    { id: system.id, titulo: system.titulo, sprite, tooltip: system.tooltip },
    locale,
  );
  return {
    id: system.id,
    label: system.titulo[locale],
    href: `/${locale}/sistemas/${system.id}/`,
    sprite,
    ...(tip.rows.length > 0 ? { tip } : {}),
  };
});
---

<PageLayout
  locale={locale}
  title={title}
  description={messages.systems.description}
  alternates={alternates}
  breadcrumb={[{ label: title }]}
>
  <PageTitle title={title} />
  {
    links.length > 0 ? (
      <IndexLinks links={links} locale={locale} hint={messages.ui.pinHint} />
    ) : (
      <EmptyState>{messages.systems.empty}</EmptyState>
    )
  }
</PageLayout>
