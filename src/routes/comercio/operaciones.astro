---
// «Mis operaciones» (spec 9.10 with 9.15.4; template H of 8.0.2): `/{l}/comercio/operaciones/`,
// the account's purchases and sales. `noindex` (9.3, 13.5).
//
// Route (9.3): it does not live in src/pages/. src/integrations/comercio-fases.ts injects it as
// `/[locale]/comercio/operaciones` only with COMERCIO_PUBLICO, with `prerender: true` (a file
// outside src/pages/ cannot export `prerender`; the injection sets it), one HTML per locale from
// `getStaticPaths`: without the switch it does not exist and answers 404 (S11, CA-9.13). The
// frame is static; the deals are the account's and arrive in the island once the session is
// known (src/lib/supabase/client.ts keeps it in the browser).
//
// Composition: the crumbs «Comunidad › Comercio › Operaciones» (8.0.4), `PageTitle` and the island
// (`OperationsPanel`) with «Compras» / «Ventas», the table and the dialogs of each action and of
// the review (ReviewForm.tsx). Without a session the island says so and links «Ir a mi cuenta»
// when the build has the account page (`getSupabasePublicConfig()`, 9.3). Like every Comercio
// route it opens with the 18+ gate (`AgeGate`, 9.15.2), a closed dialog until its island decides.
//
// Data (13.2): the island gets `trade.operations`, `trade.review`, `trade.channels` (the labels
// of the revealed contact values, 9.9) and the two leaves of `ui` it reads; the gate gets
// `trade.adultsOnly` and `trade.ageGate`. No registry travels
// in the props: the titles of the listings read their names from the search index, loaded only
// when a row needs it (OperationsPanel.tsx).
import { getAlternatePath, getLocale, locales, type Locale } from '@/i18n/config';
import type { Messages } from '@/i18n/messages/en';
import { en } from '@/i18n/messages/en';
import { es } from '@/i18n/messages/es';
import { buildNav } from '@/lib/nav/groups';
import { getSupabasePublicConfig } from '@/lib/supabase/env';

import { PageTitle } from '@/components/layout/PageTitle';
import { AgeGate } from '@/components/trade/AgeGate';
import { OperationsPanel } from '@/components/trade/OperationsPanel';
import PageLayout from '@/layouts/PageLayout.astro';

import '@/styles/components/trade-operations.css';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const dictionaries: Record<Locale, Messages> = { es, en };

const locale = getLocale(Astro.params.locale);
const path = Astro.url.pathname;
const alternates = Object.fromEntries(
  locales.map((option) => [option, getAlternatePath(path, option)]),
) as Record<Locale, string>;
const { trade, ui } = dictionaries[locale];

// 8.0.4: «Comunidad › Comercio › Operaciones».
const group = buildNav(locale, path).groups.find((entry) => entry.id === 'comunidad');
const comercio = group?.items.find((item) => item.id === 'comercio');
if (group === undefined || comercio === undefined) {
  throw new Error('src/lib/nav/groups.ts: no «comercio» entry in the «comunidad» group (8.0.3).');
}

const accountHref = getSupabasePublicConfig() === null ? null : `/${locale}/cuenta/`;
---

<PageLayout
  locale={locale}
  title={trade.operations.title}
  description={trade.operations.description}
  alternates={alternates}
  breadcrumb={[
    { label: group.label },
    { label: comercio.label, href: comercio.href },
    { label: trade.operations.title },
  ]}
  noindex
>
  <PageTitle title={trade.operations.title} />
  <OperationsPanel
    client:load
    locale={locale}
    messages={trade.operations}
    review={trade.review}
    channels={trade.channels}
    ui={{ close: ui.close, dismiss: ui.dismiss }}
    accountHref={accountHref}
  />
  {/* 9.15.2: the 18+ gate, a closed dialog until the island decides. */}
  <AgeGate
    client:load
    locale={locale}
    labels={{ title: trade.adultsOnly, adult: trade.ageGate.adult, minor: trade.ageGate.minor }}
    closeLabel={ui.close}
  />
</PageLayout>
