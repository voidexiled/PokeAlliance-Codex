---
import '../styles/global.css';
import {
  getAlternateLocale,
  getLocale,
  localeCopy,
  localeLabels,
  type Locale,
} from '../i18n/config';
import { WikiSearch } from '../components/wiki/WikiSearch';
import {
  BookOpenIcon,
  FileClockIcon,
  GlobeIcon,
  HomeIcon,
  MapIcon,
  SearchIcon,
  ShieldCheckIcon,
  SparklesIcon,
  SwordsIcon,
  WrenchIcon,
} from 'lucide-react';

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
}

const {
  locale = getLocale(Astro.params.locale),
  title = 'Alliance Codex',
  description = 'Wiki comunitaria de PokeAlliance.',
} = Astro.props;
const copy = localeCopy[locale];
const alternateLocale = getAlternateLocale(locale);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const searchQuery = Astro.url.searchParams.get('q') ?? '';
const isHome = currentPath === `/${locale}`;
const navigation = {
  explore: [
    { key: 'home', label: copy.home, href: `/${locale}/`, icon: HomeIcon },
    { key: 'pokedex', label: copy.pokedex, href: `/${locale}/pokedex/`, icon: BookOpenIcon },
    { key: 'guides', label: copy.guides, href: `/${locale}/guias/`, icon: SparklesIcon },
    { key: 'systems', label: copy.systems, href: `/${locale}/sistemas/`, icon: ShieldCheckIcon },
    { key: 'rotations', label: copy.rotations, href: `/${locale}/rotaciones/`, icon: SwordsIcon },
    { key: 'sources', label: copy.sources, href: `/${locale}/fuentes/`, icon: FileClockIcon },
  ],
  tools: [
    { key: 'tools', label: copy.tools, href: `/${locale}/herramientas/`, icon: WrenchIcon },
    { key: 'map', label: copy.map, href: `/${locale}/mapa/`, icon: MapIcon },
    { key: 'search', label: copy.search, href: `/${locale}/buscar/`, icon: SearchIcon },
  ],
  community: [
    { key: 'changes', label: copy.changes, href: `/${locale}/cambios/`, icon: FileClockIcon },
  ],
} as const;
const allNavigation = [...navigation.explore, ...navigation.tools, ...navigation.community];
const isActive = (href: string, key: string) => {
  const normalizedHref = href.replace(/\/$/, '');
  if (key === 'home') return currentPath === normalizedHref;
  return currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0d0f12" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang={alternateLocale} href={`/${alternateLocale}/`} />
    <link rel="alternate" hreflang={locale} href={`/${locale}/`} />
    <title>{title} · Alliance Codex</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.skipToContent}</a>
    <div class:list={['wiki-shell', isHome && 'wiki-shell-home']}>
      <header class="wiki-topbar">
        <div class:list={['wiki-topbar-inner', isHome && 'wiki-topbar-inner-home']}>
          <a
            class="wiki-brand"
            href={`/${locale}/`}
            aria-label={locale === 'es' ? 'Alliance Codex, inicio' : 'Alliance Codex, home'}
          >
            <span class="wiki-brand-mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path
                  d="M12 3.5 19 7.3v8.4L12 19.5l-7-3.8V7.3l7-3.8Z"
                  stroke="currentColor"
                  stroke-width="1.7"></path>
                <path
                  d="m8.5 12 2.2 2.2 4.8-5"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
            <span>
              <span class="wiki-brand-name">Alliance Codex</span>
              <span class="wiki-brand-subtitle">PokeAlliance wiki</span>
            </span>
          </a>

          {
            !isHome && (
              <div class="wiki-search">
                <WikiSearch
                  action={`/${locale}/buscar/`}
                  label={copy.search}
                  placeholder={
                    locale === 'es' ? 'Buscar en Alliance Codex…' : 'Search Alliance Codex…'
                  }
                  initialValue={searchQuery}
                />
              </div>
            )
          }

          <div class="wiki-topbar-actions">
            <span class="wiki-status-mark" title={copy.status} aria-label={copy.status}>
              <span class="status-dot" aria-hidden="true"></span>
            </span>
            <a class="locale-link" href={`/${alternateLocale}/`} hreflang={alternateLocale}>
              <GlobeIcon aria-hidden="true" />
              {localeLabels[alternateLocale]}
            </a>
          </div>
        </div>
      </header>

      <div class="wiki-layout">
        <aside class="wiki-sidebar" aria-label={copy.navLabel}>
          <nav>
            <div class="wiki-sidebar-group">
              <p class="wiki-sidebar-heading">{copy.explore}</p>
              <div class="wiki-sidebar-links">
                {
                  navigation.explore.map((item) => (
                    <a
                      class="wiki-sidebar-link"
                      href={item.href}
                      aria-current={isActive(item.href, item.key) ? 'page' : undefined}
                    >
                      <item.icon className="wiki-sidebar-icon" aria-hidden="true" />
                      {item.label}
                    </a>
                  ))
                }
              </div>
            </div>
            <div class="wiki-sidebar-group">
              <p class="wiki-sidebar-heading">{copy.tools}</p>
              <div class="wiki-sidebar-links">
                {
                  navigation.tools.map((item) => (
                    <a
                      class="wiki-sidebar-link"
                      href={item.href}
                      aria-current={isActive(item.href, item.key) ? 'page' : undefined}
                    >
                      <item.icon className="wiki-sidebar-icon" aria-hidden="true" />
                      {item.label}
                    </a>
                  ))
                }
              </div>
            </div>
            <div class="wiki-sidebar-group">
              <p class="wiki-sidebar-heading">{copy.community}</p>
              <div class="wiki-sidebar-links">
                {
                  navigation.community.map((item) => (
                    <a
                      class="wiki-sidebar-link"
                      href={item.href}
                      aria-current={isActive(item.href, item.key) ? 'page' : undefined}
                    >
                      <item.icon className="wiki-sidebar-icon" aria-hidden="true" />
                      {item.label}
                    </a>
                  ))
                }
              </div>
            </div>
          </nav>
          <div class="wiki-sidebar-note">
            <span class="wiki-sidebar-note-label">{locale === 'es' ? 'Servidor' : 'Server'}</span>
            <span>Server Save · 00:00 BR</span>
          </div>
        </aside>

        <details class="wiki-mobile-nav">
          <summary>{copy.navLabel}</summary>
          <nav aria-label={copy.navLabel}>
            {
              allNavigation.map((item) => (
                <a
                  href={item.href}
                  aria-current={isActive(item.href, item.key) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
        </details>

        <main id="main-content" class="wiki-main">
          <div class="wiki-main-inner">
            <slot />
          </div>
        </main>
      </div>

      <footer class="wiki-footer">
        <span>Alliance Codex · {copy.publicFoundation}</span>
        <span
          >{
            locale === 'es' ? 'Contenido revisado por la comunidad' : 'Community-reviewed content'
          }</span
        >
      </footer>
    </div>
  </body>
</html>
