      "html": "<article class=\"ac-card\"><a class=\"ac-card__title-link\" href=\"#\">Shiny Charizard</a><span class=\"ac-card__meta\">Nº 6</span></article>",
      "css": ".ac-card{display:grid;row-gap:12px;width:260px;padding:16px;border:1px solid #22262f;border-radius:12px;background:#0c0e12;color:#f7f7f7;font:400 14px/22px Verdana,'DejaVu Sans',system-ui,sans-serif}.ac-card__title-link{color:#f7f7f7;font-weight:700;text-decoration:none}.ac-card__title-link:hover{text-decoration:underline}.ac-card__title-link:focus-visible{outline:2px solid #444ce7;outline-offset:1px}.ac-card__meta{color:#94979c;font-size:12px;line-height:16px}"
