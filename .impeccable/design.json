  "narrative": {
    "northStar": "La respuesta primero, el juego en el tooltip",
    "overview": "Alliance Codex es la wiki comunitaria bilingüe (es/en) de PokeAlliance con el lenguaje de interfaz de RubinOT: grises planos, Verdana del sistema, texto denso de 12 a 14 px, bordes de 1 px y un solo color de hover. El color lo ponen el contenido y los sprites reales del juego. Cuando la página nombra algo del juego aparece la segunda capa: el tooltip del juego, con su panel grafito, etiquetas doradas y Poppins. Los nombres y valores vienen de src/design/tokens.json.",
    "keyCharacteristics": [
      "La respuesta primero: título, banner de datos y tabla, sin héroe ni eslogan.",
      "Denso y plano: tres grises y bordes de 1 px, sin sombras de elevación, degradados ni brillos.",
      "Sprites reales del registro a escala entera como iconografía de navegación y entidades.",
      "Tooltip del juego en cada mención de una entidad; Cards, Slots y Lista en cada lista.",
      "Pokédólares con su sprite y forma k/kk antes de cada importe del juego.",
      "Sin relleno, controles falsos, cifras inventadas ni procedencia."
    ],
    "rules": [
      {
        "name": "The One Hover Rule",
        "body": "Todo lo interactivo toma bg-tertiary en hover; los enlaces de texto solo se subrayan.",
        "section": "colors"
      },
      {
        "name": "The Game Layer Rule",
        "body": "El oro (tt-label) y Poppins no salen del tooltip del juego ni de la ficha del Pokémon.",
        "section": "colors"
      },
      {
        "name": "The Amber Selection Rule",
        "body": "selected marca lo elegido, nunca un enlace.",
        "section": "colors"
      },
      {
        "name": "The Meaningful Color Rule",
        "body": "Ningún dato depende solo del color.",
        "section": "colors"
      },
      {
        "name": "The Two Weights Rule",
        "body": "Verdana va en 400 y 700; Poppins en 500 y 600.",
        "section": "typography"
      },
      {
        "name": "The Border Before Shadow Rule",
        "body": "Si un borde o un cambio de gris explica la capa, no hay sombra.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do abrir cada pantalla con el dato: título, banner de datos si aplica y la tabla o la rejilla.",
      "Do tomar todo color, longitud, radio, duración y curva de src/design/tokens.json.",
      "Do mostrar navegación y entidades con sprites reales del registro a escala entera.",
      "Do mostrar «—» para un dato desconocido cuando otras filas lo tienen; nunca 0."
    ],
    "donts": [
      "Don't crear héroes, eslóganes, kickers ni métricas decorativas.",
      "Don't usar degradados, sombras de elevación, brillos, glassmorphism ni tarjetas que suben al pasar el cursor.",
      "Don't usar sets de iconos genéricos para navegación o entidades, ni emoji.",
      "Don't mostrar ni guardar procedencia."
    ]
  }
}
