      "html": "<div class=\"ac-game-tooltip\" role=\"tooltip\"><p class=\"ac-game-tooltip__title\">Shiny Ditto</p><p class=\"ac-game-tooltip__row\"><span class=\"ac-game-tooltip__label\">Memory Slots:</span> 6</p><p class=\"ac-game-tooltip__footer\">Mantén Shift para fijar</p></div>",
